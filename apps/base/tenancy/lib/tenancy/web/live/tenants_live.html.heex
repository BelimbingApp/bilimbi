<Layouts.app flash={@flash} current_scope={@current_scope} active_nav="admin.tenancy.tenant">
  <.page id="tenants-index">
    <.header>
      Tenants
      <:title_actions>
        <button
          type="button"
          id="tenants-pin"
          data-nav-pin="nav-admin-tenancy-tenant"
          title="Pin Tenants to sidebar"
          aria-label="Pin Tenants to sidebar"
          aria-pressed="false"
          class="grid size-6 place-items-center rounded-sm text-ink-faint transition hover:bg-surface-sunken hover:text-ink focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-strong"
        >
          <.icon name="bilimbi-pin" class="size-3.5" />
        </button>
      </:title_actions>
      <:subtitle>Each tenant is an isolated customer of this instance</:subtitle>
      <:actions>
        <.button
          :if={allowed?(@current_scope, "admin.tenancy.tenant.create")}
          id="tenants-add"
          variant="primary"
          phx-click="show_create"
        >
          <.icon name="hero-plus" class="size-4" /> Add Tenant
        </.button>
      </:actions>
    </.header>

    <.card id="tenants-card" inner_class="p-0">
      <.table
        id="tenants"
        rows={@streams.tenants}
        row_id={fn {id, _} -> id end}
        row_item={fn {_, tenant} -> tenant end}
        sort_by={@sort_by}
        sort_dir={@sort_dir}
        framed={false}
      >
        <:col :let={tenant} label="ID" sort="id" sort_id="tenants-sort-id">
          <span class="tabular-nums text-ink-muted">{tenant.id}</span>
        </:col>
        <:col :let={tenant} label="Name" sort="name" sort_id="tenants-sort-name">
          <span class="font-medium text-ink-strong">{tenant.name}</span>
          <.badge :if={tenant.is_platform_operator} class="ml-2">Platform operator</.badge>
        </:col>
        <:col :let={tenant} label="Parent">
          <span class="text-ink-muted">{tenant.parent_name || "—"}</span>
        </:col>
        <:col :let={tenant} label="Sub-tenants">
          <span class="tabular-nums text-ink-muted">{tenant.children_count}</span>
        </:col>
        <:col :let={tenant} label="Status" sort="status" sort_id="tenants-sort-status">
          <.badge kind={status_kind(tenant.status)}>{status_label(tenant.status)}</.badge>
        </:col>
        <:empty :if={@tenants_count == 0}>
          No tenants found.
        </:empty>
      </.table>
    </.card>
  </.page>

  <div
    :if={@show_create}
    id="tenant-create-modal"
    class="fixed inset-0 z-40 flex items-start justify-center bg-ink/40 p-6"
  >
    <div class="mt-16 w-full max-w-lg rounded-xl border border-line bg-surface p-6 shadow-sm">
      <h2 class="text-lg font-medium tracking-tight text-ink-strong">Add Tenant</h2>

      <.form for={@form} id="tenant-create-form" phx-submit="create" class="mt-6 space-y-4">
        <.input
          field={@form[:name]}
          id="tenant-name"
          label="Name"
          placeholder="e.g. Acme Sdn Bhd"
          required
          maxlength="255"
        />
        <.input
          field={@form[:parent_id]}
          id="tenant-parent"
          type="select"
          label="Parent tenant"
          prompt="None (top-level tenant)"
          options={@parent_options}
        />
        <.input
          field={@form[:status]}
          id="tenant-status"
          type="select"
          label="Status"
          required
          options={[{"Active", "active"}, {"Suspended", "suspended"}]}
        />

        <div class="flex items-center gap-4 pt-2">
          <.button variant="primary">Create</.button>
          <.button type="button" phx-click="cancel_create">Cancel</.button>
        </div>
      </.form>
    </div>
  </div>
</Layouts.app>
