<Layouts.app
  flash={@flash}
  current_scope={@current_scope}
  active_nav="admin.system.localization"
>
  <.page variant={:form}>
    <.header>
      Language & Region
      <:subtitle>Set the installation locale and review where it came from.</:subtitle>
    </.header>

    <div class="mt-5 space-y-4">
      <.card id="localization-locale" title="Installation locale">
        <.form for={@form} id="localization-form" phx-submit="save" class="space-y-4 p-4">
          <.input
            field={@form[:locale]}
            id="localization-locale-select"
            type="select"
            label="Locale"
            options={@locale_options}
            hint="Sets regional formatting and the default translation language."
            wrapper_class="mb-0"
          />

          <div class="flex justify-end">
            <.button id="localization-save" type="submit" variant="primary">
              Save locale
            </.button>
          </div>
        </.form>
      </.card>

      <.card id="localization-provenance" title="Current locale" inner_class="px-4">
        <.list id="localization-provenance-facts">
          <:item id="localization-effective-locale" title="Effective locale">
            {@locale_label} ({@resolved.locale})
          </:item>
          <:item id="localization-language" title="Translation language">
            {@resolved.language}
          </:item>
          <:item id="localization-source" title="Source">{@source_label}</:item>
          <:item id="localization-inferred-country" title="Inferred country">
            {@inferred_country}
          </:item>
          <:item id="localization-message-catalogues" title="Shared UI message catalogues">
            {@shared_ui_catalogues}
          </:item>
        </.list>
        <p class="pb-2 pt-2 text-xs text-ink-subtle">
          Regional support does not imply that translated product copy is installed.
        </p>
      </.card>
    </div>
  </.page>
</Layouts.app>
