<Layouts.app
  flash={@flash}
  current_scope={@current_scope}
  active_nav="admin.system.localization"
>
  <.page variant={:form}>
    <.header>
      Language & Region
      <:subtitle>Set the installation locale and review where it came from.</:subtitle>
    </.header>

    <div class="mt-5 space-y-4">
      <.card id="localization-locale" title="Installation locale">
        <.form for={@form} id="localization-form" phx-submit="save" class="space-y-4 p-4">
          <.input
            field={@form[:locale]}
            id="localization-locale-select"
            type="select"
            label="Locale"
            options={@locale_options}
            hint="Sets regional formatting and the default translation language."
            wrapper_class="mb-0"
          />

          <div class="flex justify-end">
            <.button id="localization-save" type="submit" variant="primary">
              Save locale
            </.button>
          </div>
        </.form>
      </.card>

      <.card id="localization-provenance" title="Current locale">
        <dl class="divide-y divide-line-subtle px-4 text-sm">
          <div id="localization-effective-locale" class="flex justify-between gap-4 py-2">
            <dt class="text-ink-muted">Effective locale</dt>
            <dd class="text-right font-medium text-ink">{@locale_label} ({@resolved.locale})</dd>
          </div>
          <div id="localization-language" class="flex justify-between gap-4 py-2">
            <dt class="text-ink-muted">Translation language</dt>
            <dd class="text-right font-medium text-ink">{@resolved.language}</dd>
          </div>
          <div id="localization-source" class="flex justify-between gap-4 py-2">
            <dt class="text-ink-muted">Source</dt>
            <dd class="text-right font-medium text-ink">{@source_label}</dd>
          </div>
          <div id="localization-inferred-country" class="flex justify-between gap-4 py-2">
            <dt class="text-ink-muted">Inferred country</dt>
            <dd class="text-right font-medium text-ink">{@inferred_country}</dd>
          </div>
          <div id="localization-message-catalogues" class="flex justify-between gap-4 py-2">
            <dt class="text-ink-muted">Shared UI message catalogues</dt>
            <dd class="text-right font-medium text-ink">{@shared_ui_catalogues}</dd>
          </div>
        </dl>
        <p class="px-4 pb-4 pt-2 text-xs text-ink-subtle">
          Regional support does not imply that translated product copy is installed.
        </p>
      </.card>
    </div>
  </.page>
</Layouts.app>
