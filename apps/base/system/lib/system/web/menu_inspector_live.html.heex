<Layouts.app
  flash={@flash}
  current_scope={@current_scope}
  active_nav="admin.system.menu-inspector"
>
  <.page id="menu-inspector-index">
    <.header>
      Menu Inspector
      <:title_actions>
        <.icon_button
          icon="bilimbi-pin"
          label="Pin Menu Inspector to sidebar"
          context={:inline}
          id="menu-inspector-pin"
          data-nav-pin="nav-admin-system-menu-inspector"
          aria-pressed="false"
          />
      </:title_actions>
      <:subtitle>
        Every registered menu item with its source, parent, capability, route, and whether this actor may use it
      </:subtitle>
    </.header>

    <.filter_toolbar id="menu-inspector-filters" form={@filters_form} event="filter">
      <:control
        type={:search}
        field={@filters_form[:search]}
        id="menu-inspector-search"
        label="Search menu items"
        placeholder="Search id, label, capability, route, or source"
      />
      <:control
        type={:select}
        field={@filters_form[:source]}
        id="menu-source-filter"
        label="Filter by source"
        options={[{"All sources", ""} | Enum.map(@sources, &{&1, &1})]}
      />
    </.filter_toolbar>

    <.card id="menu-inspector-card" inner_class="p-0">


      <.table
        id="menu-inspector"
        rows={@streams.items}
        row_id={fn {dom_id, _item} -> dom_id end}
        row_item={fn {_dom_id, item} -> item end}
        framed={false}
      >
        <:col :let={item} label="ID">
          <span class="font-mono text-xs text-ink">{item.id}</span>
        </:col>
        <:col :let={item} label="Label">
          <span class="text-sm text-ink">{item.label}</span>
        </:col>
        <:col :let={item} label="Parent">
          <span class="font-mono text-xs text-ink-muted">{item.parent || "—"}</span>
        </:col>
        <:col :let={item} label="Kind">
          <.badge>{item.kind}</.badge>
        </:col>
        <:col :let={item} label="Capability">
          <span class="font-mono text-xs text-ink-muted">{item.capability || "—"}</span>
        </:col>
        <:col :let={item} label="Route">
          <span class="font-mono text-xs text-ink-muted">{item.route || "—"}</span>
        </:col>
        <:col :let={item} label="Served">
          <.badge :if={is_nil(item.route)} kind={:neutral}>—</.badge>
          <.badge :if={not is_nil(item.route) and item.served?} kind={:success}>yes</.badge>
          <.badge :if={not is_nil(item.route) and not item.served?} kind={:danger}>no</.badge>
        </:col>
        <:col :let={item} label="Source">
          <span class="font-mono text-xs text-ink-muted">{item.source || "—"}</span>
        </:col>
        <:col :let={item} label="Allowed">
          <.badge :if={item.allowed?} kind={:success}>yes</.badge>
          <.badge :if={not item.allowed?} kind={:danger}>no</.badge>
        </:col>
        <:empty :if={@total_entries == 0}>
          {if @state.search == "" and (@state.source == "" or @state.source == "all"),
            do: "No menu items are registered.",
            else: "No menu items match the current filters."}
        </:empty>
      </.table>

      <.pagination
        id="menu-inspector-pagination"
        page={@items_page}
        page_sizes={@page_sizes}
        filters_form={@filters_form}
        filters_event="filter"
      />
    </.card>
  </.page>
</Layouts.app>
