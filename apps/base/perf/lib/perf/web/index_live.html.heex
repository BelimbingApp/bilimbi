<Layouts.app flash={@flash} current_scope={@current_scope} active_nav="admin.system.performance">
  <.page id="performance-index">
    <.header>
      Performance
      <:title_actions>
        <.icon_button
          icon="bilimbi-pin"
          label="Pin Performance to sidebar"
          context={:inline}
          id="performance-pin"
          data-nav-pin="nav-admin-system-performance"
          aria-pressed="false"
        />
      </:title_actions>
      <:subtitle>Redacted route and background-job diagnostics</:subtitle>
    </.header>

    <div id="performance-health" class="mb-2 grid gap-2 sm:grid-cols-5">
      <.card id="performance-recorder" inner_class="p-3">
        <p class="text-xs font-semibold text-muted">Recorder</p>
        <p class="mt-1 text-sm text-ink">{human_status(@diagnostics.recorder)}</p>
      </.card>
      <.card id="performance-store" inner_class="p-3">
        <p class="text-xs font-semibold text-muted">History store</p>
        <p class="mt-1 text-sm text-ink">{human_status(@diagnostics.store)}</p>
      </.card>
      <.card id="performance-samples" inner_class="p-3">
        <p class="text-xs font-semibold text-muted">Visible samples</p>
        <p class="mt-1 text-sm tabular-nums text-ink">{@total}</p>
      </.card>
      <.card id="performance-pending" inner_class="p-3">
        <p class="text-xs font-semibold text-muted">Recorder backlog</p>
        <p class="mt-1 text-sm tabular-nums text-ink">{@diagnostics.pending || "Unknown"}</p>
      </.card>
      <.card id="performance-dropped" inner_class="p-3">
        <p class="text-xs font-semibold text-muted">Dropped samples</p>
        <p class="mt-1 text-sm tabular-nums text-ink">{@diagnostics.dropped || "Unknown"}</p>
      </.card>
    </div>

    <.card id="performance-regressions" title="Recent regressions" inner_class="p-0" class="mb-2">
      <.flex_table
        id="performance-regression-table"
        framed={false}
        columns={@regression_columns.column_views}
        rows={@regression_columns.rows}
        mode={@regression_columns.mode}
        zoom={@regression_columns.zoom}
        suggestions={@regression_columns.suggestions}
        add_query={@regression_columns.add_query}
        event="regressions_grid"
        caption="Recent regressions"
      >
        <:col :let={%{record: row}} id="identity">{row.identity}</:col>
        <:col :let={%{record: row}} id="baseline">
          <span class="tabular-nums">{Float.round(row.baseline_average_ms, 1)} ms</span>
        </:col>
        <:col :let={%{record: row}} id="current">
          <span class="tabular-nums">{Float.round(row.current_p95_ms, 1)} ms</span>
        </:col>
        <:col :let={%{record: row}} id="change">
          <span class="tabular-nums">{row.delta_percent}%</span>
        </:col>
        <:empty>No regressions met the current sample and latency thresholds.</:empty>
      </.flex_table>
    </.card>

    <.filter_toolbar id="performance-filters" form={@filters_form} event="filter">
      <:control
        type={:search}
        field={@filters_form[:identity]}
        id="performance-identity"
        label="Route or worker"
        placeholder="Exact identity"
      />
      <:control
        type={:select}
        field={@filters_form[:kind]}
        id="performance-kind"
        label="Kind"
        options={[
          {"All", ""},
          {"Request", "request"},
          {"LiveView", "liveview"},
          {"Job", "job"},
          {"Runtime", "runtime"}
        ]}
      />
      <:control
        type={:select}
        field={@filters_form[:outcome]}
        id="performance-outcome"
        label="Outcome"
        options={[
          {"All", ""},
          {"OK", "ok"},
          {"Error", "error"},
          {"Cancelled", "cancelled"},
          {"Discarded", "discarded"}
        ]}
      />
    </.filter_toolbar>

    <.card id="performance-history" inner_class="p-0">
      <.flex_table
        id="performance-sample-table"
        framed={false}
        columns={@sample_columns.column_views}
        rows={@sample_columns.rows}
        mode={@sample_columns.mode}
        zoom={@sample_columns.zoom}
        suggestions={@sample_columns.suggestions}
        add_query={@sample_columns.add_query}
        event="samples_grid"
        row_id={&"samples-#{&1}"}
        caption="Performance history"
      >
        <:col :let={%{record: sample}} id="observed_at">
          <.datetime id={"performance-observed-#{sample.id}"} value={sample.observed_at} />
        </:col>
        <:col :let={%{record: sample}} id="kind">{sample.kind}</:col>
        <:col :let={%{record: sample}} id="identity">{sample.identity}</:col>
        <:col :let={%{record: sample}} id="outcome">{sample.outcome}</:col>
        <:col :let={%{record: sample}} id="duration">
          <span class="tabular-nums">{sample.duration_ms} ms</span>
        </:col>
        <:col :let={%{record: sample}} id="database">
          <span class="tabular-nums">{sample.db_count} / {sample.db_duration_ms} ms</span>
        </:col>
        <:empty :if={@total == 0}>No matching performance history.</:empty>
      </.flex_table>

      <.pagination
        id="performance-pagination"
        page={@samples_page}
        page_sizes={@page_sizes}
        filters_form={@filters_form}
        filters_event="filter"
      />
    </.card>
  </.page>
</Layouts.app>
