<Layouts.app flash={@flash} current_scope={@current_scope} active_nav="admin.system.performance">
  <.page id="performance-index">
    <.header>
      Performance
      <:title_actions>
        <button
          type="button"
          id="performance-pin"
          data-nav-pin="nav-admin-system-performance"
          title="Pin Performance to sidebar"
          aria-label="Pin Performance to sidebar"
          aria-pressed="false"
          class="grid size-5 place-items-center rounded-md text-ink-faint transition hover:bg-surface-sunken hover:text-ink focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-strong"
        >
          <.icon name="bilimbi-pin" class="size-3.5" />
        </button>
      </:title_actions>
      <:subtitle>Redacted route and background-job diagnostics</:subtitle>
    </.header>

    <div id="performance-health" class="mb-2 grid gap-2 sm:grid-cols-5">
      <.card id="performance-recorder" inner_class="p-3">
        <p class="text-xs font-semibold text-muted">Recorder</p>
        <p class="mt-1 text-sm text-ink">{human_status(@diagnostics.recorder)}</p>
      </.card>
      <.card id="performance-store" inner_class="p-3">
        <p class="text-xs font-semibold text-muted">History store</p>
        <p class="mt-1 text-sm text-ink">{human_status(@diagnostics.store)}</p>
      </.card>
      <.card id="performance-samples" inner_class="p-3">
        <p class="text-xs font-semibold text-muted">Visible samples</p>
        <p class="mt-1 text-sm tabular-nums text-ink">{@total}</p>
      </.card>
      <.card id="performance-pending" inner_class="p-3">
        <p class="text-xs font-semibold text-muted">Recorder backlog</p>
        <p class="mt-1 text-sm tabular-nums text-ink">{@diagnostics.pending || "Unknown"}</p>
      </.card>
      <.card id="performance-dropped" inner_class="p-3">
        <p class="text-xs font-semibold text-muted">Dropped samples</p>
        <p class="mt-1 text-sm tabular-nums text-ink">{@diagnostics.dropped || "Unknown"}</p>
      </.card>
    </div>

    <.card id="performance-regressions" title="Recent regressions" inner_class="p-0" class="mb-2">
      <.table id="performance-regression-table" rows={@regressions} framed={false}>
        <:col :let={row} label="Route / worker">{row.identity}</:col>
        <:col :let={row} label="Baseline avg"><span class="tabular-nums">{Float.round(row.baseline_average_ms, 1)} ms</span></:col>
        <:col :let={row} label="Current p95"><span class="tabular-nums">{Float.round(row.current_p95_ms, 1)} ms</span></:col>
        <:col :let={row} label="Change"><span class="tabular-nums">{row.delta_percent}%</span></:col>
        <:empty>No regressions met the current sample and latency thresholds.</:empty>
      </.table>
    </.card>

    <.card id="performance-history" inner_class="p-0">
      <.form
        for={%{}}
        as={:filters}
        id="performance-filters"
        phx-change="filter"
        phx-submit="filter"
        class="mb-2 grid gap-2 p-2 sm:grid-cols-4"
      >
        <.input type="search" id="performance-identity" name="filters[identity]" value={@filters.identity} label="Route or worker" placeholder="Exact identity" phx-debounce="300" />
        <.input type="select" id="performance-kind" name="filters[kind]" value={@filters.kind} label="Kind" options={[{"All", ""}, {"Request", "request"}, {"LiveView", "liveview"}, {"Job", "job"}, {"Runtime", "runtime"}]} />
        <.input type="select" id="performance-outcome" name="filters[outcome]" value={@filters.outcome} label="Outcome" options={[{"All", ""}, {"OK", "ok"}, {"Error", "error"}, {"Cancelled", "cancelled"}, {"Discarded", "discarded"}]} />
        <.input type="select" id="performance-page-size" name="filters[page_size]" value={@filters.page_size} label="Rows" options={[25, 50, 100, 300]} />
      </.form>

      <.table id="performance-sample-table" rows={@streams.samples} row_id={fn {id, _sample} -> id end} row_item={fn {_id, sample} -> sample end} framed={false}>
        <:col :let={sample} label="Observed"><.datetime id={"performance-observed-#{sample.id}"} value={sample.observed_at} /></:col>
        <:col :let={sample} label="Kind">{sample.kind}</:col>
        <:col :let={sample} label="Route / worker">{sample.identity}</:col>
        <:col :let={sample} label="Outcome">{sample.outcome}</:col>
        <:col :let={sample} label="Duration"><span class="tabular-nums">{sample.duration_ms} ms</span></:col>
        <:col :let={sample} label="DB"><span class="tabular-nums">{sample.db_count} / {sample.db_duration_ms} ms</span></:col>
        <:empty :if={@total == 0}>No matching performance history.</:empty>
      </.table>

      <div id="performance-pagination" class="flex items-center justify-between border-t border-line px-2 py-1.5">
        <span class="text-xs text-muted">Page {@filters.page} of {@page_count}</span>
        <div class="flex gap-1">
          <.button id="performance-previous" phx-click="previous" disabled={@filters.page <= 1} class="rounded-md">Previous</.button>
          <.button id="performance-next" phx-click="next" disabled={@filters.page >= @page_count} class="rounded-md">Next</.button>
        </div>
      </div>
    </.card>
  </.page>
</Layouts.app>
