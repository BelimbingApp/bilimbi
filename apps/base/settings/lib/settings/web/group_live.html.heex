<Layouts.app flash={@flash} current_scope={@current_scope} active_nav={@page.nav}>
  <.page id="settings-group" variant={:form}>
    <.header>
      {@page.title}
      <:title_actions>
        <.icon_button
          icon="bilimbi-pin"
          label={"Pin #{@page.title} to sidebar"}
          context={:inline}
          id="settings-pin"
          data-nav-pin="nav-admin-system-settings"
          aria-pressed="false"
          />
      </:title_actions>
      <:subtitle>{@page.subtitle}</:subtitle>
    </.header>

    <.tabs
      :if={length(@page.groups) > 1}
      id="settings-tabs"
      class="mt-5"
      aria-label="Settings groups"
    >
      <:tab
        :for={group <- @page.groups}
        id={"settings-tab-#{group}"}
        current={group == @active_tab}
        click="switch_tab"
        value={group}
      >
        {group}
      </:tab>
    </.tabs>

    <form id="settings-form" phx-submit="save" class="mt-5 space-y-5">
      <div
        :for={group <- @page.groups}
        :if={group == @active_tab}
        id={"settings-group-#{group}"}
        class="space-y-5"
      >
        <div
          :for={field <- fields_in(@fields, group)}
          id={"setting-#{String.replace(field.key, ".", "-")}"}
          class="rounded-xl border border-line bg-surface p-4"
        >
          <label
            for={"input-#{String.replace(field.key, ".", "-")}"}
            class="block text-sm font-medium text-ink-strong"
          >
            {field.definition.label}
          </label>
          <p class="mt-0.5 text-xs text-ink-subtle">{field.definition.help}</p>

          <.input
            :if={boolean_field?(field)}
            type="checkbox"
            id={"input-#{String.replace(field.key, ".", "-")}"}
            name={"settings[#{field.key}]"}
            checked={boolean_checked?(field)}
            label="Enabled"
            wrapper_class="mb-0 mt-2.5"
          />

          <input
            :if={!boolean_field?(field)}
            type={input_type(field)}
            id={"input-#{String.replace(field.key, ".", "-")}"}
            name={"settings[#{field.key}]"}
            value={input_value(field)}
            autocomplete="off"
            class="mt-2.5 w-full rounded-md border border-line bg-surface px-3 py-1.5 text-sm text-ink shadow-xs transition placeholder:text-ink-faint focus:border-brand-strong focus:outline-none focus:ring-2 focus:ring-brand-strong/30"
          />

          <div class="mt-1.5 flex items-center gap-2 text-xs">
            <.badge :if={field.overridden?}>Set here</.badge>
            <span :if={source_note(field)} class="text-ink-faint">{source_note(field)}</span>
            <span :if={field.encrypted?} class="text-ink-faint">
              Stored encrypted; leave the mask to keep the current value
            </span>
          </div>
        </div>

        <div
          :if={fields_in(@fields, group) == []}
          class="rounded-xl border border-line bg-surface px-4 py-8"
        >
          <.empty_state
            :if={withheld_in(@withheld_capabilities, group) == []}
            id={"settings-group-#{group}-empty"}
            title="No installed module contributes settings to this group."
          />
          <.empty_state
            :if={withheld_in(@withheld_capabilities, group) != []}
            id={"settings-group-#{group}-withheld"}
            forbidden={withheld_wording(withheld_in(@withheld_capabilities, group))}
          />
        </div>
      </div>

      <div class="flex items-center justify-between gap-4">
        <p class="text-xs text-ink-faint">
          Clearing a field removes this override, so the value returns to what it inherits.
        </p>
        <div class="flex gap-2">
          <.button id="settings-restore" type="button" phx-click="request_restore">
            Restore Defaults
          </.button>
          <.button id="settings-save" type="submit" variant="primary">Save</.button>
        </div>
      </div>
    </form>

    <.confirm_dialog
      :if={@pending_restore}
      id="restore-defaults-confirm"
      consequence={"#{count(@pending_restore, "override")} on this page will be removed."}
      detail="Each of those settings returns to the value it inherits. This cannot be undone."
      confirm="Restore"
      working="Restoring…"
      on_confirm={JS.push("restore_defaults")}
      on_cancel={JS.push("cancel_restore")}
    />
  </.page>
</Layouts.app>
