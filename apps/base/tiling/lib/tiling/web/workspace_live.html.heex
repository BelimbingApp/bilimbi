<Layouts.app flash={@flash} current_scope={@current_scope} active_nav={@active_nav}>
  <:topbar_actions>
    <div :if={not @framed?} id="workspace-actions" class="flex items-center gap-1">
      <.icon_button
        id="workspace-add-page"
        icon="create"
        label={gettext("Add a page")}
        context={:inline}
        phx-click="open-picker"
      />
      <.icon_button
        id="workspace-open-layouts"
        icon="hero-bookmark"
        label={gettext("Saved layouts")}
        context={:inline}
        phx-click="open-layouts"
      />
    </div>
  </:topbar_actions>

  <%= if @framed? do %>
    <div id="workspace-framed" class="flex h-full items-center justify-center p-6">
      <.empty_state
        id="workspace-framed-state"
        title={gettext("The workspace cannot open inside a tile")}
        reason={gettext("A tile shows one page. Open the workspace on its own to tile pages.")}
      >
        <:action>
          <%!-- A frame link that must leave the frame: `target="_top"` is the
          one attribute the shared button does not carry. --%>
          <.link
            id="workspace-framed-open"
            href={~p"/workspace"}
            target="_top"
            class="text-sm font-medium text-link underline hover:text-ink"
          >
            {gettext("Open the workspace")}
          </.link>
        </:action>
      </.empty_state>
    </div>
  <% else %>
    <%!-- The hook owns the keyboard mode, the drag on each handle, the drag
    of a tile onto another, and the bridge into every frame. The server owns
    the tree: `data-focused` is the focused tile after every patch, and the
    hook reads it rather than tracking its own. Each tile is one element per
    tile id, positioned by style alone, so a split, close or resize never
    re-creates a frame. --%>
    <div
      id="workspace"
      phx-hook="Tiling"
      data-focused={@focused}
      data-monocle={to_string(@monocle)}
      data-layout={@layout_mode}
      data-tile-count={length(@tiles)}
      class="flex h-full min-h-0 flex-col"
    >
      <.tabs
        :if={@tiles != []}
        id="workspace-tabs"
        aria-label={gettext("Tiles")}
        class="shrink-0 lg:hidden"
      >
        <:tab
          :for={tile <- @tiles}
          id={"workspace-tab-#{tile.id}"}
          click="focus-tile"
          value={tile.id}
          current={tile.focused?}
        >
          {tile.title}
        </:tab>
      </.tabs>

      <p
        id="workspace-announcement"
        phx-update="ignore"
        class="sr-only"
        role="status"
        aria-live="polite"
      >
      </p>

      <div id="workspace-tiles" class="relative min-h-0 flex-1">
        <div
          :if={@tiles == []}
          id="workspace-empty"
          class="flex h-full items-center justify-center p-6"
        >
          <.empty_state
            id="workspace-empty-state"
            title={gettext("No pages open")}
            reason={
              gettext(
                "Add a page to start tiling. Each new page takes half of the focused tile, and every tile stays a page with its own address."
              )
            }
          >
            <:action>
              <.button id="workspace-empty-add" variant="primary" phx-click="open-picker">
                {gettext("Add a page")}
              </.button>
            </:action>
          </.empty_state>
        </div>

        <%!-- Geometry travels in `data-place`, never a `style` attribute:
        the host's Content-Security-Policy allows no inline style, so the
        hook writes the position through the CSSOM after every patch. A tile
        being dragged onto this one sets `data-drop-target`. A tile has no
        bar: `data-title` is the name the hook announces and gives the
        frame, and `data-follow` tells the mode's `w` whether to stop. --%>
        <div
          :for={tile <- @tiles}
          id={"tile-#{tile.id}"}
          class="workspace-tile group absolute p-0.5"
          data-place={tile.place}
          data-tile={tile.id}
          data-title={tile.title}
          data-follow={tile.follow}
          data-focused={to_string(tile.focused?)}
          hidden={@monocle and not tile.focused?}
        >
          <div class={[
            "relative flex h-full min-h-0 flex-col overflow-hidden rounded-md border bg-surface",
            "group-data-[drop-target=true]:ring-2 group-data-[drop-target=true]:ring-brand-strong",
            "group-data-[dragging=true]:opacity-60",
            tile.focused? && "border-brand-strong ring-1 ring-brand-strong",
            !tile.focused? && "border-line"
          ]}>
            <.tile_controls
              id={"tile-#{tile.id}-controls"}
              title={tile.title}
              focused={tile.focused?}
              master_layout={@layout_mode == "master"}
              master_tile={tile.master?}
              following={tile.follow == "on"}
              on_split={JS.push("toggle-split", value: %{id: tile.id})}
              on_close={JS.push("close-tile", value: %{id: tile.id})}
            />
            <%= case tile.access do %>
              <% :ok -> %>
                <%!-- `phx-update="ignore"`: the frame's `src` is written once.
                A frame navigates itself afterwards and reports where it
                went; rewriting `src` from the server would reload it. The
                only later move is the hook's, on a `tile-navigate` event
                when a followed record is selected. The `ws` token joins
                the page to this workspace's follow channel. --%>
                <div
                  id={"tile-#{tile.id}-frame"}
                  phx-update="ignore"
                  class="min-h-0 flex-1"
                >
                  <iframe
                    id={"tile-#{tile.id}-page"}
                    src={Workspace.frame_url(tile.path, @token)}
                    title={tile.title}
                    data-tile-frame={tile.id}
                    class="size-full border-0 bg-canvas"
                  ></iframe>
                </div>
              <% :forbidden -> %>
                <div
                  id={"tile-#{tile.id}-forbidden"}
                  class="flex flex-1 items-center justify-center p-4"
                >
                  <.empty_state forbidden={gettext("open %{path}", path: tile.path)} />
                </div>
              <% :unserved -> %>
                <div
                  id={"tile-#{tile.id}-unserved"}
                  class="flex flex-1 items-center justify-center p-4"
                >
                  <.empty_state
                    title={gettext("This page is not available")}
                    reason={
                      gettext(
                        "Nothing in this deployment serves %{path}. Close the tile or add another page.",
                        path: tile.path
                      )
                    }
                  />
                </div>
            <% end %>
          </div>
        </div>

        <.split_handle
          :for={handle <- @handles}
          :if={not @monocle}
          id={"split-#{handle.id}"}
          direction={handle.direction}
          label={handle.label}
          data-place={handle.place}
          data-split={handle.id}
          data-rect={handle.rect}
        />
      </div>
    </div>

    <.modal
      :if={@picker_open?}
      id="workspace-picker"
      title={gettext("Add a page")}
      on_cancel={JS.push("close-picker")}
      flash={@flash}
    >
      <:description>
        {if @layout_mode == "master",
          do:
            gettext(
              "The page joins the master layout's stack. Every tile is a live page, so many tiles cost as much as many tabs."
            ),
          else:
            gettext(
              "The page opens in a new tile beside the focused one. Every tile is a live page, so many tiles cost as much as many tabs."
            )}
      </:description>
      <div id="workspace-picker-pages" class="-mx-1 max-h-96 space-y-0.5 overflow-y-auto">
        <button
          :for={page <- @pages}
          type="button"
          id={"workspace-pick-" <> String.replace(page.id, ".", "-")}
          phx-click="add-tile"
          phx-value-path={page.route}
          class="block w-full rounded-md px-2 py-1.5 text-left transition hover:bg-surface-muted focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-brand-strong/40"
        >
          <span class="block text-sm text-ink">{page.label}</span>
          <span :if={page.trail != ""} class="block text-xs text-ink-muted">{page.trail}</span>
        </button>
        <.empty_state
          :if={@pages == []}
          id="workspace-picker-empty"
          title={gettext("No pages to add")}
          reason={
            gettext(
              "No destinations are available for this account. Ask an operator to assign a role."
            )
          }
        />
      </div>
    </.modal>

    <.modal
      :if={@layouts_open?}
      id="workspace-layouts"
      title={gettext("Saved layouts")}
      on_cancel={JS.push("close-layouts")}
      flash={@flash}
      width={:wide}
    >
      <:description>
        {gettext(
          "Layouts are saved for your account. In tiling mode, the keys 1 to 9 open the first nine."
        )}
      </:description>

      <.form
        for={@save_form}
        id="workspace-save-form"
        phx-change="validate-layout"
        phx-submit="save-layout"
        class="flex items-end gap-2"
      >
        <.input
          field={@save_form[:label]}
          label={gettext("Save the current layout as")}
          placeholder={gettext("Orders desk")}
          wrapper_class="mb-0 flex-1"
        />
        <.button type="submit" id="workspace-save-layout" variant="primary">
          {gettext("Save")}
        </.button>
      </.form>

      <p :if={@slug && !@shared?} class="mt-2 text-xs text-ink-muted">
        <.button id="workspace-update-layout" phx-click="update-layout">
          {gettext("Update “%{label}” with the current tiles",
            label: current_label(@saved, @slug)
          )}
        </.button>
      </p>

      <div class="mt-4">
        <.flex_table
          id="workspace-saved-layouts"
          columns={@saved_columns.column_views}
          rows={@saved_columns.rows}
          mode={@saved_columns.mode}
          zoom={@saved_columns.zoom}
          suggestions={@saved_columns.suggestions}
          add_query={@saved_columns.add_query}
          row_id={&"workspace-layout-#{&1}"}
          event="saved_grid"
        >
          <:col :let={%{record: entry}} id="label">
            <.inline_edit
              id={"workspace-layout-name-" <> entry["slug"]}
              id_value={entry["slug"]}
              value={entry["label"]}
              name="label"
              save_event="rename-layout"
              label={gettext("Rename layout")}
            />
          </:col>
          <:col :let={%{record: entry}} id="default">
            <span
              :if={entry["slug"] == @default_slug}
              id={"workspace-layout-default-" <> entry["slug"]}
            >
              {gettext("Default")}
            </span>
          </:col>
          <:col :let={%{record: entry}} id="layout_mode">
            <button
              type="button"
              id={"workspace-layout-mode-" <> entry["slug"]}
              phx-click="set-layout-mode"
              phx-value-id={entry["slug"]}
              phx-value-mode={if entry["layout"] == "master", do: "dwindle", else: "master"}
              class="rounded-md px-2 py-1 text-xs text-link hover:bg-surface-muted focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-brand-strong/40"
              aria-label={
                if entry["layout"] == "master",
                  do: gettext("Use dwindle layout for %{label}", label: entry["label"]),
                  else: gettext("Use master layout for %{label}", label: entry["label"])
              }
            >
              {if entry["layout"] == "master", do: gettext("Master"), else: gettext("Dwindle")}
            </button>
          </:col>
          <:action :let={%{record: entry}}>
            <div class="flex items-center justify-end gap-1">
              <.icon_button
                id={"workspace-layout-open-" <> entry["slug"]}
                icon="view"
                label={gettext("Open %{label}", label: entry["label"])}
                navigate={~p"/workspace/#{entry["slug"]}"}
              />
              <.icon_button
                :if={entry["slug"] != @default_slug}
                id={"workspace-layout-set-default-" <> entry["slug"]}
                icon="retain"
                label={gettext("Open the workspace with %{label}", label: entry["label"])}
                phx-click="set-default-layout"
                phx-value-id={entry["slug"]}
              />
              <.icon_button
                :if={entry["slug"] == @default_slug}
                id={"workspace-layout-clear-default-" <> entry["slug"]}
                icon="retained"
                label={gettext("Stop opening the workspace with %{label}", label: entry["label"])}
                phx-click="clear-default-layout"
              />
              <.icon_button
                id={"workspace-layout-delete-" <> entry["slug"]}
                icon="delete"
                kind={:danger}
                label={gettext("Delete %{label}", label: entry["label"])}
                phx-click="delete-layout"
                phx-value-id={entry["slug"]}
              />
            </div>
          </:action>
          <:empty
            :if={@saved == []}
            title={gettext("No saved layouts")}
            reason={
              gettext(
                "Save the current tiles under a name to open them again from the sidebar or by address."
              )
            }
          />
        </.flex_table>
      </div>

      <div id="workspace-shared-layouts" class="mt-4">
        <.section_heading title={gettext("Shared with you")} />
        <.flex_table
          id="workspace-shared-table"
          columns={@shared_columns.column_views}
          rows={@shared_columns.rows}
          mode={@shared_columns.mode}
          zoom={@shared_columns.zoom}
          suggestions={@shared_columns.suggestions}
          add_query={@shared_columns.add_query}
          row_id={&"workspace-shared-#{&1}"}
          event="shared_grid"
        >
          <:col :let={%{record: entry}} id="label">{entry["label"]}</:col>
          <:col :let={%{record: entry}} id="audience">
            {if entry["roles"] == [],
              do: gettext("Company"),
              else: Enum.join(entry["roles"], ", ")}
          </:col>
          <:action :let={%{record: entry}}>
            <.link
              id={"workspace-shared-open-" <> entry["slug"]}
              navigate={~p"/workspace/shared/#{entry["slug"]}"}
              class="text-sm text-link underline"
            >{gettext("Open")}</.link>
            <.button
              id={"workspace-shared-copy-" <> entry["slug"]}
              phx-click="copy-layout"
              phx-value-id={entry["slug"]}
            >{gettext("Copy")}</.button>
          </:action>
          <:empty
            :if={@shared == []}
            title={gettext("No shared workspaces")}
            reason={gettext("Workspaces shared with your company or roles appear here.")}
          />
        </.flex_table>
        <.link
          :if={@company_scope && allowed?(@current_scope, "ui.workspace.publish")}
          id="workspace-manage-shared"
          navigate={~p"/workspace/shared-layouts"}
          class="text-sm text-link underline"
        >{gettext("Manage shared workspaces")}</.link>
        <.link
          :if={@company_scope && allowed?(@current_scope, "ui.workspace.publish") && @tiles != []}
          id="workspace-publish-current"
          navigate={~p"/workspace/shared-layouts?t=#{Layout.encode(@tree)}"}
          class="ml-3 text-sm text-link underline"
        >{gettext("Share current tiles")}</.link>
      </div>
    </.modal>

    <.confirm_dialog
      :if={@pending_delete}
      id="workspace-delete-layout"
      consequence={
        gettext("The layout “%{label}” will be deleted.",
          label: current_label(@saved, @pending_delete)
        )
      }
      detail={
        gettext(
          "Its address stops working. The pages it showed are unaffected. This cannot be undone."
        )
      }
      confirm={gettext("Delete")}
      working={gettext("Deleting…")}
      on_confirm={JS.push("confirm-delete-layout")}
      on_cancel={JS.push("cancel-delete-layout")}
    />
  <% end %>
</Layouts.app>
