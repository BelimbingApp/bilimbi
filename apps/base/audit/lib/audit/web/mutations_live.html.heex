<Layouts.app flash={@flash} current_scope={@current_scope} active_nav="admin.audit.mutation">
  <.page>
    <.header>
      Data Mutations
      <:subtitle>Audit trail for all data changes, newest first</:subtitle>
    </.header>

    <form id="mutations-filters" phx-change="filter" phx-submit="filter" class="mt-5 flex flex-wrap gap-3">
      <div class="flex-1 min-w-[240px]">
        <label for="mutations-search" class="sr-only">Search mutations</label>
        <input
          type="search"
          id="mutations-search"
          name="search"
          value={@state.search}
          placeholder="Search actor, model, subject, event, or trace..."
          phx-debounce="300"
          autocomplete="off"
          class="w-full rounded-md border border-line bg-surface px-3 py-1.5 text-sm text-ink focus:border-brand-strong focus:outline-none"
        />
      </div>

      <div>
        <label for="mutations-event" class="sr-only">Filter by event</label>
        <select
          id="mutations-event"
          name="event"
          class="rounded-md border border-line bg-surface px-3 py-1.5 text-sm text-ink focus:border-brand-strong focus:outline-none"
        >
          <option value="" selected={@state.event == ""}>All Events</option>
          <option value="created" selected={@state.event == "created"}>Created</option>
          <option value="updated" selected={@state.event == "updated"}>Updated</option>
          <option value="deleted" selected={@state.event == "deleted"}>Deleted</option>
        </select>
      </div>

      <div>
        <label for="mutations-page-size" class="sr-only">Per page</label>
        <select
          id="mutations-page-size"
          name="page_size"
          class="rounded-md border border-line bg-surface px-3 py-1.5 text-sm text-ink focus:border-brand-strong focus:outline-none"
        >
          <option value="25" selected={@state.page_size == 25}>25 / page</option>
          <option value="50" selected={@state.page_size == 50}>50 / page</option>
          <option value="100" selected={@state.page_size == 100}>100 / page</option>
          <option value="300" selected={@state.page_size == 300}>300 / page</option>
        </select>
      </div>
    </form>

    <div class="mt-4">
      <.table
        id="mutations-table"
        rows={@streams.mutations}
        row_id={fn {dom_id, _m} -> dom_id end}
        row_item={fn {_dom_id, m} -> m end}
        sort_by={@state.sort_by}
        sort_dir={@state.sort_dir}
      >
        <:col :let={mutation} label="Occurred" sort="occurred_at" sort_id="mutations-sort-occurred_at">
          <span class="whitespace-nowrap tabular-nums text-xs text-ink-muted">
            <.datetime id={"mutation-occurred-#{mutation.id}"} value={mutation.occurred_at} />
          </span>
        </:col>

        <:col :let={mutation} label="Actor" sort="actor_type" sort_id="mutations-sort-actor_type">
          <div class="whitespace-nowrap text-sm font-medium text-ink">
            {actor_label(mutation)}
          </div>
          <div class="font-mono text-xs text-ink-muted">
            {actor_subtext(mutation)}
          </div>
        </:col>

        <:col :let={mutation} label="Event" sort="event" sort_id="mutations-sort-event">
          <% {badge_kind, badge_label} = event_badge(mutation.event) %>
          <.badge kind={badge_kind}>
            {badge_label}
          </.badge>
        </:col>

        <:col :let={mutation} label="Subject" sort="auditable_type" sort_id="mutations-sort-auditable_type">
          <div class="font-mono text-xs font-semibold text-ink">
            {subject_label(mutation)}
          </div>
          <div class="font-mono text-xs text-ink-muted">
            {subject_subtext(mutation)}
          </div>
        </:col>

        <:col :let={mutation} label="Details">
          <% field_diffs = diffs(mutation) %>
          <div :if={field_diffs != []} class="space-y-1">
            <div :for={diff <- field_diffs} class="flex items-baseline gap-2 font-mono text-xs">
              <span class="min-w-[100px] font-semibold text-ink-muted">{diff.field}:</span>
              <code :if={diff.sensitive} class="text-ink-muted italic">
                {diff.old} → {diff.new}
              </code>
              <div :if={!diff.sensitive} class="flex items-baseline gap-1.5 flex-wrap">
                <code class="text-status-danger">{diff.old}</code>
                <span class="text-ink-muted">→</span>
                <code class="text-status-success">{diff.new}</code>
              </div>
            </div>
          </div>
          <span :if={field_diffs == []} class="text-xs italic text-ink-muted">
            No field changes recorded.
          </span>
        </:col>

        <:col :let={mutation} label="Trace" sort="trace_id" sort_id="mutations-sort-trace_id">
          <span :if={mutation.trace_id} class="font-mono text-xs text-ink-muted">
            {mutation.trace_id}
          </span>
          <span :if={!mutation.trace_id} class="text-ink-muted">—</span>
        </:col>

        <:empty :if={@page.total_entries == 0}>
          {if @state.search == "" and @state.event == "",
            do: "No mutation logs found.",
            else: "No mutation logs match the current filters."}
        </:empty>
      </.table>
    </div>

    <div
      :if={@page.total_pages > 1}
      id="mutations-pagination"
      class="mt-3 flex items-center justify-between text-sm"
    >
      <p class="text-ink-subtle">
        Page {@page.page} of {@page.total_pages} · {@page.total_entries} mutations
      </p>
      <div class="flex gap-2">
        <.button :if={@page.page > 1} id="mutations-prev" phx-click="page" phx-value-page={@page.page - 1}>
          Previous
        </.button>
        <.button
          :if={@page.page < @page.total_pages}
          id="mutations-next"
          phx-click="page"
          phx-value-page={@page.page + 1}
        >
          Next
        </.button>
      </div>
    </div>
  </.page>
</Layouts.app>
