<Layouts.app flash={@flash} current_scope={@current_scope} active_nav="admin.audit.mutation">
  <.page>
    <.header>
      Data Mutations
      <:subtitle>Audit trail for all data changes, newest first</:subtitle>
    </.header>

    <.filter_toolbar id="mutations-filters" form={@filters_form} event="filter">
      <:control
        type={:search}
        field={@filters_form[:search]}
        id="mutations-search"
        label="Search mutations"
        placeholder="Search actor, model, subject, event, or trace..."
      />
      <:control
        type={:select}
        field={@filters_form[:event]}
        id="mutations-event"
        label="Filter by event"
        options={[
          {"All Events", ""},
          {"Created", "created"},
          {"Updated", "updated"},
          {"Deleted", "deleted"}
        ]}
      />
    </.filter_toolbar>

    <div class="mt-4">
      <.flex_table
        id="mutations-table"
        framed={false}
        columns={@columns.column_views}
        rows={@columns.rows}
        mode={@columns.mode}
        zoom={@columns.zoom}
        suggestions={@columns.suggestions}
        add_query={@columns.add_query}
        row_id={&"mutations-#{&1}"}
        caption="Data mutations"
        sort_by={@state.sort_by}
        sort_dir={@state.sort_dir}
      >
        <:col :let={%{record: mutation}} id="occurred_at">
          <span class="whitespace-nowrap tabular-nums text-xs text-ink-muted">
            <.datetime id={"mutation-occurred-#{mutation.id}"} value={mutation.occurred_at} />
          </span>
        </:col>

        <:col :let={%{record: mutation}} id="actor_type">
          <div class="whitespace-nowrap text-sm font-medium text-ink">
            {actor_label(mutation)}
          </div>
          <div class="font-mono text-xs text-ink-muted">
            {actor_subtext(mutation)}
          </div>
        </:col>

        <:col :let={%{record: mutation}} id="event">
          <% {badge_kind, badge_label} = event_badge(mutation.event) %>
          <.badge kind={badge_kind}>
            {badge_label}
          </.badge>
        </:col>

        <:col :let={%{record: mutation}} id="auditable_type">
          <div class="font-mono text-xs font-semibold text-ink">
            {subject_label(mutation)}
          </div>
          <div class="font-mono text-xs text-ink-muted">
            {subject_subtext(mutation)}
          </div>
        </:col>

        <:col :let={%{record: mutation}} id="details">
          <.live_component
            module={Bilimbi.Base.Audit.Web.MutationDetails}
            id={"mutation-#{mutation.id}-details"}
            mutation={mutation}
          />
        </:col>

        <:col :let={%{record: mutation}} id="trace_id">
          <span :if={mutation.trace_id} class="font-mono text-xs text-ink-muted">
            {mutation.trace_id}
          </span>
          <span :if={!mutation.trace_id} class="text-ink-muted">—</span>
        </:col>

        <:empty :if={@page.total_entries == 0}>
          {if @state.search == "" and @state.filters.event == "",
            do: "No mutation logs found.",
            else: "No mutation logs match the current filters."}
        </:empty>
      </.flex_table>

      <.pagination
        id="mutations-pagination"
        page={@page}
        filters_form={@filters_form}
        filters_event="filter"
      />
    </div>
  </.page>
</Layouts.app>
