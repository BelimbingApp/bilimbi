<Layouts.app flash={@flash} current_scope={@current_scope} active_nav="admin.authz.field-access">
  <.page id="field-access-index">
    <.header>
      Field Access
      <:title_actions>
        <.icon_button
          icon="bilimbi-pin"
          label="Pin Field Access to sidebar"
          context={:inline}
          id="field-access-pin"
          data-nav-pin="nav-admin-authz-field-access"
          aria-pressed="false"
        />
      </:title_actions>
      <:subtitle>
        Which fields the roles of this tenant may see. A restricted field reads as Restricted
        for every other role, on the record, in list columns and in the audit log, and cannot be
        changed by them.
      </:subtitle>
      <:actions>
        <.button id="field-access-new" variant="primary" phx-click="new">
          Restrict fields
        </.button>
      </:actions>
    </.header>

    <.card id="field-access-card" inner_class="p-0">
      <.table id="field-restrictions" rows={@restrictions} framed={false}>
        <:col :let={restriction} label="Table">
          <span class="whitespace-nowrap text-ink">{restriction.table_label}</span>
        </:col>
        <:col :let={restriction} label="Field">
          <span class="whitespace-nowrap text-ink">{restriction.field_label}</span>
        </:col>
        <:col :let={restriction} label="Still visible to">
          <span :if={restriction.role_names == []} class="text-ink-muted">No role</span>
          <span :for={name <- restriction.role_names} class="mr-1 inline-flex">
            <.badge>{name}</.badge>
          </span>
        </:col>
        <:col :let={restriction} label="Since">
          <span class="whitespace-nowrap tabular-nums text-ink-muted">
            <.datetime
              id={"field-restriction-#{restriction.id}-since"}
              value={restriction.updated_at}
            />
          </span>
        </:col>
        <:action :let={restriction}>
          <.icon_button
            id={"field-restriction-#{restriction.id}-edit"}
            icon="edit"
            label={"Change who sees #{restriction.table_label} › #{restriction.field_label}"}
            context={:inline}
            phx-click="edit"
            phx-value-id={restriction.id}
          />
          <.icon_button
            id={"field-restriction-#{restriction.id}-remove"}
            icon="delete"
            label={"Remove the restriction on #{restriction.table_label} › #{restriction.field_label}"}
            context={:inline}
            kind={:danger}
            phx-click="request_remove"
            phx-value-id={restriction.id}
          />
        </:action>
        <:empty
          :if={@restrictions == []}
          title="No field is restricted in this tenant"
          reason="Every role sees every field. Use Restrict fields to hide some from the roles that do not need them."
        />
      </.table>
    </.card>

    <%!-- Roles first, then tables, then fields: the operator states who keeps
         access before naming what. The sentence under the pickers reads the
         three choices back before anything is saved. --%>
    <.modal
      :if={@dialog == :add}
      id="field-access-dialog"
      title="Restrict fields"
      flash={@flash}
      on_cancel={JS.push("close_dialog")}
    >
      <:description>
        Choose the roles that keep seeing the fields, then the fields. Fields every reader
        needs, such as a record's name or code, are not offered.
      </:description>
      <.form
        for={@form}
        id="field-access-form"
        phx-change="validate"
        phx-submit="save"
        class="mt-4 space-y-4"
      >
        <.input
          field={@form[:role_ids]}
          id="field-access-roles"
          type="multi_select"
          label="Roles that may still see the fields"
          placeholder="No role: hidden from everyone"
          selection_label=":count role selected|:count roles selected"
          options={role_options(@roles)}
          hint="Every other role reads Restricted."
        />
        <.input
          field={@form[:table_ids]}
          id="field-access-tables"
          type="multi_select"
          label="Tables"
          placeholder="Choose tables"
          selection_label=":count table selected|:count tables selected"
          options={table_options(@catalog)}
        />
        <.input
          field={@form[:field_keys]}
          id="field-access-fields"
          type="multi_select"
          label="Fields"
          placeholder={if @field_options == [], do: "Choose a table first", else: "Choose fields"}
          selection_label=":count field selected|:count fields selected"
          options={@field_options}
          disabled={@field_options == []}
        />

        <p
          id="field-access-outcome"
          class="rounded-md bg-surface-sunken px-3 py-2 text-sm text-ink"
        >
          {outcome_sentence(@chosen_fields, @chosen_roles)}
        </p>

        <div class="flex justify-end gap-2">
          <.button id="field-access-cancel" type="button" phx-click="close_dialog">
            Cancel
          </.button>
          <.button
            id="field-access-save"
            type="submit"
            variant="primary"
            disabled={@chosen_fields == []}
            phx-disable-with="Restricting…"
          >
            {submit_label(@chosen_fields)}
          </.button>
        </div>
      </.form>
    </.modal>

    <%= case @dialog do %>
      <% {:edit, restriction} -> %>
        <.modal
          id="field-access-dialog"
          title={"Who may see #{subject(restriction)}"}
          flash={@flash}
          on_cancel={JS.push("close_dialog")}
        >
          <:description>
            The field stays restricted; only the roles that see it change.
          </:description>
          <.form
            for={@form}
            id="field-access-form"
            phx-change="validate"
            phx-submit="save"
            class="mt-4 space-y-4"
          >
            <.input
              field={@form[:role_ids]}
              id="field-access-roles"
              type="multi_select"
              label="Roles that may still see the field"
              placeholder="No role: hidden from everyone"
              selection_label=":count role selected|:count roles selected"
              options={role_options(@roles)}
              hint="Every other role reads Restricted."
            />

            <p
              id="field-access-outcome"
              class="rounded-md bg-surface-sunken px-3 py-2 text-sm text-ink"
            >
              {outcome_sentence([subject(restriction)], @chosen_roles)}
            </p>

            <div class="flex justify-end gap-2">
              <.button id="field-access-cancel" type="button" phx-click="close_dialog">
                Cancel
              </.button>
              <.button
                id="field-access-save"
                type="submit"
                variant="primary"
                phx-disable-with="Saving…"
              >
                Save roles
              </.button>
            </div>
          </.form>
        </.modal>
      <% _none -> %>
    <% end %>

    <.confirm_dialog
      :if={@pending_removal}
      id="field-access-remove-confirm"
      consequence={"#{subject(@pending_removal)} will be visible to every role again."}
      detail="Anyone who may open the record, its list or its audit log will see the value at once."
      confirm="Remove restriction"
      working="Removing…"
      on_confirm={JS.push("remove")}
      on_cancel={JS.push("cancel_remove")}
    />
  </.page>
</Layouts.app>
