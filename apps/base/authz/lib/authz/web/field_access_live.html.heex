<Layouts.app flash={@flash} current_scope={@current_scope} active_nav="admin.authz.field-access">
  <.page id="field-access-index">
    <.header>
      Field Access
      <:title_actions>
        <.icon_button
          icon="bilimbi-pin"
          label="Pin Field Access to sidebar"
          context={:inline}
          id="field-access-pin"
          data-nav-pin="nav-admin-authz-field-access"
          aria-pressed="false"
        />
      </:title_actions>
      <:subtitle>
        Which fields the roles of this tenant may see. A restricted field reads as Restricted
        for everyone else, on the record, in list columns and in the audit log, and cannot be
        changed by them.
      </:subtitle>
    </.header>

    <.card id="field-access-card" inner_class="p-0">
      <.flex_table
        id="field-restrictions"
        columns={@columns.column_views}
        rows={@columns.rows}
        mode={@columns.mode}
        zoom={@columns.zoom}
        suggestions={@columns.suggestions}
        add_query={@columns.add_query}
        row_id={&"field-restriction-#{&1}"}
        event="grid"
        framed={false}
      >
        <:col :let={%{record: restriction}} id="table">
          <span class="whitespace-nowrap text-ink">{restriction.table_label}</span>
        </:col>
        <:col :let={%{record: restriction}} id="field">
          <span class="whitespace-nowrap text-ink">{restriction.field_label}</span>
        </:col>
        <:col :let={%{record: restriction}} id="visible_to">
          <span :if={restriction.role_names == []} class="text-ink-muted">No role</span>
          <span :for={name <- restriction.role_names} class="mr-1 inline-flex">
            <.badge>{name}</.badge>
          </span>
        </:col>
        <:col :let={%{record: restriction}} id="since">
          <span class="whitespace-nowrap tabular-nums text-ink-muted">
            <.datetime
              id={"field-restriction-#{restriction.id}-since"}
              value={restriction.updated_at}
            />
          </span>
        </:col>
        <:action :let={%{record: restriction}}>
          <.icon_button
            id={"field-restriction-#{restriction.id}-edit"}
            icon="edit"
            label={"Edit who sees #{restriction.table_label} › #{restriction.field_label}"}
            context={:inline}
            phx-click="edit"
            phx-value-id={restriction.id}
          />
          <.icon_button
            id={"field-restriction-#{restriction.id}-remove"}
            icon="delete"
            label={"Remove the restriction on #{restriction.table_label} › #{restriction.field_label}"}
            context={:inline}
            kind={:danger}
            phx-click="request_remove"
            phx-value-id={restriction.id}
          />
        </:action>
        <:empty
          :if={@restrictions == []}
          title="No field is restricted in this tenant"
          reason="Every role sees every field. Restrict one below."
        />
      </.flex_table>
    </.card>

    <.card id="field-access-form-card" class="mt-6">
      <.section_heading
        id="field-access-form-heading"
        title={if @editing, do: "Change who sees this field", else: "Restrict a field"}
      />
      <p class="mb-4 text-sm text-ink-muted">
        Pick a table and a field, then the roles that may still see it. Fields a module needs
        every reader to see, such as a record's name or code, are not offered.
      </p>
      <.form for={@form} id="field-access-form" phx-change="validate" phx-submit="save">
        <div class="grid gap-x-4 sm:grid-cols-3">
          <.input
            field={@form[:table_id]}
            id="field-access-table"
            type="select"
            label="Table"
            prompt="Choose a table"
            options={table_options(@catalog)}
            disabled={@editing != nil}
          />
          <.input
            field={@form[:field_id]}
            id="field-access-field"
            type="select"
            label="Field"
            prompt={if @field_options == [], do: "Choose a table first", else: "Choose a field"}
            options={@field_options}
            disabled={@editing != nil}
          />
          <.input
            field={@form[:role_ids]}
            id="field-access-roles"
            type="multi_select"
            label="Visible to roles"
            placeholder="No role: hidden from everyone"
            selection_label=":count role selected|:count roles selected"
            options={role_options(@roles)}
          />
        </div>
        <div class="flex items-center gap-3">
          <.button id="field-access-save" type="submit" variant="primary">
            {if @editing, do: "Save roles", else: "Restrict field"}
          </.button>
          <.button :if={@editing} id="field-access-cancel" type="button" phx-click="cancel_edit">
            Cancel
          </.button>
        </div>
      </.form>
    </.card>

    <.confirm_dialog
      :if={@pending_removal}
      id="field-access-remove-confirm"
      consequence={"#{@pending_removal.table_label} › #{@pending_removal.field_label} will be visible to every role again."}
      detail="Anyone who may open the record, its list or its audit log will see the value at once."
      confirm="Remove restriction"
      working="Removing…"
      on_confirm={JS.push("remove")}
      on_cancel={JS.push("cancel_remove")}
    />
  </.page>
</Layouts.app>
