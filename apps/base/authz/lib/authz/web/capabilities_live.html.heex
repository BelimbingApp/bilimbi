<Layouts.app
  flash={@flash}
  current_scope={@current_scope}
  active_nav="admin.authz.capability"
>
  <.page id="capabilities-index">
    <.header>
      Capabilities
      <:title_actions>
        <.icon_button
          icon="bilimbi-pin"
          label="Pin Capabilities to sidebar"
          context={:inline}
          id="capabilities-pin"
          data-nav-pin="nav-admin-authz-capability"
          aria-pressed="false"
        />
      </:title_actions>
      <:subtitle>
        All registered capability keys and their source modules
      </:subtitle>
    </.header>

    <.filter_toolbar id="capabilities-filters" form={@filters_form} event="filter">
      <:control
        type={:search}
        field={@filters_form[:search]}
        id="capabilities-search"
        label="Search capabilities"
        placeholder="Search by capability or module..."
      />
      <:control
        type={:select}
        field={@filters_form[:domain]}
        id="filter-domain"
        label="Filter by domain"
        options={[{"All Domains", ""} | Enum.map(@domains, &{&1, &1})]}
      />
    </.filter_toolbar>

    <.card id="capabilities-card" inner_class="p-0">
      <.flex_table
        id="capabilities-table"
        framed={false}
        columns={@columns.column_views}
        rows={@columns.rows}
        mode={@columns.mode}
        zoom={@columns.zoom}
        suggestions={@columns.suggestions}
        add_query={@columns.add_query}
        row_id={&"capabilities-#{&1}"}
        sort_by={@state.sort_by}
        sort_dir={@state.sort_dir}
      >
        <:col :let={%{record: cap}} id="key">
          <span class="font-mono text-xs text-ink">{cap.key}</span>
        </:col>

        <:col :let={%{record: cap}} id="domain">
          <span class="text-sm text-ink-muted">{cap.domain}</span>
        </:col>

        <:col :let={%{record: cap}} id="resource">
          <span class="text-sm text-ink-muted">{cap.resource}</span>
        </:col>

        <:col :let={%{record: cap}} id="action">
          <span class="text-sm text-ink-muted">{cap.action}</span>
        </:col>

        <:col :let={%{record: cap}} id="module">
          <span class="text-sm text-ink-muted">{cap.module}</span>
        </:col>

        <:empty :if={@page.total_entries == 0}>
          {if @state.search == "" and @state.filters.domain == "",
            do: "No capabilities found.",
            else: "No capabilities match these filters."}
        </:empty>
      </.flex_table>

      <.pagination
        id="capabilities-pagination"
        page={@page}
        filters_form={@filters_form}
        filters_event="filter"
      />
    </.card>
  </.page>
</Layouts.app>
