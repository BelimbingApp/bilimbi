<Layouts.app
  flash={@flash}
  current_scope={@current_scope}
  active_nav="admin.authz.principal-role"
>
  <.page id="principal-roles-index">
    <.header>
      Principal Roles
      <:title_actions>
        <.icon_button
          icon="bilimbi-pin"
          label="Pin Principal Roles to sidebar"
          context={:inline}
          id="principal-roles-pin"
          data-nav-pin="nav-admin-authz-principal-role"
          aria-pressed="false"
        />
      </:title_actions>
      <:subtitle>
        User and principal role assignments
      </:subtitle>
    </.header>

    <.filter_toolbar id="assignments-filters" form={@filters_form} event="filter">
      <:control
        type={:search}
        field={@filters_form[:search]}
        id="assignments-search"
        label="Search assignments"
        placeholder="Search by role, principal name, type, or principal id"
      />
    </.filter_toolbar>

    <%!-- A caption, not a banner: the widening is a standing property of the
         rows, so it reads as a quiet caution in the warning tokens. --%>
    <p
      :if={@reach_caution?}
      id="principal-roles-reach-caution"
      role="note"
      class="mb-2 inline-flex items-center gap-1.5 text-xs text-warning-ink"
    >
      <.icon name="warning" class="size-4 shrink-0" />
      <span>Beyond this tenant's companies: this list also includes role assignments attached to no company.</span>
    </p>

    <.card id="principal-roles-card" inner_class="p-0">
      <.flex_table
        id="principal-roles"
        framed={false}
        columns={@columns.column_views}
        rows={@columns.rows}
        mode={@columns.mode}
        zoom={@columns.zoom}
        suggestions={@columns.suggestions}
        add_query={@columns.add_query}
        row_id={&"assignments-#{&1}"}
        sort_by={@state.sort_by}
        sort_dir={@state.sort_dir}
      >
        <:col :let={%{record: assignment}} id="principal_name">
          <span class={["whitespace-nowrap", !assignment.principal_name && "tabular-nums"]}>
            <.link
              :if={assignment.principal_type == "user"}
              navigate={~p"/users/#{assignment.principal_id}"}
              class="text-sm font-medium text-action hover:underline"
            >
              {principal_identity(assignment)}
            </.link>
            <span :if={assignment.principal_type != "user"} class="text-sm text-ink">
              {principal_identity(assignment)}
            </span>
          </span>
        </:col>

        <:col :let={%{record: assignment}} id="principal_type">
          <.badge>{principal_label(assignment)}</.badge>
        </:col>

        <:col :let={%{record: assignment}} id="role_name">
          <.link
            navigate={~p"/authz/roles/#{assignment.role_id}"}
            class="text-sm font-medium text-action hover:underline"
          >
            {assignment.role_name}
          </.link>
        </:col>

        <:col :let={%{record: assignment}} id="company_name">
          <span class="whitespace-nowrap text-ink-muted">
            {company_name(@company_names, assignment.company_id)}
          </span>
        </:col>

        <:col :let={%{record: assignment}} id="created_at">
          <span class="whitespace-nowrap tabular-nums text-ink-muted">
            <.datetime id={"assignment-created-#{assignment.id}"} value={assignment.created_at} />
          </span>
        </:col>

        <:empty :if={@page.total_entries == 0}>
          {if @state.search == "",
            do: "No principal role assignments found.",
            else: "No principal role assignments match these filters."}
        </:empty>
      </.flex_table>

      <.pagination
        id="assignments-pagination"
        page={@page}
        filters_form={@filters_form}
        filters_event="filter"
      />
    </.card>
  </.page>
</Layouts.app>
