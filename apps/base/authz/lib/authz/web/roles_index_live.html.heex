<Layouts.app flash={@flash} current_scope={@current_scope} active_nav="admin.authz.role">
  <.page id="roles-index">
    <.header>
      Roles
      <:title_actions>
        <button
          type="button"
          id="roles-pin"
          data-nav-pin="nav-admin-authz-role"
          title="Pin Roles to sidebar"
          aria-label="Pin Roles to sidebar"
          aria-pressed="false"
          class="grid size-5 place-items-center rounded-sm text-ink-faint transition hover:bg-surface-sunken hover:text-ink focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-strong"
        >
          <.icon name="bilimbi-pin" class="size-3.5" />
        </button>
      </:title_actions>
      <:subtitle>
        System roles ship with the platform; custom roles belong to a company in this tenant
      </:subtitle>
      <:actions>
        <.button
          :if={@can_create?}
          id="roles-create"
          navigate={~p"/authz/roles/create"}
          variant="primary"
        >
          Create Role
        </.button>
      </:actions>
    </.header>

    <.card id="roles-card" inner_class="p-0">
      <.form
        for={%{}}
        as={:filters}
        id="roles-filters"
        phx-change="search"
        phx-submit="search"
        class="p-2 mb-2"
      >
        <div class="relative">
          <.icon
            name="hero-magnifying-glass"
            class="pointer-events-none absolute left-2.5 top-1/2 size-4 -translate-y-1/2 text-ink-faint"
          />
          <.input
            type="search"
            id="roles-search"
            name="search"
            value={@state.search}
            placeholder="Search name, code or description"
            phx-debounce="300"
            autocomplete="off"
            label="Search roles"
            label_class="sr-only"
            wrapper_class="mb-0"
            class="block w-full max-w-sm rounded-lg border border-line bg-surface py-1.5 pl-8 pr-3 text-sm text-ink shadow-xs transition placeholder:text-ink-faint focus:border-action focus:outline-none focus:ring-2 focus:ring-action/20"
          />
        </div>
      </.form>

      <.table
        id="roles"
        rows={@streams.roles}
        row_id={fn {dom_id, _role} -> dom_id end}
        row_item={fn {_dom_id, role} -> role end}
        sort_by={@state.sort_by}
        sort_dir={@state.sort_dir}
        framed={false}
      >
        <:col :let={role} label="Name" sort="name" sort_id="roles-sort-name">
          <.link
            navigate={~p"/authz/roles/#{role.id}"}
            class="font-medium text-ink-strong hover:underline"
          >
            {role.name}
          </.link>
          <p :if={role.description} class="text-xs text-ink-subtle">{role.description}</p>
        </:col>

        <:col :let={role} label="Code" sort="code" sort_id="roles-sort-code">
          <span class="font-mono text-xs text-ink-muted">{role.code}</span>
        </:col>

        <:col :let={role} label="Scope" sort="is_system" sort_id="roles-sort-is_system">
          <.badge kind={scope_kind(role)}>{scope_label(role)}</.badge>
          <.badge :if={role.grant_all} kind={:warning} class="ml-1">Grants all</.badge>
        </:col>

        <:col :let={role} label="Capabilities">
          <span class="tabular-nums text-ink-muted">
            <%= if role.grant_all do %>
              <span title="A grant-all role carries every capability, present and future">All</span>
            <% else %>
              {role.capability_count}
            <% end %>
          </span>
        </:col>

        <:col :let={role} label="Principals">
          <span class="tabular-nums text-ink-muted">{role.principal_count}</span>
        </:col>

        <:empty :if={@page.total_entries == 0}>
          {if @state.search == "",
            do: "No roles are visible in this tenant.",
            else: "No roles match #{@state.search}."}
        </:empty>
      </.table>

      <.pagination
        id="roles-pagination"
        page={@page}
        filters_form={@filters_form}
        filters_event="search"
      />
    </.card>
  </.page>
</Layouts.app>
