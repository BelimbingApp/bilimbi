<Layouts.app
  flash={@flash}
  current_scope={@current_scope}
  active_nav="admin.authz.principal-capability"
>
  <.page id="principal-capabilities-index">
    <.header>
      Principal Capabilities
      <:title_actions>
        <button
          type="button"
          id="principal-capabilities-pin"
          data-nav-pin="nav-admin-authz-principal-capability"
          title="Pin Principal Capabilities to sidebar"
          aria-label="Pin Principal Capabilities to sidebar"
          aria-pressed="false"
          class="grid size-6 place-items-center rounded-sm text-ink-faint transition hover:bg-surface-sunken hover:text-ink focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-strong"
        >
          <.icon name="bilimbi-pin" class="size-3.5" />
        </button>
      </:title_actions>
      <:subtitle>
        Capabilities granted or denied directly, outside any role. A direct denial outranks a role's grant.
      </:subtitle>
    </.header>

    <.card id="principal-capabilities-card" inner_class="p-0">
      <.form
        for={%{}}
        as={:filters}
        id="grants-filters"
        phx-change="filter"
        phx-submit="filter"
        class="p-2 mb-2"
      >
        <div class="grid gap-2 sm:grid-cols-[minmax(0,1fr)_12rem]">
          <div class="relative">
            <.icon
              name="hero-magnifying-glass"
              class="pointer-events-none absolute left-2.5 top-1/2 size-4 -translate-y-1/2 text-ink-faint"
            />
            <.input
              type="search"
              id="grants-search"
              name="search"
              value={@state.search}
              placeholder="Search by capability key or principal name"
              phx-debounce="300"
              autocomplete="off"
              label="Search capabilities"
              label_class="sr-only"
              wrapper_class="mb-0"
              class="block w-full rounded-lg border border-line bg-surface py-1.5 pl-8 pr-3 text-sm text-ink shadow-xs transition placeholder:text-ink-faint focus:border-action focus:outline-none focus:ring-2 focus:ring-action/20"
            />
          </div>
          <.input
            type="select"
            id="grants-result"
            name="result"
            value={@state.result}
            label="Filter by grant or denial"
            label_class="sr-only"
            wrapper_class="mb-0"
            prompt="Granted and denied"
            options={[{"Granted", "allowed"}, {"Denied", "denied"}]}
            class="h-[2.125rem] w-full rounded-lg border border-line bg-surface px-2 text-sm text-ink shadow-xs transition focus:border-action focus:outline-none focus:ring-2 focus:ring-action/20"
          />
        </div>
      </.form>

      <.table
        id="principal-capabilities"
        rows={@streams.grants}
        row_id={fn {dom_id, _grant} -> dom_id end}
        row_item={fn {_dom_id, grant} -> grant end}
        sort_by={@state.sort_by}
        sort_dir={@state.sort_dir}
        framed={false}
      >
        <:col
          :let={grant}
          label="Principal"
          sort="principal_name"
          sort_id="grants-sort-principal_name"
        >
          <span class={["whitespace-nowrap text-ink", !grant.principal_name && "tabular-nums"]}>
            {principal_identity(grant)}
          </span>
        </:col>

        <:col
          :let={grant}
          label="Type"
          sort="principal_type"
          sort_id="grants-sort-principal_type"
        >
          <.badge>{principal_label(grant)}</.badge>
        </:col>

        <:col :let={grant} label="Capability" sort="capability" sort_id="grants-sort-capability">
          <span class="font-mono text-xs text-ink">{grant.capability}</span>
          <.badge :if={unknown_capability?(grant)} kind={:warning} class="ml-1">
            Unknown
          </.badge>
        </:col>

        <:col :let={grant} label="Effect" sort="allowed" sort_id="grants-sort-allowed">
          <.badge kind={if grant.allowed, do: :success, else: :danger}>
            {if grant.allowed, do: "Granted", else: "Denied"}
          </.badge>
        </:col>

        <:col :let={grant} label="Company" sort="company_name" sort_id="grants-sort-company_name">
          <span class="whitespace-nowrap text-ink-muted">
            {company_name(@company_names, grant.company_id)}
          </span>
        </:col>

        <:col :let={grant} label="Granted" sort="created_at" sort_id="grants-sort-created_at">
          <span class="whitespace-nowrap tabular-nums text-ink-muted">
            <.datetime id={"grant-created-#{grant.id}"} value={grant.created_at} />
          </span>
        </:col>

        <:empty :if={@page.total_entries == 0}>
          {if @state.search == "" and @state.result == "",
            do: "No capabilities have been granted directly in this tenant.",
            else: "No direct capabilities match these filters."}
        </:empty>
      </.table>

      <.pagination
        id="grants-pagination"
        page={@page}
        filters_form={@filters_form}
        filters_event="filter"
      />
    </.card>
  </.page>
</Layouts.app>
