<Layouts.app flash={@flash} current_scope={@current_scope} active_nav="admin.authz.decision-log">
  <div class="mx-auto max-w-6xl">
    <.header>
      Decision Logs
      <:subtitle>Every authorization decision this tenant has recorded, newest first</:subtitle>
    </.header>

    <form id="logs-filters" phx-change="filter" phx-submit="filter" class="mt-5 flex gap-3">
      <div class="flex-1">
        <label for="logs-search" class="sr-only">Search decisions</label>
        <input
          type="search"
          id="logs-search"
          name="search"
          value={@state.search}
          placeholder="Search capability, reason or resource"
          phx-debounce="300"
          autocomplete="off"
          class="w-full max-w-sm rounded-md border border-line bg-surface px-3 py-1.5 text-sm text-ink focus:border-brand-strong focus:outline-none"
        />
      </div>
      <div>
        <label for="logs-result" class="sr-only">Filter by result</label>
        <select
          id="logs-result"
          name="result"
          class="rounded-md border border-line bg-surface px-3 py-1.5 text-sm text-ink focus:border-brand-strong focus:outline-none"
        >
          <option value="" selected={@state.result == ""}>All results</option>
          <option value="allowed" selected={@state.result == "allowed"}>Allowed</option>
          <option value="denied" selected={@state.result == "denied"}>Denied</option>
        </select>
      </div>
    </form>

    <div class="mt-4 overflow-x-auto rounded-xl border border-line bg-surface">
      <table class="w-full text-left text-sm">
        <thead class="border-b border-line bg-surface-sunken">
          <tr>
            <th
              :for={
                {column, label} <- [
                  {"occurred_at", "When"},
                  {"actor_type", "Actor"},
                  {"capability", "Capability"},
                  {"allowed", "Result"},
                  {"reason", "Reason"},
                  {"resource", "Resource"}
                ]
              }
              class="px-4 py-2.5 text-xs font-semibold uppercase tracking-wider text-ink-subtle"
            >
              <button
                type="button"
                id={"logs-sort-#{column}"}
                phx-click="sort"
                phx-value-column={column}
                class="inline-flex items-center gap-1 hover:text-ink"
              >
                {label}
                <.icon
                  :if={sort_indicator(@state, String.to_existing_atom(column))}
                  name={sort_indicator(@state, String.to_existing_atom(column))}
                  class="size-3"
                />
              </button>
            </th>
          </tr>
        </thead>
        <tbody id="decision-logs" phx-update="stream" class="divide-y divide-line-subtle">
          <tr :for={{dom_id, log} <- @streams.logs} id={dom_id} class="hover:bg-surface-sunken">
            <td class="px-4 py-2.5 whitespace-nowrap tabular-nums text-ink-muted">
              {occurred_at(log)}
            </td>
            <td class="px-4 py-2.5 whitespace-nowrap text-ink-muted">
              <.badge>{actor_label(log)}</.badge>
              <span class="ml-1 tabular-nums">{log.actor_id}</span>
            </td>
            <td class="px-4 py-2.5 font-mono text-xs text-ink">{log.capability}</td>
            <td class="px-4 py-2.5">
              <.badge kind={if log.allowed, do: :success, else: :danger}>
                {if log.allowed, do: "Allowed", else: "Denied"}
              </.badge>
            </td>
            <td class="px-4 py-2.5 font-mono text-xs text-ink-muted">{log.reason || "—"}</td>
            <td class="px-4 py-2.5 text-ink-muted">{resource_label(log)}</td>
          </tr>
        </tbody>
      </table>

      <p :if={@page.total_entries == 0} class="px-4 py-8 text-center text-sm text-ink-muted">
        {if @state.search == "" and @state.result == "",
          do: "No authorization decisions have been recorded in this tenant.",
          else: "No decisions match these filters."}
      </p>
    </div>

    <div
      :if={@page.total_pages > 1}
      id="logs-pagination"
      class="mt-3 flex items-center justify-between text-sm"
    >
      <p class="text-ink-subtle">
        Page {@page.page} of {@page.total_pages} · {@page.total_entries} decisions
      </p>
      <div class="flex gap-2">
        <.button :if={@page.page > 1} id="logs-prev" phx-click="page" phx-value-page={@page.page - 1}>
          Previous
        </.button>
        <.button
          :if={@page.page < @page.total_pages}
          id="logs-next"
          phx-click="page"
          phx-value-page={@page.page + 1}
        >
          Next
        </.button>
      </div>
    </div>
  </div>
</Layouts.app>
