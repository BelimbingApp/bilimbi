<Layouts.app flash={@flash} current_scope={@current_scope} active_nav="admin.authz.decision-log">
  <.page id="decision-logs-index">
    <.header>
      Decision Logs
      <:title_actions>
        <button
          type="button"
          id="decision-logs-pin"
          data-nav-pin="nav-admin-authz-decision-log"
          title="Pin Decision Logs to sidebar"
          aria-label="Pin Decision Logs to sidebar"
          aria-pressed="false"
          class="grid size-5 place-items-center rounded-sm text-ink-faint transition hover:bg-surface-sunken hover:text-ink focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-strong"
        >
          <.icon name="bilimbi-pin" class="size-3.5" />
        </button>
      </:title_actions>
      <:subtitle>Every authorization decision this tenant has recorded, newest first</:subtitle>
    </.header>

    <.card id="decision-logs-card" inner_class="p-0">
      <.form
        for={%{}}
        as={:filters}
        id="logs-filters"
        phx-change="filter"
        phx-submit="filter"
        class="p-2 mb-2"
      >
        <div class="grid gap-2 sm:grid-cols-[minmax(0,1fr)_12rem]">
          <div class="relative">
            <.icon
              name="hero-magnifying-glass"
              class="pointer-events-none absolute left-2.5 top-1/2 size-4 -translate-y-1/2 text-ink-faint"
            />
            <.input
              type="search"
              id="logs-search"
              name="search"
              value={@state.search}
              placeholder="Search capability, reason or resource"
              phx-debounce="300"
              autocomplete="off"
              label="Search decisions"
              label_class="sr-only"
              wrapper_class="mb-0"
              class="block w-full rounded-lg border border-line bg-surface py-1.5 pl-8 pr-3 text-sm text-ink shadow-xs transition placeholder:text-ink-faint focus:border-action focus:outline-none focus:ring-2 focus:ring-action/20"
            />
          </div>
          <.input
            type="select"
            id="logs-result"
            name="result"
            value={@state.result}
            label="Filter by result"
            label_class="sr-only"
            wrapper_class="mb-0"
            prompt="All results"
            options={[{"Allowed", "allowed"}, {"Denied", "denied"}]}
            class="h-[2.125rem] w-full rounded-lg border border-line bg-surface px-2 text-sm text-ink shadow-xs transition focus:border-action focus:outline-none focus:ring-2 focus:ring-action/20"
          />
        </div>
      </.form>

      <.table
        id="decision-logs"
        rows={@streams.logs}
        row_id={fn {dom_id, _log} -> dom_id end}
        row_item={fn {_dom_id, log} -> log end}
        sort_by={@state.sort_by}
        sort_dir={@state.sort_dir}
        framed={false}
      >
        <:col :let={log} label="When" sort="occurred_at" sort_id="logs-sort-occurred_at">
          <span class="whitespace-nowrap tabular-nums text-ink-muted"><.datetime id={"log-occurred-#{log.id}"} value={log.occurred_at} /></span>
        </:col>

        <:col :let={log} label="Actor" sort="actor_type" sort_id="logs-sort-actor_type">
          <span class="whitespace-nowrap text-ink-muted">
            <.badge>{actor_label(log)}</.badge>
            <span class="ml-1 tabular-nums">{log.actor_id}</span>
            <span :if={log.acting_for_user_id} class="ml-1 text-xs text-ink-faint tabular-nums">
              (as #{log.acting_for_user_id})
            </span>
          </span>
        </:col>

        <:col :let={log} label="Capability" sort="capability" sort_id="logs-sort-capability">
          <span class="font-mono text-xs text-ink">{log.capability}</span>
        </:col>

        <:col :let={log} label="Result" sort="allowed" sort_id="logs-sort-allowed">
          <.badge kind={if log.allowed, do: :success, else: :danger}>
            {if log.allowed, do: "Allowed", else: "Denied"}
          </.badge>
        </:col>

        <:col :let={log} label="Reason" sort="reason" sort_id="logs-sort-reason">
          <span class="font-mono text-xs text-ink-muted">{log.reason || "—"}</span>
        </:col>

        <:col :let={log} label="Resource" sort="resource" sort_id="logs-sort-resource">
          <span class="text-ink-muted">{resource_label(log)}</span>
        </:col>

        <:empty :if={@page.total_entries == 0}>
          {if @state.search == "" and @state.result == "",
            do: "No authorization decisions have been recorded in this tenant.",
            else: "No decisions match these filters."}
        </:empty>
      </.table>

      <div
        :if={@page.total_pages > 0}
        id="logs-pagination"
        class="flex items-center justify-between border-t border-line px-4 py-3 text-sm"
      >
        <p id="logs-pagination-summary" class="text-ink-subtle">
          Page {@page.page} of {@page.total_pages} · {@page.total_entries} {if @page.total_entries == 1, do: "decision", else: "decisions"}
        </p>
        <div :if={@page.total_pages > 1} class="flex gap-2">
          <.button :if={@page.page > 1} id="logs-prev" phx-click="page" phx-value-page={@page.page - 1}>
            Previous
          </.button>
          <.button
            :if={@page.page < @page.total_pages}
            id="logs-next"
            phx-click="page"
            phx-value-page={@page.page + 1}
          >
            Next
          </.button>
        </div>
      </div>
    </.card>
  </.page>
</Layouts.app>
