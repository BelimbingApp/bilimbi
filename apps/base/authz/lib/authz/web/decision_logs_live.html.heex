<Layouts.app flash={@flash} current_scope={@current_scope} active_nav="admin.authz.decision-log">
  <.page id="decision-logs-index">
    <.header>
      Decision Logs
      <:title_actions>
        <.icon_button
          icon="bilimbi-pin"
          label="Pin Decision Logs to sidebar"
          context={:inline}
          id="decision-logs-pin"
          data-nav-pin="nav-admin-authz-decision-log"
          aria-pressed="false"
          />
      </:title_actions>
      <:subtitle>Every authorization decision this tenant has recorded, newest first</:subtitle>
    </.header>

    <.filter_toolbar id="logs-filters" form={@filters_form} event="filter">
      <:control
        type={:search}
        field={@filters_form[:search]}
        id="logs-search"
        label="Search decisions"
        placeholder="Search capability, reason or resource"
      />
      <:control
        type={:select}
        field={@filters_form[:result]}
        id="logs-result"
        label="Filter by result"
        options={[{"All results", ""}, {"Allowed", "allowed"}, {"Denied", "denied"}]}
      />
    </.filter_toolbar>

    <%!-- A caption, not a banner: the widening is a standing property of the
         rows, so it reads as a quiet caution in the warning tokens. --%>
    <p
      :if={@reach_caution?}
      id="decision-logs-reach-caution"
      role="note"
      class="mb-2 inline-flex items-center gap-1.5 text-xs text-warning-ink"
    >
      <.icon name="warning" class="size-4 shrink-0" />
      <span>Beyond this tenant's companies: this list also includes decisions recorded against no company.</span>
    </p>

    <.card id="decision-logs-card" inner_class="p-0">


      <.table
        id="decision-logs"
        rows={@streams.logs}
        row_id={fn {dom_id, _log} -> dom_id end}
        row_item={fn {_dom_id, log} -> log end}
        sort_by={@state.sort_by}
        sort_dir={@state.sort_dir}
        framed={false}
      >
        <:col :let={log} label="When" sort="occurred_at" sort_id="logs-sort-occurred_at">
          <span class="whitespace-nowrap tabular-nums text-ink-muted"><.datetime id={"log-occurred-#{log.id}"} value={log.occurred_at} /></span>
        </:col>

        <:col :let={log} label="Actor" sort="actor_type" sort_id="logs-sort-actor_type">
          <span class="whitespace-nowrap text-ink-muted">
            <.badge>{actor_label(log)}</.badge>
            <span class="ml-1 tabular-nums">{log.actor_id}</span>
            <span :if={log.acting_for_user_id} class="ml-1 text-xs text-ink-muted tabular-nums">
              (as #{log.acting_for_user_id})
            </span>
          </span>
        </:col>

        <:col :let={log} label="Capability" sort="capability" sort_id="logs-sort-capability">
          <span class="font-mono text-xs text-ink">{log.capability}</span>
        </:col>

        <:col :let={log} label="Result" sort="allowed" sort_id="logs-sort-allowed">
          <.badge kind={if log.allowed, do: :success, else: :danger}>
            {if log.allowed, do: "Allowed", else: "Denied"}
          </.badge>
        </:col>

        <:col :let={log} label="Reason" sort="reason" sort_id="logs-sort-reason">
          <span class="font-mono text-xs text-ink-muted">{log.reason || "—"}</span>
        </:col>

        <:col :let={log} label="Resource" sort="resource" sort_id="logs-sort-resource">
          <span class="text-ink-muted">{resource_label(log)}</span>
        </:col>

        <:empty :if={@page.total_entries == 0}>
          {if @state.search == "" and @state.result == "",
            do: "No authorization decisions have been recorded in this tenant.",
            else: "No decisions match these filters."}
        </:empty>
      </.table>

      <.pagination
        id="logs-pagination"
        page={@page}
        filters_form={@filters_form}
        filters_event="filter"
      />
    </.card>
  </.page>
</Layouts.app>
