<Layouts.app flash={@flash} current_scope={@current_scope} active_nav="admin.authz.role">
  <.page variant={:detail}>
    <.header>
      {@role.name}
      <:subtitle>
        <span class="font-mono text-xs">{@role.code}</span>
      </:subtitle>
      <:actions>
        <.back_link id="role-back" navigate={~p"/authz/roles"} title="Back to roles" />
      </:actions>
    </.header>

    <.card
      id="role-summary"
      class="mt-6"
      inner_class="p-5 sm:p-6"
      role="region"
      aria-labelledby="role-details-heading"
    >
      <.section_heading id="role-details-heading" title="Role Details" />
      <.list>
        <:item title="Scope">
          <.badge kind={scope_kind(@role)}>{scope_label(@role)}</.badge>
        </:item>
        <:item title="Description">{@role.description || "—"}</:item>
        <:item title="Owning company">{@role.company_id || "—"}</:item>
        <:item title="Grants all capabilities">
          {if @role.grant_all, do: "Yes", else: "No"}
        </:item>
      </.list>
    </.card>

    <.card
      id="role-capabilities-card"
      class="mt-6"
      inner_class="p-5 sm:p-6"
      role="region"
      aria-labelledby="role-capabilities-heading"
    >
      <.section_heading id="role-capabilities-heading" title="Capabilities" />

      <p :if={@role.grant_all} id="role-grant-all" class="mt-1 text-xs text-ink-subtle">
        This role grants every capability, including ones added by modules installed later.
        Individual grants below are therefore not the whole story.
      </p>

      <ul
        :if={@capabilities != []}
        id="role-capabilities"
        class="mt-2 flex flex-wrap gap-1.5"
      >
        <li
          :for={capability <- @capabilities}
          class="rounded-md bg-surface-sunken px-2 py-1 font-mono text-xs text-ink-muted"
        >
          {capability}
        </li>
      </ul>

      <p
        :if={@capabilities == [] and not @role.grant_all}
        class="mt-2 rounded-xl border border-line bg-surface px-4 py-6 text-center text-sm text-ink-muted"
      >
        This role grants no capabilities.
      </p>
    </.card>

    <.card
      id="role-principals-card"
      class="mt-6"
      inner_class="p-5 sm:p-6"
      role="region"
      aria-labelledby="role-principals-heading"
    >
      <.section_heading id="role-principals-heading" title="Principals" />

      <.table
        id="role-principals"
        rows={@principal_roles}
        row_id={&"principal-role-#{&1.id}"}
        caption="Principals"
        framed={false}
      >
        <:col :let={assignment} label="Type">
          <.badge>{principal_label(assignment)}</.badge>
        </:col>
        <:col :let={assignment} label="Principal">
          <span class="tabular-nums text-ink-muted">{assignment.principal_id}</span>
        </:col>
        <:col :let={assignment} label="Company">
          <span class="tabular-nums text-ink-muted">{assignment.company_id || "—"}</span>
        </:col>
        <:empty :if={@principal_roles == []}>
          Nobody in this tenant holds this role.
        </:empty>
      </.table>
    </.card>
  </.page>
</Layouts.app>
