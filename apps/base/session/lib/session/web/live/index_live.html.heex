<Layouts.app flash={@flash} current_scope={@current_scope} active_nav="admin.system.session">
  <.page>
    <.header>
      Sessions
      <:subtitle>View and manage active sessions</:subtitle>
    </.header>

    <form id="sessions-search" phx-change="search" phx-submit="search" class="mt-5">
      <.input
        type="search"
        name="q"
        id="sessions-search-q"
        value={@query}
        phx-debounce="300"
        placeholder="Search by IP address or user agent..."
      />
    </form>

    <div class="mt-2">
      <.table
        id="sessions"
        rows={@streams.sessions}
        row_id={fn {id, _session} -> id end}
        row_item={fn {_id, session} -> session end}
      >
        <:col :let={session} label="User">{user_label(session)}</:col>
        <:col :let={session} label="IP Address">
          <span class="tabular-nums text-ink-muted">{session.ip_address || "—"}</span>
        </:col>
        <:col :let={session} label="User Agent">
          <span class="max-w-xs truncate text-ink-muted" title={session.user_agent}>
            {truncate_ua(session.user_agent)}
          </span>
        </:col>
        <:col :let={session} label="Last Activity">
          <span class="text-ink-muted">{relative_activity(session.last_activity)}</span>
        </:col>
        <:col :let={session} label="Status">
          <.badge :if={session.id == @current_session_id} kind={:success}>Current</.badge>
        </:col>
        <:action :let={session}>
          <.button
            :if={
              session.id != @current_session_id and
                allowed?(@current_scope, "admin.system.session.manage")
            }
            id={"sessions-terminate-#{session.id}"}
            phx-click="terminate"
            phx-value-id={session.id}
            data-confirm="Are you sure you want to terminate this session?"
            title="Terminate session"
            class="text-danger hover:bg-danger-surface"
          >
            <.icon name="hero-x-circle" class="size-4" />
            <span class="sr-only">Terminate</span>
          </.button>
        </:action>
        <:empty :if={@sessions_count == 0}>
          No sessions found.
        </:empty>
      </.table>
    </div>
  </.page>
</Layouts.app>
