<Layouts.app flash={@flash} current_scope={@current_scope} active_nav="admin.system.session">
  <.page id="sessions-index">
    <.header>
      Sessions
      <:title_actions>
        <.icon_button
          icon="bilimbi-pin"
          label="Pin Sessions to sidebar"
          context={:inline}
          id="sessions-pin"
          data-nav-pin="nav-admin-system-session"
          aria-pressed="false"
        />
      </:title_actions>

      <:subtitle>View and manage active sessions</:subtitle>
    </.header>

    <.filter_toolbar id="sessions-filters" form={@filters_form} event="filters">
      <:control
        type={:search}
        field={@filters_form[:search]}
        id="sessions-search"
        label="Search sessions"
        placeholder="Search by IP address or user agent..."
      />
    </.filter_toolbar>

    <.card id="sessions-card" inner_class="p-0">
      <.flex_table
        id="sessions"
        framed={false}
        columns={@columns.column_views}
        rows={@columns.rows}
        mode={@columns.mode}
        zoom={@columns.zoom}
        suggestions={@columns.suggestions}
        add_query={@columns.add_query}
        sort_by={@index_state.sort_by}
        sort_dir={@index_state.sort_dir}
        row_id={&"sessions-#{&1}"}
        caption="Sessions"
      >
        <:col :let={%{record: session}} id="user_id">
          {user_label(session, @user_names)}
        </:col>
        <:col :let={%{record: session}} id="ip_address">
          <span class="tabular-nums text-ink-muted">{session.ip_address || "—"}</span>
        </:col>
        <:col :let={%{record: session}} id="user_agent">
          <span class="max-w-xs truncate text-ink-muted" title={session.user_agent}>
            {truncate_ua(session.user_agent)}
          </span>
        </:col>
        <:col :let={%{record: session}} id="last_activity">
          <span class="text-ink-muted">
            {relative_activity(session.last_activity)}
          </span>
        </:col>
        <:col :let={%{record: session}} id="status">
          <.badge :if={session.id == @current_session_id} kind={:success}>Current</.badge>
        </:col>

        <:action :let={%{record: session}}>
          <.icon_button
            :if={
              session.id != @current_session_id and
                allowed?(@current_scope, "admin.system.session.manage")
            }
            icon="hero-x-circle"
            label="Terminate session"
            kind={:danger}
            id={"sessions-terminate-#{session.id}"}
            phx-click="request_terminate"
            phx-value-id={session.id}
          />
        </:action>

        <:empty :if={@sessions_page.total_entries == 0}>
          No sessions found.
        </:empty>
      </.flex_table>

      <.pagination
        id="sessions-pagination"
        page={@sessions_page}
        page_sizes={@page_sizes}
        filters_form={@filters_form}
      />
    </.card>

    <.confirm_dialog
      :if={@pending_terminate}
      id="terminate-session-confirm"
      consequence={"#{session_name(@pending_terminate, @user_names)} will be terminated."}
      detail="Whoever holds it is signed out on that device at once and must sign in again. This cannot be undone."
      confirm="Terminate"
      working="Terminating…"
      on_confirm={JS.push("terminate")}
      on_cancel={JS.push("cancel_terminate")}
    />
  </.page>
</Layouts.app>
