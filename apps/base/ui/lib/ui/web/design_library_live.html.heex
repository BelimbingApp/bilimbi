<%!-- A specimen calls the real component. Do not simulate behaviour to
     make an example look finished, and do not mount a second live copy of
     something the layout already renders. A catalog id stays on the
     element's id, never in the text a person reads. The anchor and state
     rules are Bilimbi.Base.UI.DesignLibrarySource. --%>
<Layouts.app flash={@flash} current_scope={@current_scope} active_nav={@active_nav}>
  <.page id="design-library" class="space-y-6">
    <.header>
      {@area_title}
      <:subtitle>{@area_description}</:subtitle>
      <:actions>
        <span
          id="design-library-stage"
          class="inline-flex items-center gap-1.5 rounded-full border border-line bg-surface px-2.5 py-1 text-xs font-medium text-ink-muted"
        >
          <.icon name="view" class="size-3.5" />
          {@area_stage}
        </span>
      </:actions>
    </.header>

    <%= if @area == :theme do %>
      <section id="foundations" class="space-y-8">
        <section id="theme-surfaces-lines" class="space-y-4">
          <div>
            <h2 class="text-base font-semibold text-ink-strong">Surfaces &amp; Lines</h2>
            <p class="text-sm text-ink-muted">
              Background surfaces and the structural lines drawn on them.
            </p>
          </div>

          <div class="space-y-5 rounded-xl border border-line bg-surface p-4 shadow-xs">
            <div>
              <h3 class="mb-2 text-sm font-semibold text-ink">Surfaces and line contrast</h3>
              <div id="theme-line-contrast" class="mb-3 space-y-2">
                <p class="text-xs text-ink-muted">
                  Each surface below is paired with all three line contrasts, from high to low.
                </p>
                <div id="theme-structure" class="grid gap-3 sm:grid-cols-3">
                  <div>
                    <p class="text-sm text-ink">High-contrast line</p>
                    <p class="text-xs text-ink-muted">Clear separation from the surface</p>
                  </div>
                  <div>
                    <p class="text-sm text-ink">Standard line</p>
                    <p class="text-xs text-ink-muted">Everyday separation from the surface</p>
                  </div>
                  <div>
                    <p class="text-sm text-ink">Low-contrast line</p>
                    <p class="text-xs text-ink-muted">Quiet separation from the surface</p>
                  </div>
                </div>
              </div>
              <div class="grid gap-2 sm:grid-cols-2 lg:grid-cols-5">
                <div class="overflow-hidden rounded-lg border border-line">
                  <div class="flex h-16 flex-col justify-between bg-canvas p-3">
                    <span class="h-px bg-high-contrast-line"></span>
                    <span class="h-px bg-line"></span>
                    <span class="h-px bg-low-contrast-line"></span>
                  </div>
                  <div class="border-t border-line bg-surface p-2">
                    <p class="text-sm font-medium text-ink">Canvas</p>
                    <p class="text-xs text-ink-muted">Page background</p>
                  </div>
                </div>
                <div class="overflow-hidden rounded-lg border border-line">
                  <div class="flex h-16 flex-col justify-between bg-surface p-3">
                    <span class="h-px bg-high-contrast-line"></span>
                    <span class="h-px bg-line"></span>
                    <span class="h-px bg-low-contrast-line"></span>
                  </div>
                  <div class="border-t border-line bg-surface p-2">
                    <p class="text-sm font-medium text-ink">Surface</p>
                    <p class="text-xs text-ink-muted">Cards and controls</p>
                  </div>
                </div>
                <div class="overflow-hidden rounded-lg border border-line">
                  <div class="flex h-16 flex-col justify-between bg-surface-sunken p-3">
                    <span class="h-px bg-high-contrast-line"></span>
                    <span class="h-px bg-line"></span>
                    <span class="h-px bg-low-contrast-line"></span>
                  </div>
                  <div class="border-t border-line bg-surface p-2">
                    <p class="text-sm font-medium text-ink">Sunken</p>
                    <p class="text-xs text-ink-muted">Table heads and wells</p>
                  </div>
                </div>
                <div class="overflow-hidden rounded-lg border border-line">
                  <div class="flex h-16 flex-col justify-between bg-surface-muted p-3">
                    <span class="h-px bg-high-contrast-line"></span>
                    <span class="h-px bg-line"></span>
                    <span class="h-px bg-low-contrast-line"></span>
                  </div>
                  <div class="border-t border-line bg-surface p-2">
                    <p class="text-sm font-medium text-ink">Muted</p>
                    <p class="text-xs text-ink-muted">Quiet grouping</p>
                  </div>
                </div>
                <div class="overflow-hidden rounded-lg border border-line">
                  <div class="flex h-16 flex-col justify-between bg-surface-sidebar p-3">
                    <span class="h-px bg-high-contrast-line"></span>
                    <span class="h-px bg-line"></span>
                    <span class="h-px bg-low-contrast-line"></span>
                  </div>
                  <div class="border-t border-line bg-surface p-2">
                    <p class="text-sm font-medium text-ink">Sidebar</p>
                    <p class="text-xs text-ink-muted">Navigation</p>
                  </div>
                </div>
              </div>
            </div>

            <div id="theme-line-thickness" class="border-t border-line pt-4">
              <h3 class="mb-2 text-sm font-semibold text-ink">Line thickness</h3>
              <div class="grid gap-3 sm:grid-cols-3">
                <div class="rounded-lg bg-canvas p-3">
                  <div class="mb-2 flex items-center gap-3">
                    <span class="text-sm text-ink">Hairline</span>
                    <span class="h-px flex-1 bg-line"></span>
                    <span class="text-xs tabular-nums text-ink-muted">1px</span>
                  </div>
                  <p class="text-xs text-ink-muted">Structural borders and dividers</p>
                </div>
              </div>
            </div>
          </div>
        </section>

        <section id="theme-identity" class="space-y-4">
          <div>
            <h2 class="text-base font-semibold text-ink-strong">Identity &amp; Action</h2>
            <p class="text-sm text-ink-muted">Primary action, selection, and brand roles.</p>
          </div>
          <div class="grid gap-2 rounded-xl border border-line bg-surface p-4 shadow-xs sm:grid-cols-3">
            <div class="space-y-2">
              <div class="rounded-lg bg-action p-3 text-action-ink">
                <p class="text-sm font-semibold">Primary action</p>
                <p class="text-xs opacity-80">The next committed step</p>
              </div>
              <div id="theme-primary-line" class="flex items-center gap-2 px-1">
                <span class="shrink-0 text-xs text-ink-muted">Primary line</span>
                <span class="h-px flex-1 bg-primary-line"></span>
              </div>
            </div>
            <div class="space-y-2">
              <div class="rounded-lg border border-selection-line bg-brand-surface p-3 text-brand-ink">
                <p class="text-sm font-semibold">Selection</p>
                <p class="text-xs opacity-80">Current place or choice</p>
              </div>
              <div id="theme-selection-line" class="flex items-center gap-2 px-1">
                <span class="shrink-0 text-xs text-ink-muted">Selection line</span>
                <span class="h-px flex-1 bg-selection-line"></span>
              </div>
            </div>
            <div class="space-y-2">
              <div class="rounded-lg bg-brand p-3 text-brand-ink">
                <p class="text-sm font-semibold">Brand accent</p>
                <p class="text-xs opacity-80">Bilimbi identity</p>
              </div>
              <div id="theme-brand-line" class="flex items-center gap-2 px-1">
                <span class="shrink-0 text-xs text-ink-muted">Brand line</span>
                <span class="h-px flex-1 bg-brand-line"></span>
              </div>
            </div>
          </div>
        </section>

        <section id="theme-feedback" class="space-y-4">
          <div>
            <h2 class="text-base font-semibold text-ink-strong">Feedback</h2>
            <p class="text-sm text-ink-muted">Success, warning, and danger roles.</p>
          </div>
          <div class="grid gap-2 rounded-xl border border-line bg-surface p-4 shadow-xs sm:grid-cols-3">
            <div class="space-y-2">
              <div class="rounded-lg border border-success-line bg-success-surface p-3 text-success-ink">
                <p class="text-sm font-semibold">Success</p>
                <p class="text-xs opacity-80">Completed as intended</p>
              </div>
              <div id="theme-success-line" class="flex items-center gap-2 px-1">
                <span class="shrink-0 text-xs text-ink-muted">Success line</span>
                <span class="h-px flex-1 bg-success-line"></span>
              </div>
            </div>
            <div class="space-y-2">
              <div class="rounded-lg border border-warning-line bg-warning-surface p-3 text-warning-ink">
                <p class="text-sm font-semibold">Warning</p>
                <p class="text-xs opacity-80">Attention is needed</p>
              </div>
              <div id="theme-warning-line" class="flex items-center gap-2 px-1">
                <span class="shrink-0 text-xs text-ink-muted">Warning line</span>
                <span class="h-px flex-1 bg-warning-line"></span>
              </div>
            </div>
            <div class="space-y-2">
              <div class="rounded-lg border border-danger-line bg-danger-surface p-3 text-danger-ink">
                <p class="text-sm font-semibold">Danger</p>
                <p class="text-xs opacity-80">Failure or destructive work</p>
              </div>
              <div id="theme-danger-line" class="flex items-center gap-2 px-1">
                <span class="shrink-0 text-xs text-ink-muted">Danger line</span>
                <span class="h-px flex-1 bg-danger-line"></span>
              </div>
            </div>
          </div>
        </section>

        <section id="theme-typography" class="space-y-4">
          <div>
            <h2 class="text-base font-semibold text-ink-strong">Typography</h2>
            <p class="text-sm text-ink-muted">
              Ink hierarchy and Instrument Sans throughout Bilimbi.
            </p>
          </div>
          <div class="space-y-5 rounded-xl border border-line bg-surface p-4 shadow-xs">
            <div id="theme-text">
              <h3 class="mb-2 text-sm font-semibold text-ink">Ink hierarchy</h3>
              <div class="grid gap-3 sm:grid-cols-3">
                <div>
                  <p class="text-sm font-semibold text-ink-strong">Strong ink</p>
                  <p class="text-xs text-ink-muted">Headings and emphasis</p>
                </div>
                <div>
                  <p class="text-sm text-ink">Primary ink</p>
                  <p class="text-xs text-ink-muted">Everyday reading</p>
                </div>
                <div>
                  <p class="text-sm text-ink-muted">Muted ink</p>
                  <p class="text-xs text-ink-subtle">Supporting context</p>
                </div>
                <div>
                  <p class="text-sm text-ink-subtle">Subtle ink</p>
                  <p class="text-xs text-ink-muted">Secondary detail</p>
                </div>
                <div>
                  <p class="text-sm text-ink-faint">Faint ink</p>
                  <p class="text-xs text-ink-muted">Placeholder and disabled detail</p>
                </div>
                <div class="rounded-md bg-danger px-2 py-1.5">
                  <p class="text-sm text-ink-inverse">Inverse ink</p>
                  <p class="text-xs text-ink-inverse/70">Text on danger actions</p>
                </div>
              </div>

              <div class="mt-4">
                <h4 class="mb-2 text-xs font-semibold uppercase tracking-wide text-ink-muted">
                  Navigation text
                </h4>
                <div
                  id="theme-navigation-text"
                  class="grid gap-3 rounded-lg bg-surface-sidebar p-3 sm:grid-cols-3"
                >
                  <div>
                    <p class="text-sm text-link">Link</p>
                    <p class="text-xs text-ink-muted">Default navigation and links</p>
                  </div>
                  <div>
                    <p class="text-sm text-muted">Muted</p>
                    <p class="text-xs text-ink-muted">Pinned headings and secondary detail</p>
                  </div>
                  <div>
                    <p class="text-sm text-brand-strong">Active</p>
                    <p class="text-xs text-ink-muted">Current navigation choice</p>
                  </div>
                </div>
              </div>
            </div>

            <div id="theme-type" class="border-t border-line pt-4">
              <h3 class="mb-3 text-sm font-semibold text-ink">Type</h3>
              <div class="grid gap-3 lg:grid-cols-2">
                <div class="space-y-4">
                  <div>
                    <p class="text-xs text-ink-muted">Page heading</p>
                    <p class="text-lg font-semibold leading-8 tracking-tight text-action">
                      Company directory
                    </p>
                  </div>
                  <div>
                    <p class="text-xs text-ink-muted">Section heading</p>
                    <p class="text-base font-semibold text-ink-strong">Contact information</p>
                  </div>
                  <div>
                    <p class="text-xs text-ink-muted">Body</p>
                    <p class="text-sm text-ink">
                      Clear operational text for long working sessions.
                    </p>
                  </div>
                </div>
                <div class="space-y-4">
                  <div>
                    <p class="text-xs text-ink-muted">Label</p>
                    <p class="text-sm font-medium text-ink">Company name</p>
                  </div>
                  <div>
                    <p class="text-xs text-ink-muted">Supporting text</p>
                    <p class="text-sm text-ink-muted">
                      This appears below the primary information.
                    </p>
                  </div>
                  <div>
                    <p class="text-xs text-ink-muted">Numbers and dates</p>
                    <p class="text-sm tabular-nums text-ink">24/08/2026 · 1,024 · 99.50</p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </section>

        <section id="theme-shape" class="space-y-4">
          <div>
            <h2 class="text-base font-semibold text-ink-strong">Shape &amp; Density</h2>
            <p class="text-sm text-ink-muted">
              Current shared shapes. Unresolved control differences are listed under Components.
            </p>
          </div>
          <div class="grid gap-3 sm:grid-cols-3">
            <div class="rounded-lg border border-line bg-surface p-4">
              <div class="mb-3 h-9 rounded-lg border border-line bg-surface shadow-xs"></div>
              <p class="text-sm font-medium text-ink">Standard field</p>
              <p class="text-xs text-ink-muted">Comfortable form entry</p>
            </div>
            <div class="rounded-lg border border-line bg-surface p-4">
              <div class="mb-3 h-7 rounded-md border border-line bg-surface"></div>
              <p class="text-sm font-medium text-ink">Compact control</p>
              <p class="text-xs text-ink-muted">Dense navigation and tables</p>
            </div>
            <div class="rounded-xl border border-line bg-surface p-4 shadow-xs">
              <div class="mb-3 h-7 rounded-lg bg-surface-sunken"></div>
              <p class="text-sm font-medium text-ink">Grouped surface</p>
              <p class="text-xs text-ink-muted">Related work stays together</p>
            </div>
          </div>
        </section>
      </section>
    <% end %>

    <%= if @area == :components do %>
      <section
        id="components"
        class="grid items-start gap-6 sm:grid-cols-[13rem_minmax(0,1fr)]"
      >
        <aside
          id="component-secondary-menu"
          class="rounded-xl border border-line bg-surface-muted p-2 shadow-xs sm:sticky sm:top-4 sm:max-h-[calc(100svh-8rem)] sm:overflow-y-auto"
        >
          <nav aria-label="Component families" class="space-y-0.5">
            <.link
              id="component-menu-foundations"
              navigate={~p"/system/design-library"}
              class="group flex items-start gap-2 rounded-md px-2 py-1.5 text-link hover:bg-surface hover:text-ink focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-brand-strong/40"
            >
              <.icon
                name="hero-swatch"
                class="mt-0.5 size-4 shrink-0 text-muted group-hover:text-brand-strong"
              />
              <span>
                <span class="block text-[0.8125rem] leading-5">A Foundations</span>
                <span class="block text-xs leading-4 text-ink-muted">Colour, type, density and shape, on the Theme page</span>
              </span>
            </.link>
            <div class="space-y-0.5">
              <a
                id="component-menu-page-structure"
                href="#component-page-structure"
                class="group flex items-start gap-2 rounded-md px-2 py-1.5 text-link hover:bg-surface hover:text-ink focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-brand-strong/40"
              >
                <.icon
                  name="hero-rectangle-group"
                  class="mt-0.5 size-4 shrink-0 text-muted group-hover:text-brand-strong"
                />
                <span>
                  <span class="block text-[0.8125rem] leading-5">B Page structure</span>
                  <span class="block text-xs leading-4 text-ink-muted">Application shell, page widths and headers</span>
                </span>
              </a>
              <a
                id="component-menu-shell"
                href="#component-shell"
                class="ml-8 block rounded-md px-2 py-1 text-xs leading-4 text-link hover:bg-surface hover:text-ink focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-brand-strong/40"
              >Application shell</a>
            </div>
            <a
              id="component-menu-navigation-links"
              href="#component-navigation-links"
              class="group flex items-start gap-2 rounded-md px-2 py-1.5 text-link hover:bg-surface hover:text-ink focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-brand-strong/40"
            >
              <.icon
                name="hero-bars-3"
                class="mt-0.5 size-4 shrink-0 text-muted group-hover:text-brand-strong"
              />
              <span>
                <span class="block text-[0.8125rem] leading-5">C Navigation and links</span>
                <span class="block text-xs leading-4 text-ink-muted">
                  Sidebar rows, tabs and the back link
                </span>
              </span>
            </a>
            <a
              id="component-menu-actions"
              href="#component-actions"
              class="group flex items-start gap-2 rounded-md px-2 py-1.5 text-link hover:bg-surface hover:text-ink focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-brand-strong/40"
            >
              <.icon
                name="hero-cursor-arrow-rays"
                class="mt-0.5 size-4 shrink-0 text-muted group-hover:text-brand-strong"
              />
              <span>
                <span class="block text-[0.8125rem] leading-5">D Actions</span>
                <span class="block text-xs leading-4 text-ink-muted">Buttons and compact actions</span>
              </span>
            </a>
            <a
              id="component-menu-inputs"
              href="#component-inputs"
              class="group flex items-start gap-2 rounded-md px-2 py-1.5 text-link hover:bg-surface hover:text-ink focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-brand-strong/40"
            >
              <.icon
                name="hero-pencil-square"
                class="mt-0.5 size-4 shrink-0 text-muted group-hover:text-brand-strong"
              />
              <span>
                <span class="block text-[0.8125rem] leading-5">E Inputs</span>
                <span class="block text-xs leading-4 text-ink-muted">Text, choices, time and validation</span>
              </span>
            </a>
            <a
              id="component-menu-interaction-patterns"
              href="#component-interaction-patterns"
              class="group flex items-start gap-2 rounded-md px-2 py-1.5 text-link hover:bg-surface hover:text-ink focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-brand-strong/40"
            >
              <.icon
                name="hero-arrow-path-rounded-square"
                class="mt-0.5 size-4 shrink-0 text-muted group-hover:text-brand-strong"
              />
              <span>
                <span class="block text-[0.8125rem] leading-5">F Interaction patterns</span>
                <span class="block text-xs leading-4 text-ink-muted">Inline editing</span>
              </span>
            </a>
            <a
              id="component-menu-feedback-states"
              href="#component-feedback-states"
              class="group flex items-start gap-2 rounded-md px-2 py-1.5 text-link hover:bg-surface hover:text-ink focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-brand-strong/40"
            >
              <.icon
                name="hero-chat-bubble-bottom-center-text"
                class="mt-0.5 size-4 shrink-0 text-muted group-hover:text-brand-strong"
              />
              <span>
                <span class="block text-[0.8125rem] leading-5">G Feedback and states</span>
                <span class="block text-xs leading-4 text-ink-muted">Alerts, status, empty, blocked and interrupted</span>
              </span>
            </a>
            <a
              id="component-menu-overlays"
              href="#component-overlays"
              class="group flex items-start gap-2 rounded-md px-2 py-1.5 text-link hover:bg-surface hover:text-ink focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-brand-strong/40"
            >
              <.icon
                name="hero-square-2-stack"
                class="mt-0.5 size-4 shrink-0 text-muted group-hover:text-brand-strong"
              />
              <span>
                <span class="block text-[0.8125rem] leading-5">H Overlays</span>
                <span class="block text-xs leading-4 text-ink-muted">
                  The modal dialog and its confirmation
                </span>
              </span>
            </a>
            <a
              id="component-menu-data-display"
              href="#component-data-display"
              class="group flex items-start gap-2 rounded-md px-2 py-1.5 text-link hover:bg-surface hover:text-ink focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-brand-strong/40"
            >
              <.icon
                name="hero-table-cells"
                class="mt-0.5 size-4 shrink-0 text-muted group-hover:text-brand-strong"
              />
              <span>
                <span class="block text-[0.8125rem] leading-5">I Data display</span>
                <span class="block text-xs leading-4 text-ink-muted">Tables, cards, facts, badges and dates</span>
              </span>
            </a>
            <a
              id="component-menu-composite-patterns"
              href="#component-composite-patterns"
              class="group flex items-start gap-2 rounded-md px-2 py-1.5 text-link hover:bg-surface hover:text-ink focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-brand-strong/40"
            >
              <.icon
                name="hero-squares-2x2"
                class="mt-0.5 size-4 shrink-0 text-muted group-hover:text-brand-strong"
              />
              <span>
                <span class="block text-[0.8125rem] leading-5">J Composite patterns</span>
                <span class="block text-xs leading-4 text-ink-muted">The operational index page, end to end</span>
              </span>
            </a>
            <.link
              id="component-menu-graphics"
              navigate={~p"/system/design-library/graphic"}
              class="group flex items-start gap-2 rounded-md px-2 py-1.5 text-link hover:bg-surface hover:text-ink focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-brand-strong/40"
            >
              <.icon
                name="hero-photo"
                class="mt-0.5 size-4 shrink-0 text-muted group-hover:text-brand-strong"
              />
              <span>
                <span class="block text-[0.8125rem] leading-5">K Graphics</span>
                <span class="block text-xs leading-4 text-ink-muted">Mark and icons, on the Graphic page</span>
              </span>
            </.link>
          </nav>
        </aside>

        <div id="component-content" class="min-w-0 space-y-9">
          <section id="component-page-structure" class="scroll-mt-4 space-y-4">
            <div>
              <h2 class="text-base font-semibold text-ink-strong">
                Page structure
              </h2>
              <p class="text-sm text-ink-muted">
                The application shell, the page widths a workflow may use, and the page header. The authentication shell, the page-local side panel and complete index, form and detail assemblies have no specimen yet.
              </p>
            </div>
            <section id="component-shell" class="scroll-mt-4 space-y-3">
              <h3 class="text-base font-semibold text-ink">
                Application shell
              </h3>
              <p class="text-sm text-muted">
                Your account stays at the bottom left. Open it for company, tenant, the platform-operator marker and account actions. Viewing as another user stays visible above the workspace until you stop.
              </p>
              <div class="rounded-xl border border-line bg-surface p-4">
                <h4 class="text-sm font-semibold">Display controls</h4>
                <p class="mt-1 text-xs text-muted">
                  The clock and theme controls live in the top bar of this page. They change your own saved display preferences. The timestamp below is an ordinary &lt;.datetime&gt; with no special wiring, and it changes the moment you change the clock — as does every other &lt;.datetime&gt; already on screen, including rows of a long table you have already scrolled through. A screen that formats its own instants instead keeps the text it rendered until it adopts the component.
                </p>
                <p class="mt-3 text-sm">
                  <.datetime id="library-shell-time" value={~U[2026-09-14 07:00:00Z]} />
                </p>
              </div>
              <div class="rounded-xl border border-line bg-surface p-4">
                <h4 class="text-sm font-semibold">Account disclosure</h4>
                <p class="mt-1 text-xs text-muted">
                  The accepted disclosure is the circle at the bottom left of this page. Open it for your name, identifier, company, tenant, Change password and Sign out. When the tenant is the platform operator, a caution row labelled Platform-operator sits below Tenant: it names the company's status, not your own entitlement, so an account in that company may still be refused operator-only screens. Every authenticated screen shows the same circle in the same place.
                </p>
              </div>
              <p class="text-xs text-muted">
                Use the top-left toggle to compare the full sidebar and compact rail. On a narrow screen it opens a drawer; Escape closes the active menu first, then the drawer.
              </p>
            </section>
            <.card id="component-page" title="Page widths" inner_class="space-y-2 p-4">
              <div id="design-library-page-stage" class="overflow-x-auto">
                <div class="w-[1280px] space-y-3">
                  <.page
                    id="design-library-page-list"
                    variant={:list}
                    class="rounded-md border border-dashed border-line p-2"
                  >
                    <p class="text-xs text-ink-muted">
                      List — wide for filters and tables
                    </p>
                  </.page>
                  <.page
                    id="design-library-page-detail"
                    variant={:detail}
                    class="rounded-md border border-dashed border-line p-2"
                  >
                    <p class="text-xs text-ink-muted">
                      Detail — the list width, for a record or dashboard
                    </p>
                  </.page>
                  <.page
                    id="design-library-page-form"
                    variant={:form}
                    class="rounded-md border border-dashed border-line p-2"
                  >
                    <p class="text-xs text-ink-muted">
                      Form — narrow for focused entry
                    </p>
                  </.page>
                </div>
              </div>
              <p class="text-xs text-ink-muted">
                Each variant is centered on a 1280px stage at full scale; scroll to follow the widest.
              </p>
            </.card>
            <.card id="component-header" title="Page header" inner_class="space-y-5 p-4">
              <div id="design-library-header-default">
                <p class="mb-2 text-xs text-ink-muted">Title, subtitle, and trailing action</p>
                <.header>
                  Company settings<:subtitle>Manage identity and regional defaults.</:subtitle><:actions>
                    <.button variant="primary">Save changes</.button>
                  </:actions>
                </.header>
              </div>
              <div id="design-library-header-title-action" class="border-t border-line pt-4">
                <p class="mb-2 text-xs text-ink-muted">
                  Title action without a trailing action
                </p>
                <.header>
                  Company details<:title_actions>
                    <.icon_button icon="edit" label="Edit company" context={:inline} />
                  </:title_actions>
                </.header>
              </div>
            </.card>
            <.card
              id="component-section-heading"
              title="Section heading"
              inner_class="space-y-5 p-4"
            >
              <div>
                <p class="mb-2 text-xs text-ink-muted">Title alone</p>
                <.section_heading title="Company Details" class="mb-0" />
              </div>
              <div class="border-t border-line pt-4">
                <p class="mb-2 text-xs text-ink-muted">
                  Count, title action, description and trailing action
                </p>
                <.section_heading title="Geographic Location" count={4} class="mb-0">
                  <:title_actions>
                    <.icon_button icon="edit" label="Edit location" context={:inline} />
                  </:title_actions>
                  <:description>
                    Country, division, postcode and locality depend on one another, so they are applied together.
                  </:description>
                  <:actions>
                    <.action_link
                      id="design-library-section-heading-manage"
                      icon="manage"
                      navigate={~p"/system/design-library"}
                      title="Manage this section's records"
                    >
                      Manage
                    </.action_link>
                  </:actions>
                </.section_heading>
              </div>
              <div class="border-t border-line pt-3">
                <p class="text-xs text-ink-muted">
                  The row every section of a detail page opens with, inside its card: the small-caps title, an optional count, and the same two action slots as the page header. It has no loading, empty or error state; the section body carries those.
                </p>
              </div>
            </.card>
            <.card
              id="component-inline-choice"
              title="Inline choice fact"
              inner_class="space-y-4 p-4"
            >
              <p class="text-xs text-ink-muted">
                The read state is the trigger. Choose a value to commit, or press Escape or leave the control to cancel.
              </p>
              <div class="grid gap-4 sm:grid-cols-3">
                <div>
                  <p class="mb-2 text-xs text-ink-muted">Read state</p>
                  <.inline_choice
                    id="design-library-inline-choice-read"
                    field="status"
                    label="Edit status"
                    editing={false}
                    editable?
                    status={nil}
                  >
                    <:display><span class="text-ink">Active</span></:display>
                    <:display><span class="text-xs text-ink-muted">since March</span></:display>
                    <:editor>
                      <.input
                        type="select"
                        id="design-library-inline-choice-read-select"
                        name="status"
                        value="Active"
                        options={["Active"]}
                        aria-label="Status"
                        wrapper_class="mb-0"
                      />
                    </:editor>
                  </.inline_choice>
                </div>
                <div>
                  <p class="mb-2 text-xs text-ink-muted">Editing and cancel</p>
                  <.inline_choice
                    id="design-library-inline-choice-edit"
                    field="status"
                    label="Edit status"
                    editing
                    editable?
                    status={nil}
                  >
                    <:display><span class="text-ink">Active</span></:display>
                    <:editor>
                      <.input
                        type="select"
                        id="design-library-inline-choice-edit-select"
                        name="status"
                        value="Active"
                        options={["Active", "Pending"]}
                        aria-label="Status"
                        phx-blur="cancel_edit_field"
                        wrapper_class="mb-0"
                      />
                    </:editor>
                    <:editor>
                      <span class="text-xs text-ink-muted">Saves on selection.</span>
                    </:editor>
                  </.inline_choice>
                </div>
                <div>
                  <p class="mb-2 text-xs text-ink-muted">Commit refused</p>
                  <.inline_choice
                    id="design-library-inline-choice-error"
                    field="status"
                    label="Edit status"
                    editing={false}
                    editable?
                    status={{:error, "Pending is not allowed."}}
                    status_id="design-library-inline-choice-error-message"
                  >
                    <:display><span class="text-ink">Active</span></:display>
                    <:editor>
                      <.input
                        type="select"
                        id="design-library-inline-choice-error-select"
                        name="status"
                        value="Active"
                        options={["Active"]}
                        aria-label="Status"
                        wrapper_class="mb-0"
                      />
                    </:editor>
                  </.inline_choice>
                </div>
              </div>
            </.card>
          </section>

          <section id="component-navigation-links" class="scroll-mt-4 space-y-4">
            <div>
              <h2 class="text-base font-semibold text-ink-strong">
                Navigation and links
              </h2>
              <p class="text-sm text-ink-muted">
                The shell's own navigation rows, the shared tabs and the demoted secondary actions: the back link and the action link. Pagination is shown with the table it pages, under Data display. Those two links are the shared link dictionary so far, and the account menu is part of the application shell above.
              </p>
            </div>
            <div class="grid gap-3 lg:grid-cols-2">
              <.card id="design-library-navigation" title="Navigation" inner_class="space-y-2 p-3">
                <Layouts.nav_menu
                  id="example-nav"
                  aria_label="Example menu"
                  nodes={@nav_example}
                  active_nav={@nav_example_active}
                  pinnable={false}
                  class="max-w-xs rounded-lg bg-surface-sidebar px-0.5 py-0.5"
                />
                <p class="text-xs text-ink-muted">
                  The shell's own menu, over an example tree: a leaf, an expanded
                  branch accented for the current page, and the selected child. Both rail
                  behaviours belong to the sidebar rather than to these rows. Pinning is
                  left out: the shell resolves a pinned row only from the sidebar, and
                  draws pinned rows there with its hook rather than with a component. The
                  branch toggle renders but does not collapse here: the shell listens for
                  it only inside the sidebar.
                </p>
              </.card>
              <.card id="component-tabs" title="Tabs" inner_class="p-3">
                <.tabs id="example-tabs" aria-label="Example views">
                  <:tab href="#component-tabs" current={true}>Overview</:tab>
                  <:tab href="#component-tabs">History</:tab>
                  <:tab href="#component-tabs">Settings</:tab>
                </.tabs>
                <div id="design-library-tabs-single" class="border-t border-line pt-3">
                  <p class="mb-2 text-xs text-ink-muted">One section needs no switching</p>
                  <.tabs id="example-single-tab" aria-label="Example single view">
                    <:tab href="#component-tabs" current={true}>Overview</:tab>
                  </.tabs>
                </div>
              </.card>
              <.card id="component-back-link" title="Back link" inner_class="p-3">
                <p class="mb-2 text-xs text-ink-muted">
                  Returning is a secondary action, so it is a plain link, never a button. The text is always "← Back"; a title names the destination when the page has more than one way back.
                </p>
                <div class="flex flex-wrap items-center gap-6">
                  <.back_link id="design-library-back-link" navigate={~p"/system/design-library"} />
                  <.back_link
                    id="design-library-back-link-titled"
                    navigate={~p"/system/design-library"}
                    title="Back to Design Library"
                  />
                </div>
              </.card>
              <.card id="component-action-link" title="Action link" inner_class="p-3">
                <p class="mb-2 text-xs text-ink-muted">
                  Reaching a related workflow is a secondary action, so it is a plain link on the section it belongs to or beside the page's primary action, never a button. The glyph is the registry's name for the action, so Manage keeps the cog Belimbing uses, and the title names the destination the short text alone does not.
                </p>
                <div class="flex flex-wrap items-center gap-6">
                  <.action_link
                    id="design-library-action-link"
                    icon="manage"
                    navigate={~p"/system/design-library"}
                    title="Manage department types"
                  >
                    Department Types
                  </.action_link>
                  <.action_link
                    id="design-library-action-link-submit"
                    icon="bilimbi-impersonate"
                    href={~p"/system/design-library/components/specimen-request"}
                    method="post"
                    title="Try it: send a sample request that changes nothing"
                  >
                    Try it
                  </.action_link>
                </div>
                <p class="mt-2 text-xs text-ink-muted">
                  An action that sends a request rather than opening a page takes a destination and a method in place of a page to open, and keeps the same treatment, so Impersonate sits in a header row beside History and Back. This one sends a real request to the Design Library, which changes nothing and returns here.
                </p>
              </.card>
            </div>
          </section>

          <section id="component-actions" class="scroll-mt-4 space-y-4">
            <div>
              <h2 id="component-button" class="text-base font-semibold text-ink-strong">
                Actions
              </h2><p class="text-sm text-ink-muted">
                Primary, secondary, destructive, disabled, navigation, in-flight, and busy examples. Consequence copy is the confirmation dialog under Overlays; typed acknowledgement is not built.
              </p>
            </div>
            <div class="flex flex-wrap items-center gap-3 rounded-xl border border-line bg-surface p-4 shadow-xs">
              <.button>Secondary</.button><.button variant="primary">Primary</.button><.button variant="danger">Danger</.button><.button disabled>Disabled</.button><.button navigate={
                ~p"/system/design-library"
              }>Navigation</.button><.button
                phx-click="test_click"
                variant="primary"
                phx-disable-with="Working…"
              >Clicked: {@click_count}</.button><.button variant="primary" busy>Saving…</.button>
            </div>
            <p class="text-xs text-ink-muted">
              Clicked goes in flight for one round trip: LiveView disables it and shows "Working…" until the server replies, and the shell mirrors that wait onto <code>aria-busy</code>; it is announced but still wears the dimmed disabled look. Busy is the wait the server knows about, such as a sign-in that is opening the workspace: the control spins at full strength, is disabled and carries <code>aria-busy</code>. Disabled means the action is not available at all, so it dims and never spins.
            </p>
            <.card id="component-icon-button" title="Compact icon actions" inner_class="p-4">
              <div class="flex flex-wrap items-center gap-4">
                <div class="flex items-center gap-2 text-sm text-ink-muted">
                  Inline
                  <.icon_button
                    icon="bilimbi-pin"
                    label="Pin Design Library"
                    context={:inline}
                  />
                </div>
                <div class="flex items-center gap-2 text-sm text-ink-muted">
                  Table <.icon_button icon="edit" label="Edit company" />
                  <.icon_button icon="delete" label="Delete company" kind={:danger} />
                </div>
                <div class="flex items-center gap-2 text-sm text-ink-muted">
                  Disabled
                  <.icon_button
                    id="design-library-icon-button-disabled"
                    icon="bilimbi-impersonate"
                    label="Impersonate user"
                    disabled
                  />
                </div>
                <div class="flex items-center gap-2 text-sm text-ink-muted">
                  Busy
                  <.icon_button
                    id="design-library-icon-button-busy"
                    icon="export"
                    label="Export companies"
                    busy
                  />
                </div>
              </div>
              <p class="mt-3 text-xs text-ink-muted">
                Use icon-only controls for familiar repeated actions. Keep primary and unfamiliar actions as words. Disabled and busy are both inert, and they do not look alike: disabled dims the glyph, busy sits in a sunken ringed well and replaces the glyph with a spinner at full strength, and carries <code>aria-busy</code>. The well and the swapped glyph are static, so the difference survives <code>prefers-reduced-motion</code>, where the spin does not render. The label still names the action that is pending — the export above reads "Export companies" while it waits.
                <code>phx-disable-with</code>
                does not belong here: it replaces the control's text, which on an icon-only action deletes the glyph.
              </p>
            </.card>
          </section>

          <section id="component-inputs" class="scroll-mt-4 space-y-4">
            <div>
              <h2 class="text-base font-semibold text-ink-strong">
                Inputs
              </h2>
              <p class="text-sm text-ink-muted">
                Choose the simplest control that fits the value, then review it in use. The searchable combobox, the country and currency lookup and the segmented control have no specimen yet.
              </p>
            </div>

            <.card id="design-library-input-guidance" title="Choice guidance" inner_class="p-4">
              <div class="grid gap-3 sm:grid-cols-2 xl:grid-cols-3">
                <div class="rounded-lg border border-line bg-canvas p-3">
                  <h3 class="text-sm font-semibold text-ink">Text</h3>
                  <p class="mt-1 text-xs text-ink-muted">
                    Use for a short value that is genuinely open-ended.
                  </p>
                </div>
                <div class="rounded-lg border border-line bg-canvas p-3">
                  <h3 class="text-sm font-semibold text-ink">Select</h3>
                  <p class="mt-1 text-xs text-ink-muted">
                    Use for one choice from a short, stable list.
                  </p>
                </div>
                <div class="rounded-lg border border-line bg-canvas p-3">
                  <h3 class="text-sm font-semibold text-ink">Multi-select</h3>
                  <p class="mt-1 text-xs text-ink-muted">
                    Use when several listed choices may apply together.
                  </p>
                </div>
                <div class="rounded-lg border border-line bg-canvas p-3">
                  <h3 class="text-sm font-semibold text-ink">Checkbox</h3>
                  <p class="mt-1 text-xs text-ink-muted">
                    Use for one independent on-or-off setting.
                  </p>
                </div>
                <div class="rounded-lg border border-line bg-canvas p-3">
                  <h3 class="text-sm font-semibold text-ink">Radio group</h3>
                  <p class="mt-1 text-xs text-ink-muted">
                    Use for two to five exclusive choices that should stay visible.
                  </p>
                </div>
                <div class="rounded-lg border border-line bg-canvas p-3">
                  <h3 class="text-sm font-semibold text-ink">Date and time</h3>
                  <p class="mt-1 text-xs text-ink-muted">
                    Use native calendar and time controls when precision matters.
                  </p>
                </div>
              </div>
            </.card>

            <.form
              for={@sample_form}
              id="design-library-fields"
              phx-change="sample_change"
              class="grid gap-3 lg:grid-cols-2"
            >
              <.card title="Text and long-form inputs" inner_class="p-4">
                <.input
                  field={@sample_form[:text_field]}
                  label="Text"
                  placeholder="Enter a value"
                />
                <.input
                  field={@sample_form[:search_field]}
                  type="search"
                  label="Search"
                  placeholder="Search…"
                  phx-debounce="150"
                />
                <.input field={@sample_form[:email_field]} type="email" label="Email" />
                <div class="grid gap-x-3 sm:grid-cols-2">
                  <.input field={@sample_form[:tel_field]} type="tel" label="Telephone" />
                  <.input field={@sample_form[:number_field]} type="number" label="Number" />
                </div>
                <.input field={@sample_form[:url_field]} type="url" label="URL" />
                <.input
                  field={@sample_form[:textarea_field]}
                  type="textarea"
                  label="Textarea"
                  wrapper_class="mb-0"
                />
              </.card>

              <.card title="Choice controls" inner_class="p-4">
                <.input
                  field={@sample_form[:select_field]}
                  type="select"
                  label="Select"
                  options={[{"Standard", "standard"}, {"Advanced", "advanced"}]}
                />
                <.multi_select
                  field={@sample_form[:roles]}
                  id="design-library-multi-select"
                  label="Multi-select"
                  options={[
                    {"Administrator", "admin"},
                    {"Operator", "operator"},
                    {"Reviewer", "reviewer"}
                  ]}
                  selection_label=":count role selected|:count roles selected"
                />
                <.input
                  field={@sample_form[:checkbox_field]}
                  type="checkbox"
                  label="Enable synchronization"
                />
                <.radio_group
                  field={@sample_form[:radio_field]}
                  id="component-radio-group"
                  label="Appearance"
                  options={[
                    {"System", "system"},
                    {"Light", "light"},
                    {"Dark", "dark"}
                  ]}
                  wrapper_class="mb-1.5"
                />
                <p id="design-library-radio-group-gap" class="text-xs text-ink-muted">
                  Appearance Settings still hand-writes its own radios. That screen puts
                  each theme choice in a bordered card with a description, which this
                  component does not express, so it is the one screen this entry does not
                  describe.
                </p>
              </.card>

              <.card id="component-multi-select" title="Multi-select" inner_class="p-4">
                <p class="mb-2 text-xs text-ink-muted">Required, with helper text</p>
                <.multi_select
                  field={@sample_form[:required_roles]}
                  id="design-library-multi-select-required"
                  label="Roles"
                  hint="Everyone needs at least one role."
                  required
                  options={[
                    {"Administrator", "admin"},
                    {"Operator", "operator"},
                    {"Reviewer", "reviewer"}
                  ]}
                  selection_label=":count role selected|:count roles selected"
                />
                <div class="border-t border-line pt-3">
                  <p class="mb-2 text-xs text-ink-muted">Optional, on its own</p>
                  <.multi_select
                    field={@sample_form[:plain_roles]}
                    id="design-library-multi-select-plain"
                    aria-label="Optional roles"
                    options={[
                      {"Administrator", "admin"},
                      {"Operator", "operator"},
                      {"Reviewer", "reviewer"}
                    ]}
                    wrapper_class="mb-0"
                  />
                </div>
              </.card>

              <.card id="component-radio-group-states" title="Data region" inner_class="p-4">
                <.radio_group
                  id="design-library-radio-locked"
                  name="locked_region"
                  aria-label="Data region"
                  value="sg"
                  disabled
                  hint="Your organization set this for everyone."
                  options={[{"Singapore", "sg"}, {"Malaysia", "my"}]}
                  wrapper_class="mb-0"
                />
                <p class="mt-3 border-t border-line pt-3 text-xs text-ink-muted">
                  Locked, so every choice is inert. The card heading names the group on
                  screen and an <code>aria-label</code> names it for assistive tech, so it
                  passes no label of its own, and the hint says who decided.
                </p>
              </.card>

              <.card title="Date, time, and secret inputs" inner_class="p-4">
                <div class="grid gap-x-3 sm:grid-cols-2">
                  <.input field={@sample_form[:date_field]} type="date" label="Date" />
                  <.input field={@sample_form[:time_field]} type="time" label="Time" />
                  <.input
                    field={@sample_form[:datetime_field]}
                    type="datetime-local"
                    label="Date and time"
                  />
                  <.input field={@sample_form[:month_field]} type="month" label="Month" />
                  <.input field={@sample_form[:week_field]} type="week" label="Week" />
                </div>
                <.input
                  field={@sample_form[:password_field]}
                  type="password"
                  label="Secret"
                  autocomplete="new-password"
                />
                <.input
                  field={@sample_form[:api_key_field]}
                  type="password"
                  label="API key"
                  reveal="API key"
                  autocomplete="off"
                  wrapper_class="mb-0"
                  hint="Reveal is a caller option. Sign-in keeps its password masked; a key a user copies from elsewhere earns the control."
                />
              </.card>

              <.card id="design-library-input-live-state" title="Live state" inner_class="px-4">
                <.list>
                  <:item title="Text">
                    <span class="block truncate">{@sample_form[:text_field].value}</span>
                  </:item>
                  <:item title="Search">
                    <span class="block truncate">{@sample_form[:search_field].value}</span>
                  </:item>
                  <:item title="Select">{@sample_form[:select_field].value}</:item>
                  <:item title="Multi-select">
                    {Enum.join(List.wrap(@sample_form[:roles].value), ", ")}
                  </:item>
                  <:item title="Checkbox">{@sample_form[:checkbox_field].value}</:item>
                  <:item title="Radio">{@sample_form[:radio_field].value}</:item>
                  <:item title="Date and time">
                    <span class="tabular-nums">{@sample_form[:datetime_field].value}</span>
                  </:item>
                </.list>
              </.card>

              <.card
                id="component-input-states"
                title="Help, error, and locked states"
                inner_class="p-4 lg:col-span-2"
                class="lg:col-span-2"
              >
                <div class="grid gap-x-3 sm:grid-cols-3">
                  <.input
                    name="field-with-help"
                    label="Company code"
                    value="acme"
                    hint="Used in URLs and exports."
                  />
                  <.input
                    field={@error_form[:invalid_text]}
                    label="Required value"
                    placeholder="Enter a value"
                  />
                  <.input
                    name="disabled-field"
                    label="System value"
                    value="Managed by Bilimbi"
                    disabled
                  />
                  <.input
                    name="required-field"
                    label="Company name"
                    value=""
                    placeholder="Enter a value"
                    required
                  />
                  <.input
                    name="readonly-field"
                    label="System identifier"
                    value="acme-0042"
                    readonly
                  />
                  <.input
                    name="field-with-help-and-error"
                    label="Tax ID"
                    value=""
                    hint="As printed on the certificate."
                    errors={["can't be blank"]}
                  />
                </div>
                <.radio_group
                  id="design-library-radio-disabled"
                  name="radio_disabled"
                  label="Locked appearance"
                  value="system"
                  disabled
                  options={[
                    {"System", "system"},
                    {"Light", "light"},
                    {"Dark", "dark"}
                  ]}
                  wrapper_class="mb-0 mt-4"
                />
              </.card>

              <.card
                id="component-input-variants"
                title="Select, multi-value, and search inputs"
                inner_class="p-4 lg:col-span-2"
                class="lg:col-span-2"
              >
                <div class="grid gap-x-3 sm:grid-cols-2 lg:grid-cols-4">
                  <.input
                    name="example_role"
                    type="select"
                    label="Role"
                    prompt="Select a role"
                    value=""
                    options={[{"Administrator", "admin"}, {"Operator", "operator"}]}
                  />
                  <.input
                    id="example_teams"
                    name="example_teams[]"
                    type="select"
                    label="Teams"
                    multiple
                    value={[]}
                    options={[
                      {"Platform", "platform"},
                      {"Billing", "billing"},
                      {"Support", "support"}
                    ]}
                  />
                  <.input
                    field={@sample_form[:example_interests]}
                    id="example_interests"
                    type="multi_select"
                    label="Interests"
                    selection_label=":count interest selected|:count interests selected"
                    options={[{"Platform", "platform"}, {"Billing", "billing"}]}
                  />
                  <.input
                    name="quick_search"
                    type="search"
                    aria-label="Quick search"
                    placeholder="Quick search…"
                    value=""
                  />
                </div>
                <p class="mt-3 border-t border-line pt-3 text-xs text-ink-muted">
                  A prompt names the empty choice, the native multiple select shows what
                  is chosen by highlighting its rows, the multi-select reports the count on
                  its trigger, and the search box takes an <code>aria-label</code> rather
                  than a visible one.
                </p>
              </.card>

              <.card
                id="component-combobox"
                title="Combobox"
                inner_class="p-4 lg:col-span-2"
                class="lg:col-span-2"
              >
                <p class="mb-3 text-xs text-ink-muted">
                  Type to filter, use the arrow keys to move, and press Enter to commit. Escape or
                  leaving the field restores the last committed choice. The unlabelled inline editor
                  also reports the cancel to its LiveView, as an inline field editor does.
                </p>
                <div class="grid gap-x-3 sm:grid-cols-3">
                  <.combobox
                    id="design-library-combobox-country"
                    name="example_country"
                    label="Country"
                    placeholder="Search countries…"
                    options={[
                      {"Malaysia (MY)", "MY"},
                      {"Singapore (SG)", "SG"},
                      {"Thailand (TH)", "TH"}
                    ]}
                  />
                  <.combobox
                    id="design-library-combobox-selected"
                    name="example_selected_country"
                    label="Selected country"
                    value="SG"
                    options={[
                      {"Malaysia (MY)", "MY"},
                      {"Singapore (SG)", "SG"},
                      {"Thailand (TH)", "TH"}
                    ]}
                  />
                  <.combobox
                    id="design-library-combobox-empty"
                    name="example_empty_country"
                    label="Unavailable country list"
                    placeholder="No countries"
                    options={[]}
                    errors={["Choose a country before continuing."]}
                  />
                  <.combobox
                    id="design-library-combobox-inline"
                    aria-label="Inline country editor"
                    value="MY"
                    cancel_event="preview-combobox-cancel"
                    options={[
                      {"Malaysia (MY)", "MY"},
                      {"Singapore (SG)", "SG"},
                      {"Thailand (TH)", "TH"}
                    ]}
                  />
                </div>
              </.card>
            </.form>
          </section>

          <section id="component-interaction-patterns" class="scroll-mt-4 space-y-4">
            <div>
              <h2 class="text-base font-semibold text-ink-strong">
                Interaction patterns
              </h2>
              <p class="text-sm text-ink-muted">
                Inline text editing is the shared interaction primitive today; the demoted back link is a link, so it sits under Navigation and links. Inline select, combobox and textarea editing, grouped fact editing, disclosure, filter and period patterns, and unsaved-change flows have no specimen yet; the filter composition is shown as part of the index page under Composite patterns.
              </p>
            </div>
            <.card id="component-inline-edit" title="Inline edit" inner_class="space-y-4 p-4">
              <div>
                <p class="mb-2 text-xs text-ink-muted">
                  Click the value, type, then press Enter or leave the field. Nothing is painted until the server replies: the field reads "Saving…" for the round trip, then reports the outcome on itself.
                </p><.inline_edit
                  id="design-library-inline-edit"
                  value={@inline_value}
                  save_event="preview-inline-edit"
                  label="Edit company name"
                />
              </div>
              <div class="grid gap-4 border-t border-line pt-4 sm:grid-cols-3">
                <div>
                  <p class="mb-2 text-xs text-ink-muted">Saved</p><.inline_edit
                    id="design-library-inline-edit-saved"
                    value="Bilimbi Industries"
                    save_event="preview-inline-edit"
                    label="Edit company name"
                    status={:saved}
                  />
                </div>
                <div>
                  <p class="mb-2 text-xs text-ink-muted">Adds rather than edits</p><.inline_edit
                    id="design-library-inline-edit-add"
                    value=""
                    save_event="preview-inline-edit"
                    label="Add business activity"
                    placeholder="Add activity"
                  />
                </div>
                <div>
                  <p class="mb-2 text-xs text-ink-muted">Refused, empty allowed</p><.inline_edit
                    id="design-library-inline-edit-error"
                    value=""
                    save_event="preview-inline-edit"
                    label="Edit phone"
                    allow_empty
                    status={
                      {:error, "\"+60 3\" was not saved: Phone should be at most 3 character(s)."}
                    }
                  />
                </div>
              </div>
            </.card>
          </section>

          <section id="component-feedback-states" class="scroll-mt-4 space-y-4">
            <div>
              <h2 class="text-base font-semibold text-ink-strong">
                Feedback and states
              </h2>
              <p class="text-sm text-ink-muted">
                Short-lived messages, inline guidance, and the empty, blocked and interrupted states. These states are part of the product, not exceptions to its design. Validation, disabled and in-flight states are shown with the controls that have them, under Inputs and Actions.
              </p>
            </div>
            <div id="component-flash" class="space-y-3">
              <p class="text-sm text-ink-muted">
                One message per severity. The layout's flash group is the single production outlet: it stacks messages in one column at the top right, most severe first, so several stay readable at once. Info, warning and error stay until dismissed, because a message someone must act on must not disappear on a timer. Only a success times out, after eight seconds: every completed write reports one, and info is for a message that informs without confirming a write. Each kind has a colour and an icon of its own, so the four can be told apart here side by side; info is blue, as in Belimbing, and never reads as a success. Success and info are announced politely as a status; warning and error interrupt as an alert.
              </p>
              <div class="flex w-[min(24rem,calc(100vw-2rem))] flex-col gap-2">
                <.flash
                  id="design-library-flash-error"
                  kind={:error}
                  flash={%{"error" => "The changes could not be saved."}}
                  title="Save failed"
                />
                <.flash
                  id="design-library-flash-warning"
                  kind={:warning}
                  flash={%{"warning" => "Two employees still report to the archived department."}}
                  title="Review before continuing"
                />
                <.flash
                  id="design-library-flash-success"
                  kind={:success}
                  flash={%{"success" => "Your changes were saved."}}
                  title="Saved"
                />
                <.flash id="design-library-flash-info" kind={:info}>
                  This change affects future records only.
                </.flash>
              </div>
              <p class="text-xs text-ink-muted">
                Deliberately outside this contract: the shell's preference status line under the top bar. It reports the in-flight and settled state of the clock and theme controls in place, written by the shell's own client hook before the server answers, so "Saving…" can show at once and a failure stays beside the control it belongs to. A flash is a server fact rendered after the round trip and cannot do that, so the status line is not folded into this outlet and this outlet does not report preference saves.
              </p>
            </div>
            <div id="component-commit-status" class="space-y-2">
              <p class="text-xs text-ink-muted">
                The outcome of one in-place commit, reported beside the fact that made it rather
                than in a flash. Every write that saves by itself — an inline edit, a choice that
                commits on change, a group with one Apply — speaks in this one voice: "Saved" for
                the most recent commit, and a refusal that names the rejected value and stays on
                its fact until that fact is committed again.
              </p>
              <div class="grid gap-3 lg:grid-cols-2">
                <.card title="Stored" inner_class="p-4">
                  <.commit_status id="design-library-commit-status-saved" status={:saved} />
                </.card>
                <.card title="Refused" inner_class="p-4">
                  <.commit_status
                    id="design-library-commit-status-error"
                    status={
                      {:error, "\"+60 3\" was not saved: Phone should be at most 3 character(s)."}
                    }
                  />
                </.card>
              </div>
            </div>
            <div id="component-alert" class="grid gap-2 lg:grid-cols-2">
              <.alert kind={:info}>This change affects future records.</.alert><.alert kind={
                :success
              }>
                The company was created.
              </.alert><.alert kind={:warning}>
                Review the missing address before continuing.
              </.alert><.alert kind={:error}>The record could not be saved.</.alert>
            </div>
            <div id="component-panel-notice" class="space-y-2">
              <p class="text-xs text-ink-muted">
                What the last action on a panel did, reported above the panel's table or inside
                its open dialog: a LiveComponent cannot reach the page's flash, and a message
                raised behind an open dialog could be neither read nor dismissed. The kinds follow
                the flash's rule for what a message does, not how it is worded: a completed write
                says success and reads as the success flash at inline strength, a plain statement
                is info and reads as the info flash, and a refusal is an error that interrupts.
                Dismiss clears it.
              </p>
              <div class="grid gap-2 lg:grid-cols-2">
                <.panel_notice
                  id="design-library-panel-notice-success"
                  kind={:success}
                  on_dismiss={JS.hide(to: "#design-library-panel-notice-success")}
                >
                  Address attached.
                </.panel_notice>
                <.panel_notice
                  id="design-library-panel-notice-info"
                  kind={:info}
                  on_dismiss={JS.hide(to: "#design-library-panel-notice-info")}
                >
                  Nothing changed: the address already had those kinds.
                </.panel_notice>
                <.panel_notice
                  id="design-library-panel-notice-error"
                  kind={:error}
                  on_dismiss={JS.hide(to: "#design-library-panel-notice-error")}
                >
                  The address was not unlinked. Try again.
                </.panel_notice>
              </div>
            </div>
            <div id="component-empty-state" class="space-y-2">
              <p class="text-xs text-ink-muted">
                An empty region says what is missing, why, and how to recover. Nothing yet, nothing
                matched, and not permitted are three different sentences; the permission wording is
                one sentence owned by the component. A table reaches the same pattern through its
                empty slot.
              </p>
              <div class="grid gap-3 lg:grid-cols-3">
                <.card title="Nothing yet" inner_class="p-4">
                  <.empty_state
                    id="design-library-empty-new"
                    title="No companies yet"
                    reason="Companies created in this tenant appear here."
                  >
                    <:action>
                      <.button variant="primary">Add Company</.button>
                    </:action>
                  </.empty_state>
                </.card>
                <.card title="Nothing matched" inner_class="p-4">
                  <.empty_state
                    id="design-library-empty-filtered"
                    title="No companies match “acme”"
                    reason="Check the spelling, or clear the search to see every company in this tenant."
                  >
                    <:action>
                      <.button>Clear search</.button>
                    </:action>
                  </.empty_state>
                </.card>
                <.card title="Not permitted" inner_class="p-4">
                  <.empty_state id="design-library-empty-forbidden" forbidden="view companies" />
                </.card>
              </div>
              <.table id="design-library-empty-table" rows={[]} caption="Example empty table">
                <:col :let={row} label="Company">{row.name}</:col>
                <:col :let={row} label="Status">{row.status}</:col>
                <:empty
                  title="No suspended companies"
                  reason="No company in this tenant has this status. Show all statuses to see every company."
                >
                  <.button>Show all statuses</.button>
                </:empty>
              </.table>
            </div>
            <div id="component-connection-banners" class="space-y-2">
              <p class="text-xs text-ink-muted">
                The two banners the client reveals by itself when the websocket drops: "Connection
                interrupted" while the browser cannot reach the server, "Server unavailable" when
                the server refused or lost the view. Shown here already revealed and bound to no
                connection event, so a real drop is still reported once, by the layout's own pair
                at the top right, or by an open dialog's.
              </p>
              <div class="grid gap-3 lg:grid-cols-2">
                <.connection_banners id="design-library-connection" revealed={:client} />
                <.connection_banners id="design-library-connection" revealed={:server} />
              </div>
            </div>
          </section>

          <section id="component-overlays" class="scroll-mt-4 space-y-4">
            <div>
              <h2 class="text-base font-semibold text-ink-strong">
                Overlays
              </h2>
              <p class="text-sm text-ink-muted">
                The shared modal dialog and the confirmation built on it are the overlays Bilimbi has. The inspector drawer and the tooltip and popover contract have no specimen yet; the family stays in this menu so those gaps are visible rather than missing.
              </p>
            </div>
            <.card id="component-modal" title="Modal dialog" inner_class="space-y-2 p-4">
              <p class="text-xs text-ink-muted">
                A short workflow over the current screen. Focus enters the dialog, the page
                behind is inert, and Escape or Cancel returns focus to the control that opened it.
                The open dialog carries its own connection banners, revealed above it rather than
                dimmed behind it if the connection drops.
              </p>
              <div class="flex flex-wrap gap-2">
                <.button id="design-library-open-modal" type="button" phx-click="open-modal">
                  Open dialog
                </.button>
                <.button
                  id="design-library-open-wide-modal"
                  type="button"
                  phx-click="open-modal"
                  phx-value-width="wide"
                >
                  Open wide dialog
                </.button>
              </div>
              <.modal
                :if={@modal_width == :narrow}
                id="design-library-modal"
                title="Rename example company"
                width={:narrow}
                on_cancel={JS.push("close-modal")}
              >
                <:description>Changes stay in this preview.</:description>
                <.form
                  for={@modal_form}
                  id="design-library-modal-form"
                  phx-submit="close-modal"
                  class="mt-4 space-y-4"
                >
                  <.input
                    field={@modal_form[:name]}
                    id="design-library-modal-name"
                    label="Company name"
                  />
                  <div class="flex justify-end gap-2">
                    <.button type="button" phx-click="close-modal">Cancel</.button>
                    <.button type="submit" variant="primary">Save</.button>
                  </div>
                </.form>
              </.modal>
              <.modal
                :if={@modal_width == :wide}
                id="design-library-wide-modal"
                title="Edit example company"
                width={:wide}
                on_cancel={JS.push("close-modal")}
              >
                <.form
                  for={@modal_form}
                  id="design-library-wide-modal-form"
                  phx-submit="close-modal"
                  class="mt-4 space-y-4"
                >
                  <div class="grid gap-4 sm:grid-cols-2">
                    <.input
                      field={@modal_form[:name]}
                      id="design-library-wide-modal-name"
                      label="Company name"
                    />
                    <.input
                      field={@modal_form[:code]}
                      id="design-library-wide-modal-code"
                      label="Code"
                    />
                  </div>
                  <div class="flex justify-end gap-2">
                    <.button type="button" phx-click="close-modal">Cancel</.button>
                    <.button type="submit" variant="primary">Save</.button>
                  </div>
                </.form>
              </.modal>
            </.card>
            <.card
              id="component-confirm-dialog"
              title="Confirmation dialog"
              inner_class="space-y-3 p-4"
            >
              <p class="text-xs text-ink-muted">
                An action that cannot be undone confirms here, never in the browser's own dialog. The dialog leads with the consequence: its title says what will happen to the data and its detail what is kept. It offers two actions and nothing else: Cancel, which takes focus when the dialog opens, and a calm danger confirm named by the verb alone. Nobody retypes a name. Escape and Cancel are one action, and focus returns to the control that opened the dialog.
              </p>
              <p class="text-xs text-ink-muted">
                Example legal entity types; changes stay in this preview. The first deletes; the second refuses because companies still use it, so the failure and the way out can be seen too. In production the outcome is the page's flash or the panel's notice; here it stays inside this card.
              </p>
              <div class="flex flex-wrap items-center gap-3">
                <.button
                  id="design-library-confirm-in-flight"
                  type="button"
                  variant="danger"
                  disabled
                  aria-busy="true"
                >
                  Deleting…
                </.button>
                <p class="text-xs text-ink-muted">
                  In flight, the confirm reads its working label for the round trip: LiveView disables it and swaps the verb until the server replies, and the shell mirrors that wait onto <code>aria-busy</code>.
                </p>
              </div>
              <.table
                id="design-library-confirm-rows"
                rows={@confirm_rows}
                row_id={&"design-library-confirm-row-#{&1.id}"}
                caption="Example legal entity types"
                framed={false}
              >
                <:col :let={row} label="Name">{row.name}</:col>
                <:action :let={row}>
                  <.icon_button
                    id={"design-library-confirm-delete-#{row.id}"}
                    icon="delete"
                    label={"Delete #{row.name}"}
                    kind={:danger}
                    phx-click="confirm-request"
                    phx-value-id={row.id}
                  />
                </:action>
                <:empty
                  :if={@confirm_rows == []}
                  title="No example legal entity types"
                  reason="Every example has been deleted. Restore the examples to walk the flow again."
                />
              </.table>
              <.alert
                :if={match?({:success, _}, @confirm_outcome)}
                id="design-library-confirm-outcome"
                kind={:success}
              >
                {elem(@confirm_outcome, 1)}
              </.alert>
              <.alert
                :if={match?({:error, _}, @confirm_outcome)}
                id="design-library-confirm-outcome"
                kind={:error}
              >
                {elem(@confirm_outcome, 1)}
              </.alert>
              <.button
                :if={@confirm_outcome || @confirm_rows == []}
                id="design-library-confirm-reset"
                type="button"
                phx-click="confirm-reset"
              >
                Restore examples
              </.button>
              <.confirm_dialog
                :if={@confirm_request}
                id="design-library-confirm"
                consequence={"Legal entity type “#{@confirm_request.name}” will be deleted."}
                detail="It can no longer be chosen for a company. This cannot be undone."
                confirm="Delete"
                working="Deleting…"
                on_confirm={JS.push("confirm-run")}
                on_cancel={JS.push("confirm-cancel")}
              />
            </.card>
          </section>

          <section id="component-data-display" class="scroll-mt-4 space-y-4">
            <div>
              <h2 class="text-base font-semibold text-ink-strong">
                Data display
              </h2>
              <p class="text-sm text-ink-muted">
                Tables and their pagination, cards, record facts, status badges, dates, and compact statistics. Record history has no specimen yet.
              </p>
            </div>
            <div class="space-y-2">
              <p class="text-xs text-ink-muted">
                Example companies; search, sort by any heading, and page below. Changes stay in this preview.
              </p>
              <.filter_toolbar
                id="design-library-table-search"
                form={@sample_filter_form}
                event="sample-search"
              >
                <:control
                  type={:search}
                  field={@sample_filter_form[:search]}
                  id="design-library-table-search-input"
                  label="Search the example company table"
                  placeholder="Search by name or code…"
                />
              </.filter_toolbar>
              <.card id="component-table" inner_class="p-0">
                <.table
                  id="sample-table"
                  rows={@streams.sample_rows}
                  row_id={fn {dom_id, _} -> dom_id end}
                  row_item={fn {_, row} -> row end}
                  sort_by={@sample_sort.sort_by}
                  sort_dir={@sample_sort.sort_dir}
                  sort_event="sample-sort"
                  caption="Example companies"
                  framed={false}
                >
                  <:col :let={row} label="Company" sort="name" sort_id="sample-sort-name">
                    <span class="font-medium text-ink-strong">{row.name}</span>
                  </:col><:col :let={row} label="Code" sort="code" sort_id="sample-sort-code">
                    {row.code}
                  </:col><:col
                    :let={row}
                    label="Status"
                    sort="status"
                    sort_id="sample-sort-status"
                  >
                    <.badge kind={row.kind}>{row.status}</.badge>
                  </:col><:col
                    :let={row}
                    label="Updated"
                    sort="updated_at"
                    sort_id="sample-sort-updated"
                  >
                    <.datetime
                      id={"sample-updated-#{row.id}"}
                      value={row.updated_at}
                      format={:date}
                    />
                  </:col><:action :let={row}>
                    <.icon_button
                      icon="view"
                      id={"sample-preview-#{row.id}"}
                      label={"Preview #{row.name}"}
                      phx-click="preview-company"
                      phx-value-id={row.id}
                    />
                  </:action>
                  <:empty
                    :if={@sample_page.total_entries == 0}
                    title={"No companies match “#{@sample_filter_form[:search].value}”"}
                    reason="Check the spelling, or clear the search to see every example company."
                  >
                    <.button id="sample-clear-search" phx-click="sample-clear-search">
                      Clear search
                    </.button>
                  </:empty>
                </.table><.pagination
                  id="component-pagination"
                  page={@sample_page}
                  filters_form={@sample_page_form}
                  page_event="sample-page"
                  filters_event="sample-page-size"
                />
              </.card>
              <div id="component-table-framed">
                <h3 class="mb-2 text-sm font-semibold text-ink">Company IDs</h3>
                <p class="mb-2 text-xs text-ink-muted">
                  The first five example companies, by id. A framed table brings its
                  own panel, so it stands outside a card; one numeric column
                  right-aligns, and with no caption and no row actions this is the
                  plainest shape the table takes.
                </p>
                <.table id="sample-id-table" rows={@sample_id_rows}>
                  <:col :let={row} label="Company ID" align={:right}>
                    <span class="tabular-nums">{row.id}</span>
                  </:col>
                </.table>
              </div>
            </div>
            <div class="grid gap-3 lg:grid-cols-2">
              <.card id="component-card" title="Card" inner_class="space-y-4 p-4">
                <div id="design-library-card-titled">
                  <p class="mb-2 text-xs text-ink-muted">With a title</p>
                  <.card title="Company profile" inner_class="p-3">
                    <p class="text-sm text-ink">A title adds the bordered heading strip.</p>
                  </.card>
                </div>
                <div id="design-library-card-untitled">
                  <p class="mb-2 text-xs text-ink-muted">Without a title</p>
                  <.card inner_class="p-3">
                    <p class="text-sm text-ink">Without one, the body stands alone.</p>
                  </.card>
                </div>
                <div id="design-library-card-boundary" class="border-t border-line pt-3">
                  <p class="text-xs text-ink-muted">
                    A card has no loading, empty, error, or disabled state; those belong to the content placed inside it.
                  </p>
                </div>
              </.card>
              <.card id="component-list" title="Record facts" inner_class="space-y-4 px-4">
                <div id="design-library-list-populated">
                  <p class="mb-1 text-xs text-ink-muted">Facts for one record</p>
                  <.list>
                    <:item title="Company">Acme Holdings</:item><:item title="Status">
                      <.badge kind={:success}>Active</.badge>
                    </:item><:item title="Jurisdiction">Malaysia</:item>
                  </.list>
                </div>
                <div id="design-library-list-single" class="border-t border-line pt-3">
                  <p class="mb-1 text-xs text-ink-muted">One fact</p>
                  <.list>
                    <:item title="Company">Acme Holdings</:item>
                  </.list>
                </div>
                <div id="design-library-list-boundary" class="border-t border-line pt-3">
                  <p class="text-xs text-ink-muted">
                    This list has no loading, empty, or error state; the screen around it supplies the facts.
                  </p>
                </div>
              </.card>
            </div>
            <.card id="component-stat-strip" title="Statistics" inner_class="space-y-4 p-4">
              <div>
                <p class="mb-2 text-xs text-ink-muted">
                  Linked strip with multiple numeric values
                </p>
                <.stat_strip
                  id="design-library-stat-linked"
                  title="Workspace"
                  navigate={~p"/system/design-library/components"}
                >
                  <:item label="People" kind={:number} value={24} />
                  <:item label="Active" value={18} />
                </.stat_strip>
              </div>
              <div class="border-t border-line pt-4">
                <p class="mb-2 text-xs text-ink-muted">Read-only strip with one text value</p>
                <.stat_strip id="design-library-stat-unlinked" title="Storage">
                  <:item label="Store" kind={:text} value="Durable" />
                </.stat_strip>
              </div>
            </.card>
            <div class="grid gap-3 lg:grid-cols-2">
              <.card id="component-datetime" title="Date and time" inner_class="space-y-3 p-4">
                <div class="flex justify-between gap-4 text-sm">
                  <span class="text-ink-muted">Date and time</span><.datetime
                    id="design-library-date-time"
                    value={@sample_datetime}
                  />
                </div><div class="flex justify-between gap-4 text-sm">
                  <span class="text-ink-muted">Date</span><.datetime
                    id="design-library-date"
                    value={@sample_datetime}
                    format={:date}
                  />
                </div><div class="flex justify-between gap-4 text-sm">
                  <span class="text-ink-muted">Time</span><.datetime
                    id="design-library-time"
                    value={@sample_datetime}
                    format={:time}
                  />
                </div><div class="flex justify-between gap-4 text-sm">
                  <span class="text-ink-muted">To the second</span><.datetime
                    id="design-library-date-time-second"
                    value={@sample_datetime}
                    precision={:second}
                  />
                </div><div class="flex justify-between gap-4 text-sm">
                  <span class="text-ink-muted">Not set</span><.datetime
                    id="design-library-date-empty"
                    value={nil}
                  />
                </div>
              </.card>
              <div
                id="component-badge"
                class="flex flex-wrap gap-2 rounded-xl border border-line bg-surface p-4 shadow-xs"
              >
                <.badge>Archived</.badge><.badge kind={:success}>Active</.badge><.badge kind={
                  :warning
                }>
                  Pending
                </.badge><.badge kind={:danger}>Suspended</.badge>
              </div>
            </div>
          </section>

          <section id="component-composite-patterns" class="scroll-mt-4 space-y-4">
            <div>
              <h2 class="text-base font-semibold text-ink-strong">
                Composite patterns
              </h2>
              <p class="text-sm text-ink-muted">
                One operational index page end to end: search, table, empty result and pagination as a single flow. The form page, detail page, destructive workflow, first arrival and the responsive and theme review have no specimen yet.
              </p>
            </div>
            <.form
              for={@pattern_form}
              id="design-library-pattern-search"
              phx-change="pattern-search"
              phx-submit="pattern-search"
              class="mb-2"
            >
              <.input
                field={@pattern_form[:search]}
                type="search"
                label="Search companies"
                label_class="sr-only"
                wrapper_class="mb-0"
                placeholder="Search companies…"
              />
            </.form>
            <.card inner_class="p-0">
              <.table
                id="design-library-pattern-table"
                rows={@pattern_rows}
                caption="Example companies"
                framed={false}
              >
                <:col :let={row} label="Company">{row.name}</:col><:col :let={row} label="Code">
                  {row.code}
                </:col><:col :let={row} label="Status">
                  <.badge kind={row.kind}>{row.status}</.badge>
                </:col><:col :let={row} label="Updated">
                  <.datetime
                    id={"pattern-updated-#{row.id}"}
                    value={row.updated_at}
                    format={:date}
                  />
                </:col>
                <:empty :if={@pattern_rows == []}>
                  <p id="design-library-pattern-empty" class="p-4 text-sm text-ink-muted">
                    No example companies match. Clear the search to see all examples.
                  </p>
                </:empty>
              </.table><.pagination
                id="design-library-pattern-pagination"
                page={@pattern_page}
                filters_form={@pattern_page_form}
                page_event="pattern-page"
                filters_event="pattern-page-size"
              />
            </.card>
            <.card
              id="component-filter-toolbar"
              title="Filter toolbar"
              inner_class="space-y-5 p-4"
            >
              <p class="text-sm text-ink-muted">
                One composition for every list's search, selects, multi-selects, and date pair. Every search box carries the same leading magnifier; labels are screen-reader only; helper text sits below its control; cells wrap on narrow screens.
              </p>
              <div id="filter-toolbar-full">
                <h3 class="mb-2 text-sm font-semibold text-ink">
                  Search, selects, multi-select, and UTC date pair
                </h3>
                <.filter_toolbar
                  id="design-library-filter-full"
                  form={@filter_toolbar_full_form}
                  event="filter-toolbar-preview"
                >
                  <:control
                    type={:search}
                    field={@filter_toolbar_full_form[:search]}
                    id="design-library-filter-full-search"
                    label="Search example companies"
                    placeholder="Search example companies…"
                  />
                  <:control
                    type={:select}
                    field={@filter_toolbar_full_form[:status]}
                    id="design-library-filter-full-status"
                    label="Status filter"
                    options={[{"All statuses", ""}, {"Active", "active"}, {"Pending", "pending"}]}
                  />
                  <:control
                    type={:select}
                    field={@filter_toolbar_full_form[:kind]}
                    id="design-library-filter-full-kind"
                    label="Kind filter"
                    options={[
                      {"All kinds", ""},
                      {"Standard", "standard"},
                      {"Advanced", "advanced"}
                    ]}
                  />
                  <:control
                    type={:multi_select}
                    field={@filter_toolbar_full_form[:roles]}
                    id="design-library-filter-full-roles"
                    label="Role filter"
                    placeholder="All roles"
                    selection_label=":count role selected|:count roles selected"
                    options={[
                      {"Administrator", "admin"},
                      {"Operator", "operator"},
                      {"Reviewer", "reviewer"}
                    ]}
                  />
                  <:control
                    type={:date}
                    field={@filter_toolbar_full_form[:start_date]}
                    id="design-library-filter-full-start-date"
                    label="Start date"
                    hint="UTC"
                  />
                  <:control
                    type={:date}
                    field={@filter_toolbar_full_form[:end_date]}
                    id="design-library-filter-full-end-date"
                    label="End date"
                    hint="UTC"
                  />
                </.filter_toolbar>
              </div>
              <div id="filter-toolbar-search-only" class="border-t border-line pt-4">
                <h3 class="mb-2 text-sm font-semibold text-ink">Search alone</h3>
                <.filter_toolbar
                  id="design-library-filter-search-only"
                  form={@filter_toolbar_search_form}
                  event="filter-toolbar-search-preview"
                >
                  <:control
                    type={:search}
                    field={@filter_toolbar_search_form[:search]}
                    id="design-library-filter-search-only-search"
                    label="Search example records"
                    placeholder="Search example records…"
                  />
                </.filter_toolbar>
              </div>
            </.card>
          </section>
        </div>
      </section>
    <% end %>

    <%= if @area == :graphic do %>
      <section id="graphics" class="space-y-8">
        <div id="component-icon" class="space-y-8">
          <section id="graphic-mark" class="space-y-4">
            <div>
              <h2 class="text-base font-semibold text-ink-strong">Bilimbi mark</h2><p class="text-sm text-ink-muted">
                One mark, shown at the sizes and surfaces currently in use.
              </p>
            </div>
            <div class="grid gap-3 sm:grid-cols-3">
              <div class="grid min-h-36 place-items-center rounded-xl border border-line bg-canvas p-4">
                <div class="text-center">
                  <img src={~p"/images/logo.svg"} alt="Bilimbi" class="mx-auto size-9" /><p class="mt-3 text-xs text-ink-muted">
                    Sign in · 36px
                  </p>
                </div>
              </div>
              <div class="grid min-h-36 place-items-center rounded-xl border border-line bg-surface-sidebar p-4">
                <div class="text-center">
                  <img src={~p"/images/logo.svg"} alt="Bilimbi" class="mx-auto size-6" /><p class="mt-3 text-xs text-ink-muted">
                    App bar · 24px
                  </p>
                </div>
              </div>
              <div class="grid min-h-36 place-items-center rounded-xl border border-line bg-surface p-4 shadow-xs">
                <div class="text-center">
                  <img src={~p"/favicon.svg"} alt="Bilimbi favicon" class="mx-auto size-8" /><p class="mt-3 text-xs text-ink-muted">
                    Browser icon · 32px
                  </p>
                </div>
              </div>
            </div>
            <div class="rounded-xl border border-line bg-surface p-4 shadow-xs">
              <h3 class="mb-2 text-sm font-semibold text-ink">Bilimbi-specific icons</h3>
              <div class="flex flex-wrap gap-5">
                <div class="flex items-center gap-2">
                  <.icon name="bilimbi-pin" class="size-5 text-action" /><span class="text-sm text-ink">Pin to sidebar</span>
                </div><div class="flex items-center gap-2">
                  <.icon name="bilimbi-impersonate" class="size-5 text-action" /><span class="text-sm text-ink">Impersonate user</span>
                </div>
              </div>
            </div>
          </section>

          <section id="graphic-icons" class="space-y-4">
            <div>
              <h2 class="text-base font-semibold text-ink-strong">Icons</h2><p class="text-sm text-ink-muted">
                Outline icons are the current default. Familiar actions share one named glyph so the mapping cannot drift.
              </p>
            </div>
            <div class="space-y-5 rounded-xl border border-line bg-surface p-4 shadow-xs">
              <div>
                <h3 class="mb-2 text-sm font-semibold text-ink">Navigation</h3><div class="grid gap-2 sm:grid-cols-2 lg:grid-cols-4">
                  <div class="flex items-center gap-3 rounded-lg bg-canvas p-3">
                    <.icon name="hero-building-office-2" class="size-5 text-action" /><span class="text-sm text-ink">Companies</span>
                  </div><div class="flex items-center gap-3 rounded-lg bg-canvas p-3">
                    <.icon name="hero-users" class="size-5 text-action" /><span class="text-sm text-ink">Users</span>
                  </div><div class="flex items-center gap-3 rounded-lg bg-canvas p-3">
                    <.icon name="hero-shield-check" class="size-5 text-action" /><span class="text-sm text-ink">Authorization</span>
                  </div><div class="flex items-center gap-3 rounded-lg bg-canvas p-3">
                    <.icon name="hero-cog-6-tooth" class="size-5 text-action" /><span class="text-sm text-ink">System</span>
                  </div>
                </div>
              </div>
              <div>
                <h3 class="mb-2 text-sm font-semibold text-ink">Actions</h3><div class="flex flex-wrap gap-2">
                  <.button><.icon name="create" /> Add</.button>
                  <.button><.icon name="edit" /> Edit</.button>
                  <.button><.icon name="search" /> Search</.button>
                  <.button variant="danger"><.icon name="delete" /> Delete</.button>
                </div>
              </div>
              <div>
                <h3 class="mb-2 text-sm font-semibold text-ink">Status</h3><div class="flex flex-wrap gap-5">
                  <div class="flex items-center gap-2 text-success-ink">
                    <.icon name="success" class="size-5" /><span class="text-sm">Completed</span>
                  </div><div class="flex items-center gap-2 text-warning-ink">
                    <.icon name="warning" class="size-5" /><span class="text-sm">Attention</span>
                  </div><div class="flex items-center gap-2 text-danger-ink">
                    <.icon name="error" class="size-5" /><span class="text-sm">Failed</span>
                  </div><div class="flex items-center gap-2 text-ink-muted">
                    <.icon name="information" class="size-5" /><span class="text-sm">Information</span>
                  </div>
                </div>
              </div>
              <div id="graphic-icon-variants" class="border-t border-line pt-4">
                <h3 class="mb-2 text-sm font-semibold text-ink">Icon treatments</h3>
                <div class="flex flex-wrap items-end gap-6">
                  <div class="text-center">
                    <.icon name="hero-check-circle" class="mx-auto text-success" />
                    <p class="mt-1 text-xs text-ink-muted">Outline — the default</p>
                  </div>
                  <div class="text-center">
                    <.icon name="hero-check-circle-solid" class="mx-auto text-success" />
                    <p class="mt-1 text-xs text-ink-muted">Solid</p>
                  </div>
                  <div class="text-center">
                    <.icon name="hero-check-circle-mini" class="mx-auto text-success" />
                    <p class="mt-1 text-xs text-ink-muted">Mini</p>
                  </div>
                </div>
                <p class="mt-3 text-xs text-ink-muted">
                  Outline and solid use regular dimensions; Mini is a smaller-optimized drawing intended for compact use.
                </p>
                <h3 class="mb-2 mt-4 text-sm font-semibold text-ink">
                  Size and color are set where the icon is used
                </h3>
                <div class="flex flex-wrap items-end gap-6">
                  <div class="text-center">
                    <.icon name="hero-check-circle" class="mx-auto size-4 text-success" />
                    <p class="mt-1 text-xs text-ink-muted">Small, success green</p>
                  </div>
                  <div class="text-center">
                    <.icon name="hero-check-circle" class="mx-auto size-7 text-muted" />
                    <p class="mt-1 text-xs text-ink-muted">Large, muted</p>
                  </div>
                </div>
                <p class="mt-3 text-xs text-ink-muted">
                  Icons have no built-in interaction or disabled state; the name chooses the drawing and the screen sets its size and color.
                </p>
              </div>
            </div>
          </section>
        </div>
      </section>
    <% end %>

    <%= if @area == :design_spec do %>
      <section id="specifications" class="space-y-8">
        <section id="accepted-design" class="space-y-6">
          <div>
            <h2 class="text-base font-semibold text-ink-strong">Accepted choices</h2><p class="text-sm text-ink-muted">
              These are the current rules for Bilimbi.
            </p>
          </div>
          <section id="spec-shell" class="space-y-3">
            <h2 class="text-base font-semibold text-ink">
              Application shell
            </h2>
            <p class="text-sm text-muted">
              Account details belong behind the bottom-left circle, including the Platform-operator caution row when the tenant is the platform operator; only impersonation, which has an exit, stays above the workspace. Where a screen's own reach is not filtered to one company, that screen says so in the same caution colour: the SQL console warns beside the query it runs, and an authorization listing the operator scope widens to rows attached to no company carries a one-line caption above its table, and the roles list, whose Principals counts it widens, names those counts. An account works in one company and tenant, so the menu shows the current scope and offers no switching.
            </p>
            <p class="text-sm text-muted">
              The clock selects Company, Local or UTC time. Sun, moon and desktop select Light, Dark or System theme. A saved choice confirms in place, updates the controls and follows your account; every timestamp already rendered through &lt;.datetime&gt; changes with it, without a reload and without losing your place, and every screen you open afterwards uses the new choice. A screen that formats instants directly rather than through that component is unaffected until it adopts it. While saving, controls prevent duplicate work; a failed save keeps the previous choice and explains how to retry. While you view as another user, the top bar reports the active time display and offers no controls, because those preferences belong to the account you are viewing.
            </p>
            <p class="text-sm text-muted">
              Menus close on Escape or outside click and return keyboard focus to their trigger on Escape. The narrow drawer contains keyboard focus and returns it to the sidebar toggle when closed.
            </p>
          </section>
          <section id="spec-theme" class="space-y-3">
            <h3 class="text-sm font-semibold text-ink">Theme</h3>
            <div class="grid gap-3 lg:grid-cols-2">
              <.card id="spec-t01" inner_class="p-4">
                <h4 class="text-sm font-semibold text-ink">
                  Theme contrast stays distinct
                </h4>
                <p class="mt-2 text-sm text-ink">
                  Links read stronger than muted text. Dark surfaces retain separate depth, and dark primary actions brighten on hover.
                </p>
              </.card>
              <.card id="spec-d01" inner_class="p-4">
                <h4 class="text-sm font-semibold text-ink">Colour has meaning</h4>
                <p class="mt-2 text-sm text-ink">
                  Brand, action, selection, and status each have a separate meaning. Green, amber, and red report status only.
                </p>
              </.card>
              <.card id="spec-d02" inner_class="p-4">
                <h4 class="text-sm font-semibold text-ink">Type stays quiet</h4>
                <p class="mt-2 text-sm text-ink">
                  Instrument Sans is used throughout. Headings establish hierarchy without making operational screens loud.
                </p>
              </.card>
            </div>
          </section>

          <section id="spec-components" class="space-y-3">
            <h3 class="text-sm font-semibold text-ink">Components</h3>
            <div class="grid gap-3 lg:grid-cols-2">
              <.card id="spec-c01" inner_class="p-4">
                <h4 class="text-sm font-semibold text-ink">Compact fields always win</h4>
                <p class="mt-2 text-sm text-ink">
                  Fields use compact padding and rounded-md geometry in forms, filters, and inline work.
                </p>
              </.card>
              <.card id="spec-c02" inner_class="p-4">
                <h4 class="text-sm font-semibold text-ink">
                  Focus uses the lively brand accent
                </h4>
                <p class="mt-2 text-sm text-ink">
                  Keyboard focus uses brand-strong so the active control is clear in light and dark themes.
                </p>
              </.card>
              <.card id="spec-c03" inner_class="p-4">
                <h4 class="text-sm font-semibold text-ink">
                  Destructive actions stay calm
                </h4>
                <p class="mt-2 text-sm text-ink">
                  Destructive actions use danger text and quiet hover feedback instead of a solid red button.
                </p>
              </.card>
              <.card id="spec-c04" inner_class="p-4">
                <h4 class="text-sm font-semibold text-ink">Filters use an open toolbar</h4>
                <p class="mt-2 text-sm text-ink">
                  Search and filters sit together above the list surface without another card around them.
                </p>
              </.card>
              <.card id="spec-c05" inner_class="p-4">
                <h4 class="text-sm font-semibold text-ink">
                  Familiar row actions use icons
                </h4>
                <p class="mt-2 text-sm text-ink">
                  Repeated table actions use labelled icons for compactness. Unfamiliar and primary actions keep text.
                </p>
              </.card>
              <.card id="spec-c06" inner_class="p-4">
                <h4 class="text-sm font-semibold text-ink">Icon size follows context</h4>
                <p class="mt-2 text-sm text-ink">
                  Inline icon controls are 24px. Table and toolbar icon controls are 28px.
                </p>
              </.card>
            </div>
          </section>

          <section id="spec-structure-data" class="space-y-3">
            <h3 class="text-sm font-semibold text-ink">Structure and data</h3>
            <div class="grid gap-3 lg:grid-cols-2">
              <.card id="spec-d03" inner_class="p-4">
                <h4 class="text-sm font-semibold text-ink">Width follows the work</h4>
                <p class="mt-2 text-sm text-ink">
                  Lists are wide, forms are narrow, and record details sit between them.
                </p>
              </.card>
              <.card id="spec-d04" inner_class="p-4">
                <h4 class="text-sm font-semibold text-ink">Data stays compact</h4>
                <p class="mt-2 text-sm text-ink">
                  Tables favour scanning: compact rows, quiet dividers, proper-case headings, and tabular numbers.
                </p>
              </.card>
            </div>
          </section>

          <section id="spec-experience" class="space-y-3">
            <h3 class="text-sm font-semibold text-ink">Experience</h3>
            <div class="grid gap-3 lg:grid-cols-2">
              <.card id="spec-d05" inner_class="p-4">
                <h4 class="text-sm font-semibold text-ink">Copy is for the user</h4>
                <p class="mt-2 text-sm text-ink">
                  Labels say what a person can understand and act on. Internal history and implementation details stay out of the interface.
                </p>
              </.card>
              <.card id="spec-d06" inner_class="p-4">
                <h4 class="text-sm font-semibold text-ink">Every state is designed</h4>
                <p class="mt-2 text-sm text-ink">
                  Empty, loading, success, failure, permission, and recovery states receive the same care as the happy path.
                </p>
              </.card>
            </div>
          </section>
        </section>
      </section>
    <% end %>
  </.page>
</Layouts.app>
