<!DOCTYPE html>
<%!-- data-theme is stamped only for an explicit light/dark choice; the
     "system" default stamps nothing and prefers-color-scheme governs (#657). --%>
<html lang="en" class="h-full bg-canvas" data-theme={assigns[:ui_theme]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title default="Bilimbi" suffix=" · Business application platform" phx-no-format>
      {assigns[:page_title]}
    </.live_title>
    <link rel="icon" href={~p"/favicon.svg"} type="image/svg+xml" sizes="any" />
    <link rel="apple-touch-icon" href={~p"/favicon.svg"} />
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
  </head>
  <body class="h-full bg-canvas text-ink antialiased">
    {@inner_content}
  </body>
</html>
