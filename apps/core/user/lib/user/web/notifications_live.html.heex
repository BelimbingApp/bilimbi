<Layouts.app flash={@flash} current_scope={@current_scope} active_nav={@active_nav}>
  <:topbar_actions>
    <.live_component
      module={Bilimbi.Core.User.Web.NotificationBellComponent}
      id="topbar-notification-bell"
      current_scope={@current_scope}
    />
  </:topbar_actions>
  <.page variant={:form}>
    <.header>
      Notifications
      <:subtitle>Updates, system events, and account activity</:subtitle>
      <:actions>
        <.button
          :if={@unread_count > 0}
          id="mark-all-read-btn"
          type="button"
          phx-click="mark_all_read"
          class="text-xs px-3 py-1.5"
        >
          <.icon name="hero-check" class="size-3.5 mr-1" /> Mark all as read
        </.button>
      </:actions>
    </.header>

    <div class="mt-4 flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-line pb-2">
      <div class="flex items-center gap-2">
        <.link
          patch={~p"/notifications?filter=all&page=1&per_page=#{@per_page}"}
          id="filter-all-tab"
          class={[
            "rounded-md px-3 py-1.5 text-xs font-medium transition",
            if(@current_filter == :all,
              do: "bg-surface-sunken text-ink font-semibold",
              else: "text-ink-subtle hover:text-ink hover:bg-surface-muted"
            )
          ]}
        >
          All
        </.link>
        <.link
          patch={~p"/notifications?filter=unread&page=1&per_page=#{@per_page}"}
          id="filter-unread-tab"
          class={[
            "inline-flex items-center gap-1.5 rounded-md px-3 py-1.5 text-xs font-medium transition",
            if(@current_filter == :unread,
              do: "bg-surface-sunken text-ink font-semibold",
              else: "text-ink-subtle hover:text-ink hover:bg-surface-muted"
            )
          ]}
        >
          Unread
          <span
            :if={@unread_count > 0}
            id="notifications-unread-tab-badge"
            class="inline-flex items-center justify-center rounded-full bg-brand-strong px-1.5 py-0.2 text-[10px] font-semibold text-white tabular-nums"
          >
            {@unread_count}
          </span>
        </.link>
        <.link
          patch={~p"/notifications?filter=read&page=1&per_page=#{@per_page}"}
          id="filter-read-tab"
          class={[
            "rounded-md px-3 py-1.5 text-xs font-medium transition",
            if(@current_filter == :read,
              do: "bg-surface-sunken text-ink font-semibold",
              else: "text-ink-subtle hover:text-ink hover:bg-surface-muted"
            )
          ]}
        >
          Read
        </.link>
      </div>

    </div>

    <div
      :if={@notification_count == 0}
      id="notifications-empty"
      class="mt-4 rounded-xl border border-line bg-surface p-12 text-center"
    >
      <%!-- The label alone says it; a cheerful second line is the consumer
           register DESIGN's operational voice avoids (#653). --%>
      <.icon name="hero-bell-slash" class="mx-auto size-8 text-ink-faint" />
      <p class="mt-2 text-sm font-medium text-ink">No notifications</p>
    </div>

    <div
      :if={@notification_count > 0}
      id="notifications-list"
      phx-update="stream"
      class="mt-4 divide-y divide-line rounded-xl border border-line bg-surface overflow-hidden shadow-xs"
    >
      <div
        :for={{dom_id, notification} <- @streams.notifications}
        id={dom_id}
        class={[
          "group flex items-start justify-between gap-3 p-4 transition",
          if(Bilimbi.Core.User.Notification.unread?(notification),
            do: "bg-surface",
            else: "bg-surface-muted/40"
          )
        ]}
      >
        <div class="flex min-w-0 flex-1 items-start gap-3">
          <span
            class={[
              "mt-1.5 size-2 shrink-0 rounded-full",
              if(Bilimbi.Core.User.Notification.unread?(notification),
                do: "bg-brand",
                else: "bg-transparent"
              )
            ]}
            aria-hidden="true"
          />

          <div class="grid size-8 shrink-0 place-items-center rounded-lg bg-surface-sunken text-ink-muted">
            <.icon
              name={Bilimbi.Core.User.Notification.icon(notification)}
              class="size-4 shrink-0"
            />
          </div>

          <div class="min-w-0 flex-1">
            <div class="flex items-center gap-2">
              <p class={[
                "truncate text-sm",
                if(Bilimbi.Core.User.Notification.unread?(notification),
                  do: "font-semibold text-ink",
                  else: "font-normal text-ink-muted"
                )
              ]}>
                {Bilimbi.Core.User.Notification.title(notification)}
              </p>
              <span class="text-[11px] text-ink-faint tabular-nums shrink-0">
                {format_relative_time(notification.created_at)}
              </span>
            </div>

            <p
              :if={Bilimbi.Core.User.Notification.body(notification) != ""}
              class="mt-0.5 text-xs text-ink-subtle line-clamp-2"
            >
              {Bilimbi.Core.User.Notification.body(notification)}
            </p>

            <div :if={Bilimbi.Core.User.Notification.url(notification)} class="mt-2">
              <button
                id={"visit-#{notification.id}"}
                type="button"
                phx-click="visit"
                phx-value-id={notification.id}
                class="text-xs font-medium text-brand hover:underline inline-flex items-center gap-1 cursor-pointer"
              >
                View details <.icon name="hero-arrow-right" class="size-3" />
              </button>
            </div>
          </div>
        </div>

        <div class="shrink-0">
          <.button
            :if={Bilimbi.Core.User.Notification.unread?(notification)}
            id={"mark-read-#{notification.id}"}
            type="button"
            phx-click="mark_read"
            phx-value-id={notification.id}
            class="text-xs px-2.5 py-1"
            title="Mark as read"
          >
            Mark read
          </.button>
        </div>
      </div>
    </div>

    <div class="mt-4">
      <.pagination
        id="notifications-pagination"
        page={@pagination_page}
        filters_form={@filters_form}
      />
    </div>
  </.page>
</Layouts.app>
