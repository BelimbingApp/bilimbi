<Layouts.app flash={@flash} current_scope={@current_scope} active_nav={nil}>
  <.settings_layout
    current_page={:password}
    heading="Update Password"
    subheading="Ensure your account is using a long, random password to stay secure."
  >
    <.form
      for={@form}
      id="password-form"
      phx-change="validate"
      phx-submit="save"
      class="space-y-4 rounded-xl border border-line bg-surface p-6"
    >
      <.secret_input
        field={@form[:current_password]}
        label="Current password"
        subject="password"
        autocomplete="current-password"
      />

      <.secret_input
        field={@form[:password]}
        label="New password"
        subject="password"
        autocomplete="new-password"
      />

      <.secret_input
        field={@form[:password_confirmation]}
        label="Confirm password"
        subject="password"
        autocomplete="new-password"
      />

      <div class="flex justify-end pt-2">
        <.button id="password-save" type="submit" variant="primary">Save</.button>
      </div>
    </.form>
  </.settings_layout>
</Layouts.app>
