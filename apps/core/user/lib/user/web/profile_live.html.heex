<Layouts.app flash={@flash} current_scope={@current_scope} active_nav={nil}>
  <.page variant={:form}>
    <.header>
      Profile
      <:subtitle>Your account details and where signing in takes you</:subtitle>
    </.header>

    <.form
      for={@form}
      id="profile-form"
      phx-change="validate"
      phx-submit="save"
      class="mt-5 space-y-4 rounded-xl border border-line bg-surface p-4"
    >
      <.input field={@form[:name]} type="text" label="Name" autocomplete="name" />

      <.input
        field={@form[:email]}
        type="email"
        label="Email"
        autocomplete="email"
        hint="Changing this address means it needs verifying again before it is trusted."
      />

      <.input
        field={@form[:landing_menu_id]}
        type="select"
        label="Landing page"
        prompt="Default (first page you can open)"
        options={@landing_options}
        hint="Only pages you can open are listed. Leave it unset to keep the default."
      />

      <div class="flex justify-end">
        <.button id="profile-save" type="submit" variant="primary">Save</.button>
      </div>
    </.form>
  </.page>
</Layouts.app>
