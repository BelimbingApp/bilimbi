<Layouts.app flash={@flash} current_scope={@current_scope} active_nav={nil}>
  <.settings_layout
    current_page={:appearance}
    heading="Appearance Settings"
    subheading="Choose how Bilimbi looks and formats content for your account."
  >
    <form
      id="appearance-form"
      phx-change="save"
      class="space-y-4 rounded-xl border border-line bg-surface p-6"
    >
      <%!-- No radio that saves a dead choice: rendering is light-only until
           the #657 foundation lands, and DESIGN's rule is that theme controls
           appear only when something real backs them. The ui.theme storage
           stays intact underneath as the foundation's consumer contract. --%>
      <fieldset class="space-y-4">
        <legend class="text-sm font-medium text-ink">Theme</legend>

        <div id="theme-current" class="rounded-lg border border-line p-4">
          <div class="text-sm font-medium text-ink">Light</div>
          <div class="text-xs text-muted">
            The platform currently renders the light theme. Dark and system
            options will appear here when a dark theme ships.
          </div>
        </div>
      </fieldset>

      <.input
        id="appearance-locale"
        name="appearance[locale]"
        type="select"
        value={@locale}
        label="Language and region"
        prompt={"Use installation default (#{@installation_locale})"}
        options={@locale_options}
        hint="Sets your preferred language and region for this account."
        wrapper_class="mb-0"
      />
    </form>
  </.settings_layout>
</Layouts.app>
