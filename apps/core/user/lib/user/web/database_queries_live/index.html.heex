<Layouts.app flash={@flash} current_scope={@current_scope} active_nav={@active_nav}>
  <.page id="database-queries-index" variant={:list}>
    <.header>
      Database Queries
      <:subtitle>
        User-defined SQL queries rendered as browsable pages
      </:subtitle>
      <:actions>
        <.button
          :if={allowed?(@current_scope, "admin.system.database-table.edit")}
          id="btn-create-query"
          navigate={~p"/admin/system/database-queries/_new"}
          variant="primary"
        >
          <.icon name="hero-plus" class="size-4 mr-1.5" />
          Create Query
        </.button>
      </:actions>
    </.header>

    <form id="database-queries-search-form" phx-change="search" phx-submit="search" class="mb-2">
      <.input
        type="search"
        name="search"
        id="search-input"
        value={@search}
        label="Search database queries"
        label_class="sr-only"
        placeholder="Search by name or description..."
        wrapper_class="mb-0"
      />
    </form>

    <.card id="database-queries-card" inner_class="p-0">
      <.table
        id="database-queries-table"
        rows={@queries}
        row_id={fn query -> "query-row-#{query.id}" end}
        sort_by={@sort_by}
        sort_dir={@sort_dir}
        framed={false}
      >
        <:col :let={query} label="Name" sort="name">
          <.link
            navigate={~p"/admin/system/database-queries/#{query.slug}"}
            class="font-medium text-action hover:underline"
          >
            {query.name}
          </.link>
        </:col>
        <:col :let={query} label="Description" sort="description">
          <span class="block max-w-xs truncate text-ink-subtle" title={query.description}>
            {query.description || "—"}
          </span>
        </:col>
        <:col :let={query} label="Created" sort="created_at">
          <span class="whitespace-nowrap text-ink-subtle">
            <.datetime id={"created-#{query.id}"} value={query.created_at} />
          </span>
        </:col>
        <:col :let={query} label="Updated" sort="updated_at">
          <span class="whitespace-nowrap text-ink-subtle">
            <.datetime id={"updated-#{query.id}"} value={query.updated_at} />
          </span>
        </:col>

        <:action :let={query}>
          <div
            :if={allowed?(@current_scope, "admin.system.database-table.edit")}
            class="inline-flex items-center gap-1.5"
          >
            <.icon_button
              icon="hero-document-duplicate"
              label="Duplicate query"
              id={"duplicate-query-#{query.id}"}
              phx-click="duplicate"
              phx-value-id={query.id}
            />
            <.icon_button
              icon="hero-trash"
              label="Delete query"
              kind={:danger}
              id={"delete-query-#{query.id}"}
              phx-click="delete"
              phx-value-id={query.id}
              data-confirm="Are you sure you want to delete this query?"
            />
          </div>
        </:action>

        <:empty :if={@queries == []}>
          No queries found.
        </:empty>
      </.table>

      <%= if @total_pages > 1 do %>
        <div class="mt-4 flex items-center justify-between text-sm text-ink-subtle">
          <span>
            Showing {@queries |> length()} of {@total_count} queries
          </span>
          <div class="inline-flex items-center gap-2">
            <.button
              :if={@page > 1}
              phx-click="page"
              phx-value-page={@page - 1}
              class="px-2.5 py-1 text-xs"
            >
              Previous
            </.button>
            <span class="px-2 font-medium text-ink">Page {@page} of {@total_pages}</span>
            <.button
              :if={@page < @total_pages}
              phx-click="page"
              phx-value-page={@page + 1}
              class="px-2.5 py-1 text-xs"
            >
              Next
            </.button>
          </div>
        </div>
      <% end %>
    </.card>
  </.page>
</Layouts.app>
