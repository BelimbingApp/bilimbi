<Layouts.app flash={@flash} current_scope={@current_scope} active_nav={@active_nav}>
  <.page id="database-queries-index" variant={:list}>
    <.header>
      Database Queries
      <:subtitle>
        User-defined SQL queries rendered as browsable pages
      </:subtitle>
      <:actions>
        <.button
          :if={allowed?(@current_scope, "admin.system.database-table.edit")}
          id="btn-create-query"
          navigate={~p"/admin/system/database-queries/_new"}
          variant="primary"
        >
          <.icon name="create" class="size-4 mr-1.5" /> Create Query
        </.button>
      </:actions>
    </.header>

    <.filter_toolbar id="database-queries-filters" form={@filters_form} event="search">
      <:control
        type={:search}
        field={@filters_form[:search]}
        id="search-input"
        label="Search database queries"
        placeholder="Search by name or description..."
      />
    </.filter_toolbar>

    <.card id="database-queries-card" inner_class="p-0">
      <.flex_table
        id="database-queries-table"
        framed={false}
        columns={@columns.column_views}
        rows={@columns.rows}
        mode={@columns.mode}
        zoom={@columns.zoom}
        suggestions={@columns.suggestions}
        add_query={@columns.add_query}
        row_id={&"query-row-#{&1}"}
        caption="Database queries"
        sort_by={@sort_by}
        sort_dir={@sort_dir}
      >
        <:col :let={%{record: query}} id="name">
          <.link
            navigate={~p"/admin/system/database-queries/#{query.slug}"}
            class="font-medium text-action hover:underline"
          >
            {query.name}
          </.link>
        </:col>
        <:col :let={%{record: query}} id="description">
          <span class="block max-w-xs truncate text-ink-subtle" title={query.description}>
            {query.description || "—"}
          </span>
        </:col>
        <:col :let={%{record: query}} id="created_at">
          <span class="whitespace-nowrap text-ink-subtle">
            <.datetime id={"created-#{query.id}"} value={query.created_at} />
          </span>
        </:col>
        <:col :let={%{record: query}} id="updated_at">
          <span class="whitespace-nowrap text-ink-subtle">
            <.datetime id={"updated-#{query.id}"} value={query.updated_at} />
          </span>
        </:col>

        <:action :let={%{record: query}}>
          <div
            :if={allowed?(@current_scope, "admin.system.database-table.edit")}
            class="inline-flex items-center gap-1.5"
          >
            <.icon_button
              icon="duplicate"
              label="Duplicate query"
              id={"duplicate-query-#{query.id}"}
              phx-click="duplicate"
              phx-value-id={query.id}
            />
            <.icon_button
              icon="delete"
              label="Delete query"
              kind={:danger}
              id={"delete-query-#{query.id}"}
              phx-click="request_delete"
              phx-value-id={query.id}
            />
          </div>
        </:action>

        <:empty :if={@queries == []}>
          No queries found.
        </:empty>
      </.flex_table>

      <.pagination
        id="database-queries-pagination"
        page={@queries_page}
        page_sizes={@page_sizes}
        filters_form={@filters_form}
        filters_event="search"
      />
    </.card>

    <.confirm_dialog
      :if={@pending_delete}
      id="delete-query-confirm"
      consequence={"Query “#{@pending_delete.name}” will be deleted."}
      detail="Its saved SQL and parameters are removed. This cannot be undone."
      confirm="Delete"
      working="Deleting…"
      on_confirm={JS.push("delete")}
      on_cancel={JS.push("cancel_delete")}
    />
  </.page>
</Layouts.app>
