<Layouts.app flash={@flash} current_scope={@current_scope} active_nav={@active_nav}>
  <.page id="database-queries-index" variant={:list}>
    <.header>
      Database Queries
      <:subtitle>
        User-defined SQL queries rendered as browsable pages
      </:subtitle>
      <:actions>
        <.button
          :if={allowed?(@current_scope, "admin.system.database-table.edit")}
          id="btn-create-query"
          navigate={~p"/admin/system/database-queries/_new"}
          variant="primary"
        >
          <.icon name="hero-plus" class="size-4 mr-1.5" />
          Create Query
        </.button>
      </:actions>
    </.header>

    <.card id="database-queries-card">
      <div class="mb-4 flex items-center gap-4 flex-wrap">
        <div class="flex-1 min-w-[240px]">
          <form id="database-queries-search-form" phx-change="search" phx-submit="search">
            <.input
              type="text"
              name="search"
              id="search-input"
              value={@search}
              placeholder="Search by name or description..."
              wrapper_class="mb-0"
            />
          </form>
        </div>
      </div>

      <div class="overflow-x-auto rounded-lg border border-line">
        <table id="database-queries-table" class="w-full text-left text-sm text-ink">
          <thead class="border-b border-line bg-surface-subtle text-xs font-semibold uppercase text-ink-subtle">
            <tr>
              <th scope="col" class="px-4 py-3 cursor-pointer select-none hover:text-ink" phx-click="sort" phx-value-column="name">
                <div class="flex items-center gap-1">
                  <span>Name</span>
                  <.icon :if={@sort_by == "name" && @sort_dir == :asc} name="hero-chevron-up" class="size-3.5" />
                  <.icon :if={@sort_by == "name" && @sort_dir == :desc} name="hero-chevron-down" class="size-3.5" />
                </div>
              </th>
              <th scope="col" class="px-4 py-3 cursor-pointer select-none hover:text-ink" phx-click="sort" phx-value-column="description">
                <div class="flex items-center gap-1">
                  <span>Description</span>
                  <.icon :if={@sort_by == "description" && @sort_dir == :asc} name="hero-chevron-up" class="size-3.5" />
                  <.icon :if={@sort_by == "description" && @sort_dir == :desc} name="hero-chevron-down" class="size-3.5" />
                </div>
              </th>
              <th scope="col" class="px-4 py-3 cursor-pointer select-none hover:text-ink" phx-click="sort" phx-value-column="created_at">
                <div class="flex items-center gap-1">
                  <span>Created</span>
                  <.icon :if={@sort_by == "created_at" && @sort_dir == :asc} name="hero-chevron-up" class="size-3.5" />
                  <.icon :if={@sort_by == "created_at" && @sort_dir == :desc} name="hero-chevron-down" class="size-3.5" />
                </div>
              </th>
              <th scope="col" class="px-4 py-3 cursor-pointer select-none hover:text-ink" phx-click="sort" phx-value-column="updated_at">
                <div class="flex items-center gap-1">
                  <span>Updated</span>
                  <.icon :if={@sort_by == "updated_at" && @sort_dir == :asc} name="hero-chevron-up" class="size-3.5" />
                  <.icon :if={@sort_by == "updated_at" && @sort_dir == :desc} name="hero-chevron-down" class="size-3.5" />
                </div>
              </th>
              <th scope="col" class="px-4 py-3 text-right">Actions</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-line">
            <%= if @queries == [] do %>
              <tr>
                <td colspan="5" class="px-4 py-8 text-center text-sm text-ink-subtle">
                  No queries found.
                </td>
              </tr>
            <% else %>
              <%= for query <- @queries do %>
                <tr id={"query-row-#{query.id}"} class="hover:bg-surface-subtle/50 transition">
                  <td class="px-4 py-3 font-medium text-ink">
                    <.link navigate={~p"/admin/system/database-queries/#{query.slug}"} class="hover:underline text-brand">
                      {query.name}
                    </.link>
                  </td>
                  <td class="px-4 py-3 text-ink-subtle truncate max-w-xs" title={query.description}>
                    {query.description || "—"}
                  </td>
                  <td class="px-4 py-3 whitespace-nowrap text-ink-subtle">
                    <.datetime id={"created-#{query.id}"} value={query.created_at} />
                  </td>
                  <td class="px-4 py-3 whitespace-nowrap text-ink-subtle">
                    <.datetime id={"updated-#{query.id}"} value={query.updated_at} />
                  </td>
                  <td class="px-4 py-3 whitespace-nowrap text-right">
                    <div :if={allowed?(@current_scope, "admin.system.database-table.edit")} class="inline-flex items-center gap-1.5">
                      <button
                        type="button"
                        id={"duplicate-query-#{query.id}"}
                        phx-click="duplicate"
                        phx-value-id={query.id}
                        title="Duplicate"
                        aria-label="Duplicate query"
                        class="p-1 rounded-md text-ink-subtle hover:text-ink hover:bg-surface-sunken transition"
                      >
                        <.icon name="hero-document-duplicate" class="size-4" />
                      </button>
                      <button
                        type="button"
                        id={"delete-query-#{query.id}"}
                        phx-click="delete"
                        phx-value-id={query.id}
                        data-confirm="Are you sure you want to delete this query?"
                        title="Delete"
                        aria-label="Delete query"
                        class="p-1 rounded-md text-danger hover:text-danger-ink hover:bg-danger-surface transition"
                      >
                        <.icon name="hero-trash" class="size-4" />
                      </button>
                    </div>
                  </td>
                </tr>
              <% end %>
            <% end %>
          </tbody>
        </table>
      </div>

      <%= if @total_pages > 1 do %>
        <div class="mt-4 flex items-center justify-between text-sm text-ink-subtle">
          <span>
            Showing {@queries |> length()} of {@total_count} queries
          </span>
          <div class="inline-flex items-center gap-2">
            <.button
              :if={@page > 1}
              phx-click="page"
              phx-value-page={@page - 1}
              class="px-2.5 py-1 text-xs"
            >
              Previous
            </.button>
            <span class="px-2 font-medium text-ink">Page {@page} of {@total_pages}</span>
            <.button
              :if={@page < @total_pages}
              phx-click="page"
              phx-value-page={@page + 1}
              class="px-2.5 py-1 text-xs"
            >
              Next
            </.button>
          </div>
        </div>
      <% end %>
    </.card>
  </.page>
</Layouts.app>
