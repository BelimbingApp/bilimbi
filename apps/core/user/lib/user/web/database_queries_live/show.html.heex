<Layouts.app flash={@flash} current_scope={@current_scope} active_nav={@active_nav}>
  <.page id="database-query-show" variant={:list}>
    <.header>
      <div class="flex items-center gap-3">
        <form id="query-title-form" phx-change="change_field" class="inline-block">
          <input
            type="text"
            id="query-name-input"
            value={@name}
            name="name"
            class="bg-transparent text-xl font-bold text-ink border-0 border-b border-transparent hover:border-high-contrast-line focus:border-brand-strong focus:ring-0 px-1 py-0.5"
            placeholder="Untitled Query"
          />
        </form>
        <%= if @is_dirty do %>
          <span class="inline-flex items-center rounded-full bg-warning-surface px-2 py-0.5 text-xs font-medium text-warning-ink border border-warning-line">
            Unsaved changes
          </span>
        <% end %>
      </div>
      <:subtitle>
        <form id="query-desc-form" phx-change="change_field" class="w-full">
          <input
            type="text"
            id="query-description-input"
            value={@description}
            name="description"
            placeholder="Add a description..."
            class="w-full bg-transparent text-sm text-ink-subtle border-0 border-b border-transparent hover:border-high-contrast-line focus:border-brand-strong focus:ring-0 px-1 py-0.5"
          />
        </form>
      </:subtitle>
      <:actions>
        <.button
          navigate={~p"/admin/system/database-queries"}
        >
          Back
        </.button>

        <%= if allowed?(@current_scope, "admin.system.database-table.edit") do %>
          <%= if not @is_new do %>
            <.button
              id="btn-duplicate-query"
              phx-click="duplicate"
            >
              <.icon name="hero-document-duplicate" class="size-4 mr-1.5" />
              Duplicate
            </.button>
            <.button
              variant="danger"
              id="btn-delete-query"
              phx-click="delete"
              data-confirm="Are you sure you want to delete this query?"
            >
              <.icon name="hero-trash" class="size-4 mr-1.5" />
              Delete
            </.button>
          <% else %>
            <button
              type="button"
              id="btn-discard-query"
              phx-click="delete"
              class="inline-flex items-center justify-center gap-2 rounded-xl px-4 py-2 text-sm font-semibold shadow-sm transition border border-high-contrast-line bg-surface text-ink hover:bg-surface-sunken"
            >
              <.icon name="hero-x-mark" class="size-4 mr-1.5" />
              Discard
            </button>
          <% end %>

          <.button
            id="btn-save-query"
            phx-click="save"
            variant="primary"
          >
            <.icon name="hero-check" class="size-4 mr-1.5" />
            Save
          </.button>
        <% end %>
      </:actions>
    </.header>

    <div class="space-y-6">
      <%!-- Prompt Card --%>
      <.card id="prompt-card">
        <div class="flex items-center gap-2 mb-2 text-xs font-semibold uppercase tracking-wider text-ink-subtle">
          <.icon name="hero-chat-bubble-bottom-center-text" class="size-4" />
          <span>Prompt</span>
        </div>
        <form id="query-prompt-form" phx-change="change_field">
          <textarea
            id="query-prompt-textarea"
            name="prompt"
            rows="2"
            placeholder="Describe the data or query in natural language..."
            class="block w-full rounded-md border border-line bg-surface px-3 py-1.5 text-sm text-ink placeholder:text-ink-faint focus:border-brand-strong focus:outline-none focus:ring-1 focus:ring-brand-strong/30"
          >{@prompt}</textarea>
        </form>
      </.card>

      <%!-- SQL Editor Card --%>
      <.card id="sql-editor-card">
        <div class="flex items-center justify-between mb-2">
          <div class="flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-ink-subtle">
            <.icon name="hero-code-bracket" class="size-4" />
            <span>SQL Query</span>
          </div>
          <.button
            id="btn-run-query"
            phx-click="run_query"
            variant="primary"
            class="px-3 py-1 text-xs"
          >
            <.icon name="hero-play" class="size-3.5 mr-1" />
            Run Query
          </.button>
        </div>

        <form id="query-sql-form" phx-change="change_field">
          <textarea
            id="query-sql-textarea"
            name="sql_query"
            rows="5"
            placeholder="SELECT * FROM users WHERE id = :id LIMIT 25;"
            class="block w-full rounded-md border border-line bg-surface-sunken font-mono text-xs text-ink px-3 py-1.5 placeholder:text-ink-faint focus:border-brand-strong focus:outline-none focus:ring-1 focus:ring-brand-strong/30"
          >{@sql_query}</textarea>
        </form>

        <%!-- Detected Named Parameters --%>
        <%= if @detected_params != [] do %>
          <div id="detected-parameters-section" class="mt-4 pt-3 border-t border-line">
            <h4 class="text-xs font-semibold uppercase tracking-wider text-ink-subtle mb-2">
              Query Parameters
            </h4>
            <form id="query-params-form" phx-change="change_param">
              <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3">
                <%= for param <- @detected_params do %>
                  <div>
                    <label for={"param-input-#{param}"} class="block text-xs font-mono text-ink mb-1">
                      :{param}
                    </label>
                    <input
                      type="text"
                      id={"param-input-#{param}"}
                      name={param}
                      value={Map.get(@param_values, param, "")}
                      placeholder={"Value for :#{param}"}
                      class="block w-full rounded-md border border-line bg-surface px-2.5 py-1.5 text-xs text-ink placeholder:text-ink-faint focus:border-brand-strong focus:outline-none focus:ring-1 focus:ring-brand-strong/30"
                    />
                  </div>
                <% end %>
              </div>
            </form>
          </div>
        <% end %>
      </.card>

      <%!-- Query Error Alert --%>
      <%= if @error do %>
        <.alert kind={:error} id="query-execution-error">
          {@error}
        </.alert>
      <% end %>

      <%!-- Query Results Table --%>
      <%= if @results do %>
        <.card id="query-results-card">
          <div class="mb-3 flex items-center justify-between text-xs text-ink-subtle">
            <span class="font-medium">
              {@results.columns |> length()} columns · {@results.total_count} total rows
            </span>
          </div>

          <div class="overflow-x-auto rounded-lg border border-line max-h-[500px]">
            <table id="query-results-table" class="w-full text-left font-mono text-xs text-ink">
              <thead class="sticky top-0 border-b border-line bg-surface-muted text-xs font-semibold uppercase text-ink-subtle">
                <tr>
                  <%= for col <- @results.columns do %>
                    <th
                      scope="col"
                      class="px-3 py-2 cursor-pointer select-none hover:text-ink whitespace-nowrap"
                      phx-click="sort_results"
                      phx-value-column={col}
                    >
                      <div class="flex items-center gap-1">
                        <span>{col}</span>
                        <.icon :if={@result_sort_by == col && @result_sort_dir == :asc} name="hero-chevron-up" class="size-3" />
                        <.icon :if={@result_sort_by == col && @result_sort_dir == :desc} name="hero-chevron-down" class="size-3" />
                      </div>
                    </th>
                  <% end %>
                </tr>
              </thead>
              <tbody class="divide-y divide-line">
                <%= if @results.rows == [] do %>
                  <tr>
                    <td colspan={max(length(@results.columns), 1)} class="px-3 py-6 text-center text-xs text-ink-subtle">
                      No rows returned.
                    </td>
                  </tr>
                <% else %>
                  <%= for {row, row_idx} <- Enum.with_index(@results.rows) do %>
                    <tr id={"result-row-#{row_idx}"} class="hover:bg-surface-muted/50 transition">
                      <%= for col <- @results.columns do %>
                        <td class="px-3 py-2 whitespace-nowrap max-w-sm truncate text-ink">
                          <% val = Map.get(row, col) %>
                          <%= if is_nil(val) do %>
                            <span class="text-ink-faint">—</span>
                          <% else %>
                            {to_string(val)}
                          <% end %>
                        </td>
                      <% end %>
                    </tr>
                  <% end %>
                <% end %>
              </tbody>
            </table>
          </div>

          <%= if @results.total_pages > 1 do %>
            <div class="mt-4 flex items-center justify-between text-xs text-ink-subtle">
              <span>
                Page {@results.page} of {@results.total_pages}
              </span>
              <div class="inline-flex items-center gap-2">
                <.button
                  :if={@results.page > 1}
                  phx-click="page_results"
                  phx-value-page={@results.page - 1}
                  class="px-2.5 py-1 text-xs"
                >
                  Previous
                </.button>
                <.button
                  :if={@results.page < @results.total_pages}
                  phx-click="page_results"
                  phx-value-page={@results.page + 1}
                  class="px-2.5 py-1 text-xs"
                >
                  Next
                </.button>
              </div>
            </div>
          <% end %>
        </.card>
      <% end %>
    </div>
  </.page>
</Layouts.app>
