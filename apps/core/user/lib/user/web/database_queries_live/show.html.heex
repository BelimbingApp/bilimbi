<Layouts.app flash={@flash} current_scope={@current_scope} active_nav={@active_nav}>
  <.page id="database-query-show" variant={:list}>
    <.header>
      <div class="flex items-center gap-3">
        <form id="query-title-form" phx-change="change_field" class="inline-block">
          <input
            type="text"
            id="query-name-input"
            value={@name}
            name="name"
            class="bg-transparent text-xl font-bold text-ink border-0 border-b border-transparent hover:border-high-contrast-line focus:border-brand-strong focus:ring-0 px-1 py-0.5"
            placeholder="Untitled Query"
          />
        </form>
        <%= if @is_dirty do %>
          <span class="inline-flex items-center rounded-full bg-warning-surface px-2 py-0.5 text-xs font-medium text-warning-ink border border-warning-line">
            Unsaved changes
          </span>
        <% end %>
      </div>
      <:subtitle>
        <form id="query-desc-form" phx-change="change_field" class="w-full">
          <input
            type="text"
            id="query-description-input"
            value={@description}
            name="description"
            placeholder="Add a description..."
            class="w-full bg-transparent text-sm text-ink-subtle border-0 border-b border-transparent hover:border-high-contrast-line focus:border-brand-strong focus:ring-0 px-1 py-0.5"
          />
        </form>
      </:subtitle>
      <:actions>
        <.back_link
          id="database-query-back"
          navigate={~p"/admin/system/database-queries"}
          title="Back to database queries"
        />

        <%= if allowed?(@current_scope, "admin.system.database-table.edit") do %>
          <%= if not @is_new do %>
            <.button
              id="btn-duplicate-query"
              phx-click="duplicate"
            >
              <.icon name="duplicate" class="size-4 mr-1.5" />
              Duplicate
            </.button>
            <.button variant="danger" id="btn-delete-query" phx-click="request_delete">
              <.icon name="delete" class="size-4 mr-1.5" />
              Delete
            </.button>
          <% else %>
            <.button id="btn-discard-query" phx-click="delete">
              <.icon name="close" class="size-4 mr-1.5" />
              Discard
            </.button>
          <% end %>

          <.button
            id="btn-save-query"
            phx-click="save"
            variant="primary"
          >
            <.icon name="save" class="size-4 mr-1.5" />
            Save
          </.button>
        <% end %>
      </:actions>
    </.header>

    <div class="space-y-6">
      <%!-- Every section is a card opened by the shared heading, as on every
           record page (DESIGN.md "Detail sections and facts"). --%>
      <.card id="prompt-card" inner_class="p-5 sm:p-6" role="region" aria-labelledby="prompt-heading">
        <.section_heading id="prompt-heading" title="Prompt" />
        <form id="query-prompt-form" phx-change="change_field">
          <textarea
            id="query-prompt-textarea"
            name="prompt"
            rows="2"
            placeholder="Describe the data or query in natural language..."
            class="block w-full rounded-md border border-line bg-surface px-3 py-1.5 text-sm text-ink placeholder:text-ink-faint focus:border-brand-strong focus:outline-none focus:ring-1 focus:ring-brand-strong/30"
          >{@prompt}</textarea>
        </form>
      </.card>

      <.card
        id="sql-editor-card"
        inner_class="p-5 sm:p-6"
        role="region"
        aria-labelledby="sql-editor-heading"
      >
        <.section_heading id="sql-editor-heading" title="SQL Query">
          <:actions>
            <.button
              id="btn-run-query"
              phx-click="run_query"
              variant="primary"
              class="px-3 py-1 text-xs"
            >
              <.icon name="play" class="size-3.5 mr-1" />
              Run Query
            </.button>
          </:actions>
        </.section_heading>

        <form id="query-sql-form" phx-change="change_field">
          <textarea
            id="query-sql-textarea"
            name="sql_query"
            rows="5"
            placeholder="SELECT * FROM users WHERE id = :id LIMIT 25;"
            class="block w-full rounded-md border border-line bg-surface-sunken font-mono text-xs text-ink px-3 py-1.5 placeholder:text-ink-faint focus:border-brand-strong focus:outline-none focus:ring-1 focus:ring-brand-strong/30"
          >{@sql_query}</textarea>
        </form>

        <%!-- The console carries no tenant predicate (Database.QueryExecutor), so
             say what is unfiltered where the query runs. Only the operator scope
             reaches this page, and only that scope reads this far. --%>
        <.alert
          :if={@reach_caution?}
          kind={:warning}
          id="database-query-reach-caution"
          class="mt-2"
        >
          Not filtered to one company: SQL run here reads across every company and tenant in the database.
        </.alert>

        <%!-- Detected Named Parameters --%>
        <%= if @detected_params != [] do %>
          <div id="detected-parameters-section" class="mt-4 pt-3 border-t border-line">
            <h4 class="text-xs font-semibold uppercase tracking-wider text-ink-subtle mb-2">
              Query Parameters
            </h4>
            <form id="query-params-form" phx-change="change_param">
              <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3">
                <%= for param <- @detected_params do %>
                  <div>
                    <label for={"param-input-#{param}"} class="block text-xs font-mono text-ink mb-1">
                      :{param}
                    </label>
                    <input
                      type="text"
                      id={"param-input-#{param}"}
                      name={param}
                      value={Map.get(@param_values, param, "")}
                      placeholder={"Value for :#{param}"}
                      class="block w-full rounded-md border border-line bg-surface px-2.5 py-1.5 text-xs text-ink placeholder:text-ink-faint focus:border-brand-strong focus:outline-none focus:ring-1 focus:ring-brand-strong/30"
                    />
                  </div>
                <% end %>
              </div>
            </form>
          </div>
        <% end %>
      </.card>

      <%!-- Query Error Alert --%>
      <%= if @error do %>
        <.alert kind={:error} id="query-execution-error">
          {@error}
        </.alert>
      <% end %>

      <%!-- Query Results: the shared table, unframed inside the section card
           and sorted by this page. Columns come from the result set, so each
           header is a sort button for the column it names. --%>
      <%= if @results do %>
        <.card
          id="query-results-card"
          inner_class="p-5 sm:p-6"
          role="region"
          aria-labelledby="query-results-heading"
        >
          <.section_heading id="query-results-heading" title="Results">
            <:description>
              <span id="query-results-summary">
                {@results.columns |> length()} columns · {@results.total_count} total rows
              </span>
            </:description>
          </.section_heading>

          <.table
            id="query-results-table"
            rows={Enum.with_index(@results.rows)}
            row_id={fn {_row, index} -> "result-row-#{index}" end}
            row_item={fn {row, _index} -> row end}
            sort_by={@result_sort_by}
            sort_dir={@result_sort_dir}
            sort_event="sort_results"
            caption="Query results"
            framed={false}
          >
            <:col :for={col <- @results.columns} :let={row} label={col} sort={col}>
              <% val = Map.get(row, col) %>
              <span class="block max-w-sm truncate whitespace-nowrap font-mono text-xs">
                <%= if is_nil(val) do %>
                  <span class="text-ink-faint">—</span>
                <% else %>
                  {to_string(val)}
                <% end %>
              </span>
            </:col>
            <:empty
              :if={@results.rows == []}
              title="No rows returned"
              reason="The query ran and matched nothing."
            />
          </.table>

          <.pagination
            id="query-results-pagination"
            page={results_page(@results)}
            page_sizes={@page_sizes}
            filters_form={@results_filters_form}
            filters_event="result_page_size"
            page_event="page_results"
          />
        </.card>
      <% end %>
    </div>

    <.confirm_dialog
      :if={@pending_delete?}
      id="delete-query-confirm"
      consequence={"Query “#{@name}” will be deleted."}
      detail="Its saved SQL and parameters are removed. This cannot be undone."
      confirm="Delete"
      working="Deleting…"
      on_confirm={JS.push("delete")}
      on_cancel={JS.push("cancel_delete")}
    />
  </.page>
</Layouts.app>
