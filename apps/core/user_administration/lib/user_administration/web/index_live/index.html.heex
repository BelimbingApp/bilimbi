<Layouts.app flash={@flash} current_scope={@current_scope} active_nav={@active_nav}>
  <.page id="users-index">
    <.header>
      User Management
      <:title_actions>
        <.icon_button
          icon="bilimbi-pin"
          label="Pin Users to sidebar"
          context={:inline}
          id="users-pin"
          data-nav-pin="nav-admin-user"
          aria-pressed="false"
        />
      </:title_actions>
      <:subtitle>Search, filter, and manage the accounts in this workspace.</:subtitle>
      <:actions>
        <.button
          :if={allowed?(@current_scope, "admin.user.create")}
          id="user-new"
          navigate={~p"/users/new"}
          variant="primary"
        >
          <.icon name="hero-plus" /> Create User
        </.button>
      </:actions>
    </.header>

    <.form
      for={@filters_form}
      id="users-filters"
      phx-change="filters"
      class="mb-2"
    >
      <div class="grid gap-2 sm:grid-cols-[minmax(0,1fr)_16rem]">
        <div class="relative">
          <.icon
            name="hero-magnifying-glass"
            class="pointer-events-none absolute left-2.5 top-1/2 size-4 -translate-y-1/2 text-ink-faint"
          />
          <.input
            field={@filters_form[:search]}
            id="users-search"
            type="search"
            phx-debounce="300"
            maxlength="255"
            label="Search users"
            label_class="sr-only"
            wrapper_class="mb-0"
            placeholder="Search by name or email..."
            class="block w-full rounded-md border border-line bg-surface py-1.5 pl-8 pr-3 text-sm text-ink shadow-xs transition placeholder:text-ink-faint focus:border-brand-strong focus:outline-none focus:ring-2 focus:ring-brand-strong/30"
          />
        </div>
        <.multi_select
          field={@filters_form[:roleIds]}
          id="users-role-filter"
          placeholder="All roles"
          selection_label=":count role selected|:count roles selected"
          label="Roles"
          label_class="sr-only"
          wrapper_class="mb-0"
          options={@role_options}
        />
      </div>
    </.form>

    <.card id="users-card" inner_class="p-0">
      <h2 id="users-table-title" class="sr-only">Workspace users</h2>

      <.table
        id="users"
        rows={@streams.users}
        row_id={fn {dom_id, _} -> dom_id end}
        row_item={fn {_, user} -> user end}
        sort_by={@index_state.sort_by}
        sort_dir={@index_state.sort_dir}
        framed={false}
      >
        <:col :let={user} label="Name" sort="name" sort_id="users-sort-name">
          <div class="flex items-center gap-3">
            <span class="grid size-8 shrink-0 place-items-center rounded-full bg-surface-sunken text-xs font-semibold text-ink">
              {initials(user.name)}
            </span>
            <.link
              :if={allowed?(@current_scope, "admin.user.view")}
              id={"user-#{user.id}-show"}
              navigate={~p"/users/#{user.id}"}
              class="font-medium text-ink-strong hover:underline"
            >
              {user.name}
            </.link>
            <span
              :if={not allowed?(@current_scope, "admin.user.view")}
              class="font-medium text-ink-strong"
            >
              {user.name}
            </span>
          </div>
        </:col>
        <:col :let={user} label="Email" sort="email" sort_id="users-sort-email">
          <span class="whitespace-nowrap text-ink-muted">{user.email}</span>
        </:col>
        <:col :let={user} label="Company" sort="company_name" sort_id="users-sort-company">
          <div class="flex items-center gap-2">
            <.link
              :if={
                not user.company_archived and
                  allowed?(@current_scope, "admin.company.view")
              }
              id={"user-#{user.id}-company"}
              navigate={~p"/companies/#{user.company_id}"}
              class="hover:text-ink hover:underline"
            >
              {user.company_name}
            </.link>
            <span :if={
              user.company_archived or
                not allowed?(@current_scope, "admin.company.view")
            }>
              {user.company_name}
            </span>
            <.badge :if={user.company_archived} kind={:warning}>archived</.badge>
          </div>
        </:col>
        <:col :let={user} label="Roles">
          <div class="flex flex-wrap gap-1.5">
            <.badge
              :for={role <- user.roles}
              kind={if role.is_system, do: :success, else: :neutral}
            >
              {role.name}
            </.badge>
            <span :if={user.roles == []} class="text-ink-faint">—</span>
          </div>
        </:col>
        <:col :let={user} label="Created" sort="created_at" sort_id="users-sort-created">
          <span class="whitespace-nowrap tabular-nums text-ink-muted">
            {format_created(user.created_at)}
          </span>
        </:col>
        <:action :let={user}>
          <div class="flex items-center justify-end">
            <.icon_button
              :if={
                allowed?(@current_scope, "admin.user.impersonate") and
                  not user.company_archived and
                  user.id != @current_scope.user["user_id"] and
                  is_nil(@current_scope.impersonator)
              }
              icon="bilimbi-impersonate"
              label={gettext("Impersonate %{name}", name: user.name)}
              title={gettext("Impersonate this user")}
              id={"user-#{user.id}-impersonate"}
              href={~p"/admin/impersonate/#{user.id}"}
              method="post"
            />
            <.icon_button
              :if={
                allowed?(@current_scope, "admin.user.impersonate") and
                  (user.company_archived or
                     user.id == @current_scope.user["user_id"] or
                     not is_nil(@current_scope.impersonator))
              }
              icon="bilimbi-impersonate"
              label={gettext("Impersonate %{name}", name: user.name)}
              id={"user-#{user.id}-impersonate"}
              disabled
              title={
                cond do
                  user.id == @current_scope.user["user_id"] ->
                    gettext("You cannot impersonate yourself")

                  @current_scope.impersonator != nil ->
                    gettext("Cannot impersonate while impersonating")

                  user.company_archived ->
                    gettext("Archived-company users cannot be impersonated")

                  true ->
                    gettext("Impersonate this user")
                end
              }
            />
            <.icon_button
              :if={
                allowed?(@current_scope, "admin.user.delete") and
                  user.id != @current_scope.user["user_id"] and
                  not user.company_archived
              }
              icon="hero-trash"
              label={gettext("Delete %{name}", name: user.name)}
              title={gettext("Delete user")}
              kind={:danger}
              id={"user-#{user.id}-delete"}
              phx-click="delete"
              phx-value-id={user.id}
              data-confirm="Are you sure you want to delete this user?"
            />
            <.icon_button
              :if={
                allowed?(@current_scope, "admin.user.delete") and
                  (user.id == @current_scope.user["user_id"] or user.company_archived)
              }
              icon="hero-trash"
              label={gettext("Delete %{name}", name: user.name)}
              kind={:danger}
              id={"user-#{user.id}-delete"}
              disabled
              title={
                if user.id == @current_scope.user["user_id"],
                  do: gettext("You cannot delete your own account"),
                  else: gettext("Archived-company users cannot be deleted from this list")
              }
            />
          </div>
        </:action>
        <:empty :if={@users_page.entries == []}>
          No users found.
        </:empty>
      </.table>

      <.pagination
        id="users-pagination"
        page={@users_page}
        page_sizes={@page_sizes}
        filters_form={@filters_form}
      />
    </.card>
  </.page>
</Layouts.app>
