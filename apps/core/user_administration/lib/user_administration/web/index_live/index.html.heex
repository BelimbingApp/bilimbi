<Layouts.app flash={@flash} current_scope={@current_scope} active_nav={@active_nav}>
  <div id="users-index" class="mx-auto max-w-7xl">
    <.header>
      User Management
      <:subtitle>Search, filter, and manage the accounts in this workspace.</:subtitle>
      <:actions>
        <.button
          :if={allowed?(@current_scope, "admin.user.create")}
          id="user-new"
          navigate={~p"/users/new"}
          variant="primary"
        >
          <.icon name="hero-plus" /> Create User
        </.button>
      </:actions>
    </.header>
    <section class="rounded-xl border border-line bg-surface" aria-labelledby="users-table-title">
      <h2 id="users-table-title" class="sr-only">Workspace users</h2>
      <.form
        for={@filters_form}
        id="users-filters"
        phx-change="filters"
        class="px-4 pt-4"
      >
        <div class="grid gap-3 md:grid-cols-[minmax(0,1fr)_minmax(12rem,18rem)_10rem]">
          <.input
            field={@filters_form[:search]}
            id="users-search"
            type="search"
            phx-debounce="300"
            maxlength="255"
            label="Search users"
            placeholder="Search by name, email, or company..."
          />
          <.input
            field={@filters_form[:roleIds]}
            id="users-role-filter"
            type="select"
            multiple
            label="Roles"
            options={@role_options}
          />
          <.input
            field={@filters_form[:perPage]}
            id="users-page-size"
            type="select"
            label="Rows per page"
            options={page_size_options()}
          />
        </div>
      </.form>
      <div class="overflow-x-auto border-t border-line">
        <table class="w-full text-left text-sm">
          <thead class="bg-surface-sunken">
            <tr>
              <.sortable_heading
                id="users-sort-name"
                label="Name"
                sort="name"
                sort_by={@index_state.sort_by}
                sort_dir={@index_state.sort_dir}
              />
              <.sortable_heading
                id="users-sort-email"
                label="Email"
                sort="email"
                sort_by={@index_state.sort_by}
                sort_dir={@index_state.sort_dir}
              />
              <.sortable_heading
                id="users-sort-company"
                label="Company"
                sort="company_name"
                sort_by={@index_state.sort_by}
                sort_dir={@index_state.sort_dir}
              />
              <th class="px-4 py-2.5 text-xs font-semibold uppercase tracking-wider text-ink-subtle">
                Roles
              </th>
              <.sortable_heading
                id="users-sort-created"
                label="Created"
                sort="created_at"
                sort_by={@index_state.sort_by}
                sort_dir={@index_state.sort_dir}
              />
              <th class="px-4 py-2.5"><span class="sr-only">Actions</span></th>
            </tr>
          </thead>
          <tbody id="users" phx-update="stream" class="divide-y divide-line-subtle">
            <tr
              :for={{id, user} <- @streams.users}
              id={id}
              class="hover:bg-surface-sunken"
            >
              <td class="px-4 py-2.5 text-ink">
                <div class="flex items-center gap-3">
                  <span class="grid size-8 shrink-0 place-items-center rounded-full bg-surface-sunken text-xs font-semibold text-ink">
                    {initials(user.name)}
                  </span>
                  <.link
                    :if={allowed?(@current_scope, "admin.user.view")}
                    id={"user-#{user.id}-show"}
                    navigate={~p"/users/#{user.id}"}
                    class="font-medium text-ink-strong hover:underline"
                  >
                    {user.name}
                  </.link>
                  <span
                    :if={not allowed?(@current_scope, "admin.user.view")}
                    class="font-medium text-ink-strong"
                  >
                    {user.name}
                  </span>
                </div>
              </td>
              <td class="whitespace-nowrap px-4 py-2.5 text-ink-muted">{user.email}</td>
              <td class="px-4 py-2.5 text-ink-muted">
                <div class="flex items-center gap-2">
                  <.link
                    :if={
                      not user.company_archived and
                        allowed?(@current_scope, "admin.company.view")
                    }
                    id={"user-#{user.id}-company"}
                    navigate={~p"/companies/#{user.company_id}"}
                    class="hover:text-ink hover:underline"
                  >
                    {user.company_name}
                  </.link>
                  <span :if={
                    user.company_archived or
                      not allowed?(@current_scope, "admin.company.view")
                  }>
                    {user.company_name}
                  </span>
                  <.badge :if={user.company_archived} kind={:warning}>archived</.badge>
                </div>
              </td>
              <td class="px-4 py-2.5 text-ink-muted">
                <div class="flex flex-wrap gap-1.5">
                  <.badge
                    :for={role <- user.roles}
                    kind={if role.is_system, do: :success, else: :neutral}
                  >
                    {role.name}
                  </.badge>
                  <span :if={user.roles == []} class="text-ink-faint">—</span>
                </div>
              </td>
              <td class="whitespace-nowrap px-4 py-2.5 tabular-nums text-ink-muted">
                {format_created(user.created_at)}
              </td>
              <td class="whitespace-nowrap px-4 py-2.5 text-right">
                <div class="flex items-center justify-end gap-3">
                  <.link
                    :if={
                      allowed?(@current_scope, "admin.user.update") and not user.company_archived
                    }
                    id={"user-#{user.id}-edit"}
                    navigate={~p"/users/#{user.id}/edit"}
                    class="text-xs font-semibold text-action hover:underline"
                  >
                    Edit
                  </.link>
                  <button
                    :if={allowed?(@current_scope, "admin.user.delete")}
                    id={"user-#{user.id}-delete"}
                    type="button"
                    phx-click="delete"
                    phx-value-id={user.id}
                    disabled={user.id == @current_scope.user["user_id"] or user.company_archived}
                    data-confirm={
                      "Permanently delete #{user.name}? This account will be removed. This cannot be undone."
                    }
                    title={
                      cond do
                        user.id == @current_scope.user["user_id"] ->
                          "You cannot delete your own account"

                        user.company_archived ->
                          "Archived-company users are read-only"

                        true ->
                          "Permanently delete this user"
                      end
                    }
                    class="rounded-md border border-danger-line bg-danger-surface px-2.5 py-1.5 text-xs font-semibold text-danger-ink transition hover:bg-danger disabled:cursor-not-allowed disabled:opacity-50"
                  >
                    Delete
                  </button>
                </div>
              </td>
            </tr>
            <tr :if={@users_page.entries == []} id="users-empty">
              <td colspan="6" class="px-4 py-10 text-center text-ink-muted">
                No users found.
              </td>
            </tr>
          </tbody>
        </table>
      </div>
      <nav
        id="users-pagination"
        aria-label="Pagination"
        class="flex items-center justify-between gap-3 border-t border-line-subtle px-4 py-3"
      >
        <p id="users-pagination-summary" class="text-xs text-ink-subtle">
          {page_summary(@users_page)}
        </p>
        <div class="flex items-center gap-2">
          <button
            id="users-pagination-previous"
            type="button"
            phx-click="page"
            phx-value-page={@users_page.page - 1}
            disabled={@users_page.page <= 1}
            class="rounded-md border border-line bg-surface px-2.5 py-1.5 text-xs font-medium text-ink transition hover:bg-surface-sunken disabled:cursor-not-allowed disabled:opacity-50"
          >
            Previous
          </button>
          <span id="users-pagination-position" class="text-xs tabular-nums text-ink-muted">
            {page_position(@users_page)}
          </span>
          <button
            id="users-pagination-next"
            type="button"
            phx-click="page"
            phx-value-page={@users_page.page + 1}
            disabled={@users_page.page >= @users_page.total_pages or @users_page.total_pages == 0}
            class="rounded-md border border-line bg-surface px-2.5 py-1.5 text-xs font-medium text-ink transition hover:bg-surface-sunken disabled:cursor-not-allowed disabled:opacity-50"
          >
            Next
          </button>
        </div>
      </nav>
    </section>
  </div>
</Layouts.app>
