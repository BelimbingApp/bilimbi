# Raw Compose environment: literal KEY=value, no shell quotes or expansions.
# Keep outside the checkout, mode 0600. Do not source this file in Bash.
DATABASE_URL=ecto://bilimbi:REPLACE_ME@database.example.com:5432/bilimbi
SECRET_KEY_BASE=REPLACE_WITH_MIX_PHX_GEN_SECRET
BELIMBING_APP_KEY=base64:REPLACE_WITH_BASE64_32_BYTE_KEY
PHX_HOST=example.com
POOL_SIZE=10
# Set to the actual reverse-proxy peer address seen inside the container.
TRUSTED_PROXIES=REPLACE_WITH_PROXY_PEER_CIDR
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=REPLACE_ME
MAIL_PASSWORD=REPLACE_ME
MAIL_TLS_MODE=starttls
MAIL_FROM_NAME=Bilimbi
MAIL_FROM_ADDRESS=bilimbi@example.com
