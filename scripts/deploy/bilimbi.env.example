# Install as /etc/bilimbi/bilimbi.env, owned by root, mode 0600.
# Percent-encode special characters in the DATABASE_URL password.
DATABASE_URL=ecto://bilimbi:REPLACE_ME@127.0.0.1:5432/bilimbi
SECRET_KEY_BASE=REPLACE_WITH_MIX_PHX_GEN_SECRET
PHX_HOST=example.com
PORT=4000
POOL_SIZE=10
# Current release startup requires mail configuration. Move these to operator
# settings when the mail adapter supports runtime settings.
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=REPLACE_ME
MAIL_PASSWORD=REPLACE_ME
MAIL_TLS_MODE=starttls
MAIL_FROM_NAME=Bilimbi
MAIL_FROM_ADDRESS=bilimbi@example.com
