# The directory Mix will write compiled artifacts to.
/_build

# If you run "mix test --cover", coverage assets end up here.
/cover

# The directory Mix downloads your dependencies sources to.
/deps

# Where 3rd-party dependencies like ExDoc output generated docs.
/doc

# Ignore .fetch files in case you like to edit your project deps locally.
/.fetch

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Repo-local temp (tests, screenshot captures, etc.)
/tmp

# Ignore package tarball (built via "mix hex.build").
bilimbi-*.tar

# Ignore assets that are produced by build tools.
/priv/static/assets
/apps/web/priv/static/assets

# Ignore digested assets cache.
/priv/static/cache_manifest.json
/apps/web/priv/static/cache_manifest.json

# In case you use Node.js/npm, you want to ignore these.
npm-debug.log
/assets/node_modules
/apps/web/assets/node_modules

# Screenshot harness for AI visual-review-lane: Playwright in the driver dir;
# PNGs under repo-root tmp/ (see /tmp ignore above).
/apps/web/priv/screenshot/node_modules
/apps/web/priv/screenshot/package-lock.json

# Local Elixir language-server state.
/.elixir_ls

# Claude is part of the project AI team; only personal overrides stay local.
/.claude/settings.local.json

# Local scratch for humans and AI agents. Each file starts with three lines:
# author, datetime, purpose. Any file can be deleted except subfolders,
# which are managed by their creators.
/.scratchpad

# Base, Core, and Web belong to the Platform repository. Domains and Extensions
# mount as independent nested repositories directly below `apps/`, so ignore
# unknown containers by default and re-include the Platform-owned ones. This
# prevents accidental tracking; ignore rules are not a security boundary. Add
# any future Platform-owned container to the allowlist below before committing it.
/apps/*
!/apps/base/
!/apps/core/
!/apps/web/

# Python bytecode from .github/scripts tests
__pycache__
*.pyc

# Heartbeat runtime state (plugin writes this; never commit)
/.opencode/heartbeat/
